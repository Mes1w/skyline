    <Item class="Script" referent="RBX90003">
      <Properties>
        <string name="Name">ArenaIdentity30</string>
        <ProtectedString name="Source">-- Skyline 3.0 · Арены больше не близнецы: у каждой свой акцентный цвет.
-- Меняем только декор: клетки, метки и геометрию не трогаем.
local accents = {
    [1] = {Name="TIDE",      RU="Прилив",           Color=Color3.fromRGB(96,196,186)},
    [2] = {Name="EMBER",     RU="Угли",             Color=Color3.fromRGB(214,132,96)},
    [3] = {Name="AMETHYST",  RU="Аметист",         Color=Color3.fromRGB(160,132,214)},
    [4] = {Name="SOLSTICE",  RU="Солнцестояние", Color=Color3.fromRGB(226,192,118)},
}

local DECOR = {"Trim","Edge","Rail","Inlay","Border","Stripe","Neon","Banner"}

local function isDecor(name)
    for _, token in ipairs(DECOR) do
        if string.find(name, token, 1, true) then return true end
    end
    return false
end

local ok, err = pcall(function()
    local world = workspace:WaitForChild("SkylineNexus", 60)
    local arenas = world and world:WaitForChild("Arenas", 30)
    if not arenas then return end
    for index, accent in pairs(accents) do
        local arena = arenas:FindFirstChild("Arena" .. index)
        if arena then
            local painted = 0
            for _, item in ipairs(arena:GetDescendants()) do
                if item:IsA("BasePart") and isDecor(item.Name) then
                    item.Color = accent.Color
                    painted = painted + 1
                elseif item:IsA("PointLight") or item:IsA("SurfaceLight") or item:IsA("SpotLight") then
                    item.Color = accent.Color:Lerp(Color3.fromRGB(255,255,255), .35)
                end
            end
            arena:SetAttribute("AccentName", accent.Name)
            arena:SetAttribute("AccentNameRU", accent.RU)
            arena:SetAttribute("AccentColor", accent.Color)
            arena:SetAttribute("AccentParts", painted)
        end
    end
    print("[ArenaIdentity30] акценты арен применены.")
end)

if not ok then warn("[ArenaIdentity30] skipped:", err) end
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX_V41_WORLD">
      <Properties>
        <string name="Name">SkylineWorld41</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">-- SKYLINE NEXUS 4.1 · World: облака, вода, плавный цикл дня и ночи.
-- Только визуал. Не трогает матчи, награды, DataStore.
-- Отключить цикл: Lighting:SetAttribute("SkylineDayCycle", false) или DAY_CYCLE=false ниже.
local Lighting = game:GetService("Lighting")
local Run = game:GetService("RunService")

local DAY_CYCLE = true
local DAY_MINUTES = 16      -- длительность светлой части (06:00–19:00) в реальных минутах
local NIGHT_MINUTES = 5     -- ночь проходит быстрее, чтобы играть не было темно долго
local START_CLOCK = 15.4

if Lighting:GetAttribute("SkylineDayCycle") == nil then
    Lighting:SetAttribute("SkylineDayCycle", DAY_CYCLE)
end

-- 1. Облака: объёмные, высокие и редкие, чтобы не закрывать солнце.
local ok, err = pcall(function()
    local terrain = workspace:WaitForChild("Terrain", 30)
    if not terrain then return end
    local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
    clouds.Name = "SkylineClouds41"
    clouds.Cover = 0.52
    clouds.Density = 0.62
    clouds.Color = Color3.fromRGB(255, 250, 244)
    clouds.Enabled = true
    clouds.Parent = terrain
    -- Вода: чуть больше отражения и волны, бирюзовый оттенок под палитру карты.
    terrain.WaterColor = Color3.fromRGB(34, 108, 120)
    terrain.WaterReflectance = 0.42
    terrain.WaterTransparency = 0.32
    terrain.WaterWaveSize = 0.16
    terrain.WaterWaveSpeed = 9
end)
if not ok then warn("[SkylineWorld41] clouds skipped:", err) end

-- 2. Цикл дня и ночи. Освещение и амбиент тянутся вслед за солнцем.
local DAY = {
    Ambient = Color3.fromRGB(92, 97, 103),
    Outdoor = Color3.fromRGB(133, 141, 148),
    Brightness = 2.6,
    Exposure = 0.05,
}
local NIGHT = {
    Ambient = Color3.fromRGB(58, 66, 92),
    Outdoor = Color3.fromRGB(76, 88, 124),
    Brightness = 1.1,
    Exposure = 0.35,
}
local DUSK_TINT = Color3.fromRGB(255, 196, 150)

local function nightFactor(clock)
    -- 0 днём, 1 глубокой ночью, плавные переходы на рассвете и закате.
    if clock &gt;= 7 and clock &lt;= 17.6 then return 0 end
    if clock &gt; 17.6 and clock &lt; 19.6 then return (clock - 17.6) / 2 end
    if clock &gt; 5 and clock &lt; 7 then return 1 - (clock - 5) / 2 end
    return 1
end

local function apply(clock)
    local n = nightFactor(clock)
    Lighting.Ambient = DAY.Ambient:Lerp(NIGHT.Ambient, n)
    Lighting.OutdoorAmbient = DAY.Outdoor:Lerp(NIGHT.Outdoor, n)
    Lighting.Brightness = DAY.Brightness + (NIGHT.Brightness - DAY.Brightness) * n
    Lighting.ExposureCompensation = DAY.Exposure + (NIGHT.Exposure - DAY.Exposure) * n
    -- Тёплый тон на закате/рассвете.
    local dusk = math.clamp(1 - math.abs(n - 0.5) * 2, 0, 1)
    local cc = Lighting:FindFirstChild("SkylineColor")
    if cc and cc:IsA("ColorCorrectionEffect") then
        cc.TintColor = Color3.fromRGB(255, 251, 245):Lerp(DUSK_TINT, dusk * 0.22)
            :Lerp(Color3.fromRGB(214, 226, 255), n * 0.25)
    end
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if atm then
        atm.Color = Color3.fromRGB(215, 231, 233):Lerp(Color3.fromRGB(255, 205, 168), dusk * 0.5)
            :Lerp(Color3.fromRGB(70, 86, 128), n)
        atm.Decay = Color3.fromRGB(132, 154, 181):Lerp(Color3.fromRGB(196, 120, 96), dusk * 0.45)
            :Lerp(Color3.fromRGB(40, 48, 78), n)
        atm.Glare = 0.3 * (1 - n) + dusk * 0.25
    end
    -- Клиенты по этому атрибуту зажигают окна и фонари.
    Lighting:SetAttribute("SkylineNight", math.floor(n * 100 + 0.5) / 100)
end

Lighting.ClockTime = START_CLOCK
apply(START_CLOCK)

local acc = 0
Run.Heartbeat:Connect(function(dt)
    acc += dt
    if acc &lt; 0.25 then return end
    local step = acc
    acc = 0
    if Lighting:GetAttribute("SkylineDayCycle") ~= true then return end
    local clock = Lighting.ClockTime
    local isDay = clock &gt;= 6 and clock &lt; 19
    local hoursPerSecond = isDay and (13 / (DAY_MINUTES * 60)) or (11 / (NIGHT_MINUTES * 60))
    clock = (clock + hoursPerSecond * step) % 24
    Lighting.ClockTime = clock
    apply(clock)
end)

print("[SkylineWorld41] облака, вода и цикл дня готовы.")
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX9">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMinZoomDistance">10.0</float>
      <float name="CameraMaxZoomDistance">30.0</float>
      <float name="CharacterWalkSpeed">20.0</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX10">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX_V41_LIVING">
        <Properties>
          <string name="Name">SkylineLiving41</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source">-- SKYLINE NEXUS 4.1 · Living world (client only, ничего не реплицирует и не начисляет).
-- Ветер в растениях, покачивание яхт, огни окон ночью, светлячки/пыльца у камеры.
-- Уважает настройку «Слабые эффекты» (атрибут игрока AtelierLowFX28).
local Players = game:GetService("Players")
local Run = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local player = Players.LocalPlayer

local world = workspace:WaitForChild("SkylineNexus", 60)
if not world then return end

local SWAY_RADIUS = 140
local WIND = Vector3.new(1, 0, 0.35).Unit
local SWAY_AXIS = Vector3.new(0, 1, 0):Cross(WIND).Unit
local lowFX = player:GetAttribute("AtelierLowFX28") == true

-- Наборы растений: амплитуда горизонтального смещения верхушки (studs).
local TILT = { MeadowStem = 0.32, PondReed = 0.2, AtriumPlantStem = 0.08 }
local SHIFT = { MeadowSeedhead = 0.32, ReedHead = 0.2, GardenCanopy = 0.1, NativeShrub = 0.06, AtriumLeaf = 0.05 }
local YACHT = { YachtHull = true, YachtCabin = true, YachtBow = true, YachtDeck = true, YachtWindow = true }
local INDOOR = { AtriumPlantStem = true, AtriumLeaf = true } -- в помещении ветер слабее и медленнее

local sway = {}       -- [part] = {cf0, kind, amp, h}
local yachtParts = {} -- [part] = cf0
local hullOf = {}     -- [part] = CFrame корпуса (кэш, 4.2)
local hulls = {}
local windows = {}    -- [part] = {Material, Color, Transparency, lit}
local lights = {}     -- [light] = base brightness

local function phaseAt(p)
    return p.X * 0.071 + p.Z * 0.043
end

local function register(o)
    if o:IsA("BasePart") then
        local n = o.Name
        if TILT[n] then
            sway[o] = { cf0 = o.CFrame, kind = "tilt", amp = TILT[n], h = math.max(o.Size.Y, 0.5) }
        elseif SHIFT[n] then
            sway[o] = { cf0 = o.CFrame, kind = "shift", amp = SHIFT[n] }
        elseif YACHT[n] then
            yachtParts[o] = o.CFrame
            if n == "YachtHull" then hulls[o] = o.CFrame end
        elseif n == "WindowRibbon" or n == "YachtWindow" then
            -- Около 60% окон загораются ночью: стабильный псевдослучайный выбор по позиции.
            local p = o.Position
            local lit = (math.floor(p.X * 3.1 + p.Y * 7.7 + p.Z * 1.3) % 10) &lt; 6
            windows[o] = { o.Material, o.Color, o.Transparency, lit }
        end
    elseif o:IsA("PointLight") or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
        lights[o] = o.Brightness
    end
end

for _, o in ipairs(world:GetDescendants()) do register(o) end
world.DescendantAdded:Connect(register) -- StreamingEnabled: детали подгружаются позже
world.DescendantRemoving:Connect(function(o)
    sway[o] = nil; yachtParts[o] = nil; windows[o] = nil; lights[o] = nil; hulls[o] = nil; hullOf[o] = nil
end)

local function nearestHull(p)
    local best, bestD = nil, math.huge
    for _, cf in pairs(hulls) do
        local d = (cf.Position - p).Magnitude
        if d &lt; bestD then best, bestD = cf, d end
    end
    return best
end

-- Ночь: окна и фонари. Пересчёт только при смене атрибута, не каждый кадр.
local WARM = { Color3.fromRGB(255, 214, 160), Color3.fromRGB(255, 232, 196), Color3.fromRGB(196, 226, 255) }
local function applyNight()
    local n = tonumber(Lighting:GetAttribute("SkylineNight")) or 0
    for part, data in pairs(windows) do
        if part.Parent then
            if data[4] and n &gt; 0.35 then
                local p = part.Position
                part.Material = Enum.Material.SmoothPlastic
                part.Color = WARM[(math.floor(p.X + p.Z) % 3) + 1]
                part.Transparency = 0.15 + (1 - n) * 0.4
            else
                part.Material = data[1]; part.Color = data[2]; part.Transparency = data[3]
            end
        end
    end
    for light, base in pairs(lights) do
        if light.Parent then light.Brightness = base * (1 + 0.9 * n) end
    end
end
Lighting:GetAttributeChangedSignal("SkylineNight"):Connect(applyNight)
task.spawn(function()
    while true do task.wait(8); applyNight() end -- подхватывает новые подгруженные окна
end)
applyNight()

-- Частицы у камеры: пыльца днём, светлячки ночью.
local camera = workspace.CurrentCamera
local holder = Instance.new("Part")
holder.Name = "SkylineAmbientFX41"
holder.Anchored = true; holder.CanCollide = false; holder.CanQuery = false; holder.CanTouch = false
holder.Transparency = 1; holder.Size = Vector3.new(70, 1, 70)
holder.Parent = workspace
local pollen = Instance.new("ParticleEmitter")
pollen.Name = "Pollen41"
pollen.Texture = "rbxasset://textures/particles/sparkles_main.dds"
pollen.Color = ColorSequence.new(Color3.fromRGB(255, 246, 220))
pollen.LightEmission = 0.4
pollen.LightInfluence = 0.6
pollen.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.12), NumberSequenceKeypoint.new(1, 0) })
pollen.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.35), NumberSequenceKeypoint.new(1, 1) })
pollen.Lifetime = NumberRange.new(6, 10)
pollen.Speed = NumberRange.new(0.4, 1.2)
pollen.SpreadAngle = Vector2.new(180, 180)
pollen.Acceleration = WIND * 0.35 + Vector3.new(0, 0.05, 0)
pollen.RotSpeed = NumberRange.new(-40, 40)
pollen.Rate = 6
pollen.Parent = holder
local flies = pollen:Clone()
flies.Name = "Fireflies41"
flies.Color = ColorSequence.new(Color3.fromRGB(214, 255, 160), Color3.fromRGB(255, 226, 130))
flies.LightEmission = 1
flies.LightInfluence = 0
flies.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.15, 0.22), NumberSequenceKeypoint.new(0.6, 0.12), NumberSequenceKeypoint.new(1, 0) })
flies.Acceleration = Vector3.new(0, 0.12, 0)
flies.Rate = 0
flies.Parent = holder

local function applyFX()
    lowFX = player:GetAttribute("AtelierLowFX28") == true
    local dof = Lighting:FindFirstChild("SkylineDepth41")
    if dof then dof.Enabled = not lowFX end
    if lowFX then
        for part, d in pairs(sway) do if part.Parent then part.CFrame = d.cf0 end end
        for part, cf in pairs(yachtParts) do if part.Parent then part.CFrame = cf end end
    end
end
player:GetAttributeChangedSignal("AtelierLowFX28"):Connect(applyFX)
applyFX()

-- Основной цикл ~30 Гц, только объекты рядом с камерой, одним BulkMoveTo.
local parts, cfs = {}, {}
local acc = 0
Run.RenderStepped:Connect(function(dt)
    acc += dt
    if acc &lt; 1 / 30 then return end
    acc = 0
    camera=workspace.CurrentCamera
    if not camera then return end
    local camPos = camera.CFrame.Position
    holder.CFrame = CFrame.new(camPos + Vector3.new(0, -2, 0))
    local n = tonumber(Lighting:GetAttribute("SkylineNight")) or 0
    local inArena = player:GetAttribute("SkylineArena") ~= nil
    pollen.Enabled = not lowFX and not inArena and n &lt; 0.6
    flies.Rate = (lowFX or inArena) and 0 or 10 * n
    if lowFX then return end

    local t = os.clock()
    local gust = 0.75 + 0.25 * math.sin(t * 0.23) + 0.15 * math.sin(t * 0.61)
    table.clear(parts); table.clear(cfs)
    for part, d in pairs(sway) do
        local p0 = d.cf0.Position
        if (p0 - camPos).Magnitude &lt; SWAY_RADIUS then
            local indoor = INDOOR[part.Name]
            local speed = indoor and 0.7 or 1.7
            local off = d.amp * (indoor and 0.6 or gust) * math.sin(t * speed + phaseAt(p0))
            local cf
            if d.kind == "tilt" then
                local base = p0 - d.cf0.UpVector * (d.h / 2)
                local angle = math.asin(math.clamp(off / d.h, -0.5, 0.5))
                cf = CFrame.new(base) * CFrame.fromAxisAngle(SWAY_AXIS, angle) * (CFrame.new(-base) * d.cf0)
            else
                cf = d.cf0 + WIND * off
            end
            parts[#parts + 1] = part; cfs[#cfs + 1] = cf
        end
    end
    for part, cf0 in pairs(yachtParts) do
        local hull = hullOf[part] or nearestHull(cf0.Position)
        hullOf[part] = hull
        if hull and (hull.Position - camPos).Magnitude &lt; 600 then
            local ph = phaseAt(hull.Position)
            local bob = 0.28 * math.sin(t * 0.8 + ph)
            local roll = math.rad(1.6) * math.sin(t * 0.55 + ph * 1.3)
            local pivot = CFrame.new(hull.Position)
            local cf = pivot * CFrame.Angles(roll * 0.4, 0, roll) * (pivot:Inverse() * cf0) + Vector3.new(0, bob, 0)
            parts[#parts + 1] = part; cfs[#cfs + 1] = cf
        end
    end
    if #parts &gt; 0 then
        workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
    end
end)
</ProtectedString>
        </Properties>
      </Item>
