    end,left,actionY,-left-16,44)
    tutorialAction=start
    local hint2=T(lesson,tr("В настоящем матче выбираешь ход сам.","In real matches, every move is your choice."),12,K.Muted,F.Body,left,wide and 216 or bs+172,-left-16,wide and 31 or 29)
end
local function buildPlay()
    eyebrow.Text="01   /   PLAY"
    heading.Text=tr("Сделай свой ход","Make your move")
    subheading.Text=tr("Простые правила. Красивые дуэли.","Simple rules. Good company.")
    if not profile then note(tr("Подключаем твой профиль…","Connecting your profile…"),70);return end
    if profile.Games==0 and not profile.Settings.TutorialSeen and not tutorialDismissed then
        local invitation=section(100)
        T(invitation,tr("Первый раз?","New to the club?"),18,K.Text,F.Display,16,10,-32,28)
        buttonAt(invitation,tr("Разобраться за три хода","Learn in three moves"),"secondary",function() openPage("Tutorial") end,16,49,-32,40)
    end
    local wide=visibleWidth()&gt;=610
    -- 3.5.0: режим дня.
