-- Bottom navigation: centered backing, equal tabs, active rail, hover motion, and badges.
local dock=U.frame(gui,Color3.new(0,0,0),20);dock.BackgroundTransparency=1;dock.ZIndex=60;dock.AnchorPoint=Vector2.new(.5,1);dock.Position=UDim2.new(.5,0,1,-10);dock.Size=UDim2.fromOffset(510,84)
local dockBackdrop=U.frame(dock,K.Ink,12);dockBackdrop.Name="DockBackdrop";dockBackdrop.Size=UDim2.fromScale(1,1);dockBackdrop.BackgroundTransparency=0;U.stroke(dockBackdrop,K.Border,.22,1)
local dockGlow=U.new("Frame",{Name="DockGlow",BackgroundColor3=K.Gold,BackgroundTransparency=.72,AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,1,-4),Size=UDim2.fromOffset(220,2),ZIndex=dockBackdrop.ZIndex+1},dockBackdrop);U.round(dockGlow,2)
