      <Item class="LocalScript" referent="RBX_VIS27_MOTION">
        <Properties>
          <ProtectedString name="Source">-- Horizon 3.4. Local fountain motion and distance culling, no replicated animation.
local Run=game:GetService("RunService")
local player=game:GetService("Players").LocalPlayer
local elapsed=0
local items={}
local function register(o)
    if o:IsA("Beam") and o.Name=="FountainJet28" then items[o]={Width=o.Width0}
    elseif o:IsA("ParticleEmitter") and o.Name=="FountainMist28" then items[o]={} end
end
for _,o in ipairs(workspace:GetDescendants()) do register(o) end
workspace.DescendantAdded:Connect(register)
workspace.DescendantRemoving:Connect(function(o) items[o]=nil end)
Run.Heartbeat:Connect(function(dt)
    elapsed=elapsed+dt;if elapsed&lt;.15 then return end;elapsed=0
    local camera=workspace.CurrentCamera
    local world=workspace:FindFirstChild("SkylineNexus")
    local fountain=world and world:FindFirstChild("GrandFountain28")
    local center=fountain and fountain:FindFirstChild("UpperColumn")
    local visible=camera~=nil and center~=nil and not player:GetAttribute("AtelierLowFX28")
    visible=visible and (camera.CFrame.Position-center.Position).Magnitude&lt;180
    local t=workspace:GetServerTimeNow()
    for o,data in pairs(items) do
        if o.Parent then
            if o.Enabled~=visible then o.Enabled=visible end
            if visible and data.Width then o.Width0=data.Width*(1+.06*math.sin(t*2.1));o.Width1=.25*(1+.04*math.sin(t*2.1+1)) end
        end
    end
end)
</ProtectedString>
          <string name="Name">SkylineWorldMotion28</string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX_TIDE28_00647">
        <Properties>
          <string name="Name">SkylineSpectator28</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source">-- Atelier Tide 2.8. Seated spectators can switch to a clear court overview.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Input=game:GetService("UserInputService")
local Run=game:GetService("RunService")
local p=Players.LocalPlayer
local shared=RS:WaitForChild("SkylineShared")
local U=require(shared:WaitForChild("UIComponents"))
local D=require(shared:WaitForChild("DesignSystem"))
local ru=string.sub(p.LocaleId,1,2)=="ru"
local function tr(a,b) return ru and a or b end
local gui=U.new("ScreenGui",{Name="SpectatorHUD28",ResetOnSpawn=false,DisplayOrder=19,ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets},p:WaitForChild("PlayerGui"))
local card=U.frame(gui,D.Color.Ink,12)
card.Position=UDim2.fromOffset(16,78);card.Size=UDim2.fromOffset(254,86);card.Visible=false
U.stroke(card,D.Color.Border,.5)
local text=U.text(card,"",13,D.Color.Muted,D.Font.Body)
text.Position=UDim2.fromOffset(12,8);text.Size=UDim2.new(1,-24,0,22)
local court=nil
local active=false
local oldType,oldSubject,oldFOV,oldCFrame
local function restore()
    local cam=workspace.CurrentCamera
    if active and cam then
        cam.CameraType=oldType or Enum.CameraType.Custom
        cam.CameraSubject=oldSubject or (p.Character and p.Character:FindFirstChildOfClass("Humanoid"))
        cam.FieldOfView=oldFOV or 70
        if oldCFrame then cam.CFrame=oldCFrame end
    end
    active=false
end
local button=U.button(card,tr("Обзор арены","Court overview"),"secondary",function()
    if active then restore();return end
    if not court or p:GetAttribute("SkylineArena") then return end
    local center=court:FindFirstChild("Center");local cam=workspace.CurrentCamera
    if not center or not cam then return end
    oldType=cam.CameraType;oldSubject=cam.CameraSubject;oldFOV=cam.FieldOfView;oldCFrame=cam.CFrame
    active=true;cam.CameraType=Enum.CameraType.Scriptable;cam.FieldOfView=68
    -- Stay below the next floor or roof. Center is 4.5 / 34.3 studs high.
    cam.CFrame=CFrame.lookAt(center.Position+Vector3.new(0,22,27),center.Position)
end)
button.Position=UDim2.fromOffset(12,37);button.Size=UDim2.new(1,-24,0,36)
local function bind(character)
    restore();court=nil;card.Visible=false
    local hum=character:WaitForChild("Humanoid")
    hum.Seated:Connect(function(seated,seat)
        restore();court=nil
        if seated and seat and seat.Name=="SpectatorSeat" then
            local ancestor=seat.Parent
            while ancestor and ancestor~=workspace do
                if ancestor:IsA("Model") and string.match(ancestor.Name,"^Arena%d+$") then court=ancestor;break end
                ancestor=ancestor.Parent
            end
        end
        card.Visible=court~=nil and p:GetAttribute("SkylineArena")==nil
        if court then text.Text=tr("Наблюдение · Арена ","Spectating · Court ")..string.match(court.Name,"%d+") end
    end)
    hum.Died:Connect(function() restore();court=nil;card.Visible=false end)
end
p:GetAttributeChangedSignal("SkylineArena"):Connect(function()
    if p:GetAttribute("SkylineArena") then restore();court=nil;card.Visible=false end
end)
p.CharacterAdded:Connect(bind)
if p.Character then task.spawn(bind,p.Character) end
Input.InputBegan:Connect(function(input,processed)
    if not processed and input.KeyCode==Enum.KeyCode.Escape then restore() end
end)
local tick=0
Run.Heartbeat:Connect(function(dt)
    tick=tick+dt;if tick&lt;.2 then return end;tick=0
    local hud=p.PlayerGui:FindFirstChild("SkylineHUD")
    local menuOpen=p:GetAttribute("AtelierMenuOpen28")==true
    if active and (menuOpen or (hud and not hud.Enabled) or not court or not court.Parent or p:GetAttribute("SkylineArena")) then restore() end
    card.Visible=court~=nil and court.Parent~=nil and p:GetAttribute("SkylineArena")==nil and not menuOpen and (not hud or hud.Enabled)
    button.Text=active and tr("Вернуть камеру","Restore camera") or tr("Обзор арены","Court overview")
end)
</ProtectedString>
