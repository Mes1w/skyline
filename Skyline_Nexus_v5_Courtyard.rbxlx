      </Item>
      <Item class="LocalScript" referent="RBX90004">
        <Properties>
          <string name="Name">SkylineAmbience30</string>
          <ProtectedString name="Source">-- Skyline 3.0 · локальная атмосфера. Ничего не реплицирует, ничего не начисляет.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local shared = RS:WaitForChild("SkylineShared")
local Audio = require(shared:WaitForChild("Audio"))

local sources = {
    {Parent="GrandFountain28", Id="rbxasset://sounds/action_swim.mp3", Volume=.16, Radius=90, Speed=.85},
    {Parent="ClubGarden",      Id="rbxasset://sounds/action_swim.mp3", Volume=.07, Radius=60, Speed=.60},
}

local created = {}

local function anchorFor(holder)
    if holder:IsA("BasePart") then return holder end
    for _, child in ipairs(holder:GetDescendants()) do
        if child:IsA("BasePart") then return child end
    end
    return nil
end

local ok, err = pcall(function()
    local world = workspace:WaitForChild("SkylineNexus", 60)
    if not world then return end
    for _, def in ipairs(sources) do
        local holder = world:FindFirstChild(def.Parent)
        local anchor = holder and anchorFor(holder)
        if anchor and not anchor:FindFirstChild("SkylineAmbience30") then
            local sound = Instance.new("Sound")
            sound.Name = "SkylineAmbience30"
            sound.SoundId = def.Id
            sound.Looped = true
            sound.Volume = def.Volume
            sound.PlaybackSpeed = def.Speed
            sound.RollOffMinDistance = 12
            sound.RollOffMaxDistance = def.Radius
            sound.Parent = anchor
            sound:Play()
            created[#created+1] = {Sound=sound, Volume=def.Volume}
        end
    end
end)

if not ok then warn("[SkylineAmbience30] skipped:", err) end

-- Настройка "Звук" в меню глушит и атмосферу, а не только клики.
local function apply()
    local on = Audio.enabled() and player:GetAttribute("SkylineAmbience") ~= false
    for _, entry in ipairs(created) do
        if entry.Sound.Parent then
            entry.Sound.Volume = on and entry.Volume or 0
        end
    end
end

player:GetAttributeChangedSignal("SkylineAmbience"):Connect(apply)
-- 3.6.0: громкость меняется по сигналу атрибута; медленный цикл остаётся только как страховка.
task.spawn(function()
    while true do
        task.wait(30)
        apply()
    end
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX_REDESIGN_00213">
        <Properties>
          <string name="Name">ScreenPrompts</string>
          <ProtectedString name="Source">-- Custom prompts stay in screen UI. Keyboard/gamepad still use native input.
local Players=game:GetService("Players")
local PPS=game:GetService("ProximityPromptService")
local Run=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local player=Players.LocalPlayer
local shared=game:GetService("ReplicatedStorage"):WaitForChild("SkylineShared")
local U=require(shared.UIComponents)
local D=require(shared.DesignSystem)
local K=D.Color
local gui=U.new("ScreenGui",{Name="CourtyardInteractions",ResetOnSpawn=false,DisplayOrder=19,ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets},player:WaitForChild("PlayerGui"))
local card=U.frame(gui,K.Ink,10)
card.AnchorPoint=Vector2.new(.5,1);card.Position=UDim2.new(.5,0,1,-112)
card.Size=UDim2.new(1,-40,0,78);card.Visible=false
U.new("UISizeConstraint",{MaxSize=Vector2.new(420,78)},card);U.stroke(card,K.Border,.45)
local title=U.text(card,"",14,K.Text,D.Font.Strong)
title.Position=UDim2.fromOffset(16,8);title.Size=UDim2.new(1,-110,0,26)
local hint=U.text(card,"",12,K.Muted)
hint.Position=UDim2.fromOffset(16,37);hint.Size=UDim2.new(1,-110,0,26)
local button=U.button(card,"E","secondary")
button.AnchorPoint=Vector2.new(1,.5);button.Position=UDim2.new(1,-12,.5,0);button.Size=UDim2.fromOffset(72,48)
local track=U.frame(card,K.Gold,2);track.Position=UDim2.new(0,12,1,-5);track.Size=UDim2.fromOffset(0,2)
local shown={};local active,held,holdAt
local function release()
    if held then held:InputHoldEnd();held=nil
    elseif active then active:InputHoldEnd() end
end
local function key(prompt,input)
    if input==Enum.ProximityPromptInputType.Touch then return "Нажми" end
    if input==Enum.ProximityPromptInputType.Gamepad then return prompt.GamepadKeyCode.Name:gsub("Button","") end
    return UIS:GetStringForKeyCode(prompt.KeyboardKeyCode)
end
PPS.PromptShown:Connect(function(prompt,input)
    if prompt.Style==Enum.ProximityPromptStyle.Custom then shown[prompt]=input end
end)
PPS.PromptHidden:Connect(function(prompt) shown[prompt]=nil;if active==prompt then release();active=nil;card.Visible=false end end)
PPS.PromptButtonHoldBegan:Connect(function(prompt) if prompt==active then holdAt=os.clock() end end)
PPS.PromptButtonHoldEnded:Connect(function(prompt) if prompt==active then holdAt=nil end end)
button.InputBegan:Connect(function(input)
    if active and (input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1) then
        held=active;held:InputHoldBegin()
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then release() end
end)
local acc=0
Run.RenderStepped:Connect(function(dt)
    acc+=dt;if acc&lt;.05 then return end;acc=0
    local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local best,distance=nil,math.huge
    for prompt in pairs(shown) do
        local host=prompt.Parent
        if not host or not prompt.Enabled then shown[prompt]=nil
        elseif root then
            local pos=host:IsA("Attachment") and host.WorldPosition or (host:IsA("BasePart") and host.Position)
            if pos then local d=(root.Position-pos).Magnitude;if d&lt;distance then best=prompt;distance=d end end
        end
    end
    local hud=player.PlayerGui:FindFirstChild("SkylineHUD")
    local hidden=player:GetAttribute("AtelierMenuOpen28") or player:GetAttribute("SkylineRush") or (hud and not hud.Enabled)
    -- Service-level local gate also suppresses native keyboard/gamepad activation.
    PPS.Enabled=not hidden
    if hidden then best=nil end
    if active~=best then release();holdAt=nil;active=best end
    card.Visible=active~=nil
    if active then
        title.Text=active.ActionText~="" and active.ActionText or "Взаимодействовать"
        hint.Text=active.HoldDuration&gt;0 and "Удерживай для взаимодействия" or "Взаимодействовать"
        button.Text=key(active,shown[active])
        local progress=holdAt and math.clamp((os.clock()-holdAt)/math.max(.01,active.HoldDuration),0,1) or 0
        track.Size=UDim2.fromOffset(math.max(0,card.AbsoluteSize.X-24)*progress,2)
    end
end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX_REDESIGN_00214">
        <Properties>
          <string name="Name">CourtyardClient</string>
          <ProtectedString name="Source">-- Private, non-neon collectible. No markers, arrows, labels or client reward requests.
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local player=Players.LocalPlayer
local state=game:GetService("ReplicatedStorage"):WaitForChild("SkylineRemotes"):WaitForChild("State")
local coin,target,deadline
local function clear()
    if coin then coin:Destroy();coin=nil end
    target=nil
end
state.OnClientEvent:Connect(function(data)
    if data.Kind~="Rush" then return end
    clear()
    if not data.Active or typeof(data.Target)~="Vector3" then return end
    target=data.Target;deadline=data.Deadline
    coin=Instance.new("Part")
    coin.Name="PersonalCourtyardCoin";coin.Shape=Enum.PartType.Cylinder
    coin.Size=Vector3.new(.4,2.8,2.8);coin.Color=Color3.fromRGB(205,175,120)
    coin.Material=Enum.Material.Metal;coin.Anchored=true;coin.CanCollide=false
    coin.CanTouch=false;coin.CanQuery=false;coin.CastShadow=false
    coin.CFrame=CFrame.new(target)*CFrame.Angles(0,0,math.pi/2);coin.Parent=workspace
end)
player.CharacterRemoving:Connect(clear)
Run.RenderStepped:Connect(function()
    if not coin then return end
    if workspace:GetServerTimeNow()&gt;deadline then clear();return end
    local low=player:GetAttribute("AtelierLowFX28")==true
    local t=low and 0 or os.clock()
    coin.CFrame=CFrame.new(target+Vector3.new(0,math.sin(t*2)*.12,0))*CFrame.Angles(0,t,math.pi/2)
end)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
