        note(tr("РЕЖИМ ДНЯ: ","MODE OF THE DAY: ")..string.upper(Vr.name(featuredKey,ru)).."  ·  +"..math.floor((C.DailyFeature.Mult-1)*100+.5).."% "..tr("монет за матч","coins per match"),34,K.Sage)
    end
    local hero=section(wide and 228 or 210,K.Gold)
    local art=U.new("Frame",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-20,.5,0),Size=UDim2.fromOffset(wide and 185 or 84,wide and 185 or 84),BackgroundTransparency=1},hero)
    local palette=colors(profile.Equipped)
