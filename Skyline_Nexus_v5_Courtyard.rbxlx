    T(journey,tier&lt;30 and (tr("Твоя следующая награда · ур. ","Your next reward · tier ")..(tier+1)) or tr("Коллекция завершена","Collection completed"),18,K.Text,F.Strong,16,10,-32,40)
    local remaining=C.BattlePass.XPPerTier-bp.XP%C.BattlePass.XPPerTier
    T(journey,tier&lt;30 and (remaining..tr(" BP XP до награды. Прогресс не сгорает."," BP XP to your reward. Progress never expires.")) or tr("Продолжай играть ради наград мастерства.","Keep playing for mastery rewards."),13,K.Muted,F.Body,16,49,-32,30)
    buttonAt(journey,tr("Посмотреть награды","View rewards"),"secondary",function() openPage("Pass") end,16,85,-32,34)
    if #recentMatches&gt;0 then
        local last=recentMatches[#recentMatches]
        local recap=section(88)
        T(recap,tr("Итог: ","Result: ")..resultName(last),15,K.Text,F.Strong,16,8,-122,34)
        T(recap,last.Failed and tr("Проверка сохранения","Save needs checking") or receiptSummary(last.Receipt),12,K.Muted,F.Body,16,45,-122,34)
        local b=U.button(recap,tr("История","History"),"secondary",function() openPage("Profile") end);b.AnchorPoint=Vector2.new(1,.5);b.Position=UDim2.new(1,-12,.5,0);b.Size=UDim2.fromOffset(92,40)
    end
    local help=section(wide and 88 or 122,K.Surface,true)
    T(help,tr("Три в ряд. Всё просто.","Three in a row. That's it."),17,K.Text,F.Display,2,0,-4,27)
    T(help,tr("Три X или O в ряд приносят победу. Нажимай клетки экранного поля или используй E возле клетки в мире.","Connect three X or O marks to win. Tap the on-screen board, or approach a world tile and press E."),13,K.Muted,F.Body,2,34,-4,wide and 48 or 82)
    if not profile.Persistent then note(tr("Studio: тестовый профиль, без сохранения и покупок.","Studio: test profile, no saving or purchases."),40,K.Gold) end
end
local function buildShop()
    eyebrow.Text="02   /   COLLECTION"
    heading.Text=tr("Коллекция","Collection")
