        fit(b,16+(i-1)*(tabWidth+4),160,tabWidth-2,38)
    end
    local variantNote=T(practice,Vr.describe(variant,ru),13,K.Muted,F.Body,18,204,-36,34)
    variantNote.TextYAlignment=Enum.TextYAlignment.Top
    buttonAt(practice,tr("Начать тренировку","Start practice"),"primary",function() join("BOT",difficulty,variant) end,16,246,-32,44)
    local live=section(102,K.Surface,true)
    playHubText=T(live,"",12,K.Muted,F.Body,3,5,-6,28)
    courtIndicators={}
    for i=1,C.ArenaCount do
        local box=U.frame(live,K.Surface,8);box.Position=UDim2.new((i-1)/C.ArenaCount,3,0,43);box.Size=UDim2.new(1/C.ArenaCount,-6,0,48)
        local n=T(box,string.format("%02d",i),12,K.Text,F.Strong,0,4,0,17);n.TextXAlignment=Enum.TextXAlignment.Center
        local label=T(box,"…",11,K.Muted,F.Body,1,26,-2,17);label.TextXAlignment=Enum.TextXAlignment.Center
        courtIndicators[i]={Box=box,Label=label}
    end
