    local label=equipped and tr("Выбрано","Equipped") or (owned and tr("Использовать","Equip") or (item.VIP and tr("Открыть Club","View Club") or (item.PassOnly and tr("Открыть Пасс","View Pass") or tr("Купить за ","Buy for ")..number(item.Price))))
    local buy=buttonAt(preview,label,equipped and "secondary" or "primary",function()
        if item.VIP and not profile.VIP then openPage("Club") elseif item.PassOnly and not owned then openPage("Pass") else send("Skin",{Key=key}) end
    end,left,wide and 156 or 137,-left-16,wide and 46 or 49)
    U.disabled(buy,equipped or (not owned and not item.VIP and not item.PassOnly and profile.Coins&lt;item.Price))
    if not owned and not item.VIP and not item.PassOnly and profile.Coins&lt;item.Price then
        local poor=T(preview,tr("Не хватает ","Need ")..number(item.Price-profile.Coins)..tr(" мон."," more coins"),11,K.Muted,F.Body,left,wide and 205 or 185,-left-16,15)
        if tight then poor.Position=UDim2.fromOffset(16,303);poor.Size=UDim2.new(1,-32,0,18);poor.TextXAlignment=Enum.TextXAlignment.Center end
    end
    if tight then
        local center=(visibleWidth()-136)/2
        fit(grid,center,75,136,136)
        previewTag.Position=UDim2.fromOffset(16,12);previewTag.Size=UDim2.new(1,-32,0,17);previewTag.TextXAlignment=Enum.TextXAlignment.Center
        previewName.Position=UDim2.fromOffset(16,34);previewName.Size=UDim2.new(1,-32,0,32);previewName.TextXAlignment=Enum.TextXAlignment.Center
        previewPrice.Position=UDim2.fromOffset(16,222);previewPrice.Size=UDim2.new(1,-32,0,24);previewPrice.TextXAlignment=Enum.TextXAlignment.Center
        buy.Position=UDim2.fromOffset(16,253);buy.Size=UDim2.new(1,-32,0,44)
    end
    local columns=wide and 4 or 2
    local cellWidth=(visibleWidth()-(columns-1)*10)/columns
    local totalRows=math.ceil(#C.SkinOrder/columns)
    local catalog=section(totalRows*100+(totalRows-1)*10,K.Surface,true)
    for j,skinKey in ipairs(C.SkinOrder) do
        local thisKey=skinKey;local v=C.Skins[skinKey]
        local isOwned=profile.Owned[skinKey] or (v.VIP and profile.VIP)
        local b=U.button(catalog,"","secondary",function() selectedSkin=thisKey;rebuild() end)
        fit(b,((j-1)%columns)*(cellWidth+10),math.floor((j-1)/columns)*110,cellWidth,100)
        b.BackgroundColor3=skinKey==selectedSkin and K.GoldSoft or K.Surface
        local chips=U.new("Frame",{Size=UDim2.fromOffset(60,30),Position=UDim2.fromOffset(10,8),BackgroundTransparency=1},b)
        for idx,sign in ipairs({"X","O"}) do local f=U.new("Frame",{Size=UDim2.fromOffset(28,28),Position=UDim2.fromOffset((idx-1)*30,0),BackgroundTransparency=1},chips);U.mark(f,sign,colors(skinKey)[sign],glyphsFor(profile.Shape)[sign]) end
        local nameText=T(b,localized(v),13,K.Text,F.Strong,12,43,-24,24);nameText.TextWrapped=false;nameText.TextTruncate=Enum.TextTruncate.AtEnd
        local cost=isOwned and tr("В коллекции","Owned") or (v.VIP and "Club" or (v.PassOnly and tr("Пасс · ур. ","Pass · tier ")..v.PassTier or number(v.Price)..tr(" мон."," coins")))
        T(b,cost,11,skinKey==selectedSkin and K.Gold or K.Muted,F.Body,12,72,-24,17)
    end
    note(tr("НАБОРЫ ЗНАЧКОВ · Форма метки на поле","MARK SETS · The shape of your mark"),30,K.Gold)
    local ownedShapes=profile.Shapes or {}
    local shapeColumns=wide and 4 or 2
    local shapeWidth=(visibleWidth()-(shapeColumns-1)*10)/shapeColumns
    local shapeRows=math.ceil(#C.ShapeOrder/shapeColumns)
    local shapeGrid=section(shapeRows*104+(shapeRows-1)*10,K.Surface,true)
    for j,shapeKey in ipairs(C.ShapeOrder) do
        local thisShape=shapeKey;local v=C.Shapes[shapeKey]
        local shapeOwned=ownedShapes[shapeKey]==true or v.Price==0
        local shapeEquipped=profile.Shape==shapeKey
        local b=U.button(shapeGrid,"","secondary",function() send("Shape",{Key=thisShape}) end)
        fit(b,((j-1)%shapeColumns)*(shapeWidth+10),math.floor((j-1)/shapeColumns)*114,shapeWidth,104)
        b.BackgroundColor3=shapeEquipped and K.GoldSoft or K.Surface
        local chips=U.new("Frame",{Size=UDim2.fromOffset(64,30),Position=UDim2.fromOffset(12,10),BackgroundTransparency=1},b)
        for idx,sign in ipairs({"X","O"}) do
            local f=U.new("Frame",{Size=UDim2.fromOffset(28,28),Position=UDim2.fromOffset((idx-1)*32,0),BackgroundTransparency=1},chips)
            U.mark(f,sign,colors(profile.Equipped)[sign],v[sign])
        end
        local shapeName=T(b,localized(v),13,K.Text,F.Strong,12,46,-24,24);shapeName.TextWrapped=false;shapeName.TextTruncate=Enum.TextTruncate.AtEnd
        local cost=shapeEquipped and tr("Выбрано","Equipped") or (shapeOwned and tr("В коллекции","Owned") or number(v.Price)..tr(" мон."," coins"))
        T(b,cost,11,shapeEquipped and K.Gold or K.Muted,F.Body,12,74,-24,17)
        U.disabled(b,shapeEquipped or (not shapeOwned and profile.Coins&lt;v.Price))
    end
    local shown=false
    for _,productKey in ipairs(C.ProductOrder) do
        local v=C.Products[productKey]
        if v.Id&gt;0 then
            if not shown then note(tr("НАБОРЫ МОНЕТ · Только для косметики","COIN PACKS · Cosmetics only"),30,K.Gold);shown=true end
            local productId=v.Id
            local row=section(72)
            T(row,localized(v),17,K.Text,F.Display,16,11,-150,25)
            T(row,tr("Без преимуществ в дуэлях","No duel advantages"),12,K.Muted,F.Body,16,39,-150,21)
            local b=U.button(row,"…","secondary",function() purchase(productId,"PRODUCT") end);b.AnchorPoint=Vector2.new(1,.5);b.Position=UDim2.new(1,-14,.5,0);b.Size=UDim2.fromOffset(116,42);priceButton(b,productId,"PRODUCT")
        end
    end
end
local function progressBar(parent,x,y,widthRatio)
    local bg=U.frame(parent,K.Raised,3);bg.Position=UDim2.fromOffset(x,y);bg.Size=UDim2.new(1,-x*2,0,5)
    local fill=U.frame(bg,K.Sage,3);fill.Size=UDim2.fromScale(math.clamp(widthRatio,0,1),1)
end
local function journeyContext()
    return {tr=tr,T=T,localized=localized,number=number,profile=function() return profile end,
        section=section,note=note,buttonAt=buttonAt,progressBar=progressBar,visibleWidth=visibleWidth,
        send=send,openPage=function(key) openPage(key) end,purchase=purchase,priceButton=priceButton,
        selectSkin=function(key) selectedSkin=key end,eyebrow=eyebrow,heading=heading,subheading=subheading}
end
local function buildPass() JourneyUI.Pass(journeyContext()) end
local function buildQuests()
    eyebrow.Text="03   /   DAILY"
    heading.Text=tr("Твои награды","Your rewards")
    subheading.Text=tr("Награды за игру, а не за покупки.","Rewards for playing, not for paying.")
    if not profile then note(tr("Профиль загружается…","Loading your profile…"));return end
    local today=math.floor(workspace:GetServerTimeNow()/86400)
    local claimed=profile.LastDaily&gt;=today
    local day=claimed and profile.DailyStreak or (profile.LastDaily==today-1 and profile.DailyStreak%7+1 or 1)
    day=math.clamp(day,1,7)
    local calendar=section(204)
    T(calendar,tr("Твой подарок","Your daily gift"),22,K.Text,F.Display,18,14,-36,32)
    local status=HUDState.daily(profile,workspace:GetServerTimeNow())
    T(calendar,claimed and (tr("Новый подарок через ","Next gift in ")..HUDState.clock(status.Seconds)) or tr("Серия входов: до 300 монет на седьмой день","Daily streak: up to 300 coins on day seven"),12,K.Muted,F.Body,18,48,-36,27)
    local cw=(visibleWidth()-36-6*4)/7
    for j=1,7 do
        local f=U.frame(calendar,j==day and K.GoldSoft or K.Raised,7);fit(f,18+(j-1)*(cw+4),82,cw,50)
        local label=T(f,tostring(j),11,j==day and K.Gold or K.Muted,F.Body,0,4,0,15);label.TextXAlignment=Enum.TextXAlignment.Center
        local amount=T(f,tostring(C.DailyCoins[j]),cw&lt;39 and 11 or 13,K.Text,F.Strong,0,24,0,18);amount.TextXAlignment=Enum.TextXAlignment.Center
    end
    local b=buttonAt(calendar,claimed and tr("Сегодня уже получено","Claimed for today") or (tr("Забрать ","Claim ")..C.DailyCoins[day]..tr(" монет"," coins")),claimed and "secondary" or "primary",function() send("Daily") end,18,146,-36,44);U.disabled(b,claimed)
    for _,questKey in ipairs(C.QuestOrder) do
        local key=questKey;local q=C.Quests[key]
        local progress=profile.QuestDay==today and (profile.QuestProgress[q.Field] or 0) or 0
        local done=profile.QuestDay==today and profile.QuestClaims[key]
        local ready=progress&gt;=q.Goal and not done
        local row=section(152)
        T(row,localized(q),16,K.Text,F.Strong,16,10,-32,28)
        T(row,math.min(progress,q.Goal).." / "..q.Goal.."   +"..q.Coins..tr(" мон."," coins").." · +"..q.XP.." XP · +"..q.PassXP.." BP",12,K.Muted,F.Body,16,40,-32,42)
        local b=U.button(row,done and tr("Получено","Claimed") or (ready and tr("Забрать","Claim") or tr("В процессе","In progress")),ready and "primary" or "secondary",function() send("Quest",{Key=key}) end)
        b.AnchorPoint=Vector2.new(1,0);b.Position=UDim2.new(1,-16,0,100);b.Size=UDim2.new(1,-32,0,40);U.disabled(b,not ready)
        progressBar(row,16,87,progress/q.Goal)
    end
    JourneyUI.Weekly(journeyContext())
    local found=0;for _,v in pairs(profile.Explorer) do if v then found=found+1 end end
    local explore=section(112)
    T(explore,tr("Пять секретов","Five secrets"),18,K.Text,F.Display,16,12,-32,40)
    T(explore,found.." / 5"..tr(" золотых знаков · +200 монет и +120 XP за все"," gold emblems · +200 coins and +120 XP for all five"),13,K.Muted,F.Body,16,56,-32,39)
    note(tr("Сброс заданий: 00:00 UTC. Награды матча: от двух твоих ходов и 14 секунд. Есть лимиты против фарма.","Reset: 00:00 UTC. Match rewards require two of your moves and 14 seconds. Farming limits apply."),66)
end
local function buildClub() JourneyUI.Club(journeyContext()) end
local function applyWorldVisual(o)
    if o:IsA("Trail") and o.Name=="SkylineTrail" then o.Enabled=not lowFX end
    if o:IsA("Light") and (o.Name=="GardenLight" or o.Name=="FountainLight28" or o.Name=="HorizonAccentLight") then o.Enabled=not lowFX end
    if o:IsA("ParticleEmitter") and o.Name=="FountainMist28" then o.Enabled=not lowFX end
    if o:IsA("Beam") and o.Name=="FountainJet28" then o.Enabled=not lowFX end
    if o:IsA("BasePart") and o.Parent and o.Parent.Name=="Discoveries" and profile then
        local collected=profile.Explorer[o.Name]==true
        o.LocalTransparencyModifier=collected and .72 or 0
        local prompt=o:FindFirstChildOfClass("ProximityPrompt");if prompt then prompt.Enabled=not collected end
    end
    if o:IsA("ProximityPrompt") and o.Parent and o.Parent.Parent and o.Parent.Parent.Name=="Discoveries" and profile then o.Enabled=not profile.Explorer[o.Parent.Name] end
end
local function applyFX(value)
    lowFX=value;U.Motion=not value
    player:SetAttribute("AtelierLowFX28",value)
    for _,o in ipairs(Lighting:GetChildren()) do if o.Name=="SkylineBloom" or o.Name=="SkylineRays" then o.Enabled=not value end end
    for _,o in ipairs(workspace:GetDescendants()) do applyWorldVisual(o) end

end
workspace.DescendantAdded:Connect(applyWorldVisual)
local function buildProfile()
    eyebrow.Text="05   /   YOU"
    heading.Text=player.DisplayName
    subheading.Text=tr("Прогресс, стиль и быстрые действия — в одном месте.","Progress, style and quick actions in one place.")
    if not profile then note(tr("Профиль загружается…","Loading your profile…"));return end
    local level=L.level(profile.XP)
    local floorXP=80*(level-1)*(level-1);local nextXP=80*level*level
    local ratio=math.clamp((profile.XP-floorXP)/(nextXP-floorXP),0,1)
    local narrow=visibleWidth()&lt;520

    local hero=section(narrow and 190 or 160,K.GoldSoft)
    T(hero,tr("ТВОЙ ПРОФИЛЬ","YOUR PROFILE"),10,K.Gold,F.Strong,18,14,-36,18)
    T(hero,tr("Уровень ","Level ")..level,30,K.Text,F.Display,18,36,-36,42)
    T(hero,number(profile.XP-floorXP).." / "..number(nextXP-floorXP).." XP",13,K.Muted,F.Body,18,80,-36,22)
    progressBar(hero,18,108,ratio)
    local status=profile.Rank and ("#"..profile.Rank.."  ·  "..number(math.floor(profile.Rating))) or (number(math.floor(profile.Rating))..tr(" рейтинга"," rating"))
    local badge=T(hero,status,14,K.Gold,F.Strong,18,126,narrow and -36 or -190,24)
    badge.TextWrapped=false;badge.TextTruncate=Enum.TextTruncate.AtEnd
    local coinIcon=U.icon(hero,"Coin",K.Gold);coinIcon.Position=UDim2.fromOffset(narrow and 18 or 156,narrow and 152 or 124)
    local coins=T(hero,number(profile.Coins),14,K.Text,F.Strong,narrow and 48 or 178,narrow and 153 or 126,narrow and -66 or -196,24)
    coins.TextXAlignment=Enum.TextXAlignment.Right

    local goal=section(82,K.Surface,true)
    T(goal,tr("СЛЕДУЮЩАЯ ЦЕЛЬ","NEXT GOAL"),10,K.Sage,F.Strong,16,10,-32,18)
    local goalText
    if profile.Rank and profile.Rank&lt;=10 then
        goalText=tr("Удерживай топ-10 и улучшай серию побед.","Hold the top 10 and improve your win streak.")
    elseif profile.TopGap and profile.TopGap&gt;0 then
        goalText=tr("Ещё ","Earn ")..number(profile.TopGap)..tr(" рейтинга до топ-10."," more rating to reach the top 10.")
    else
        goalText=tr("Сыграй рейтинговый матч, чтобы открыть позицию.","Play a ranked match to reveal your position.")
    end
    T(goal,goalText,15,K.Text,F.Strong,16,34,-32,34)

    local values={
        {tr("Матчи","Games"),profile.Games or 0},
        {tr("Победы","Wins"),profile.Wins or 0},
        {tr("Винрейт","Win rate"),(profile.Games or 0)&gt;0 and math.floor((profile.Wins or 0)/(profile.Games or 1)*100+0.5).."%" or "—"},
        {tr("Лучшая серия","Best streak"),profile.BestStreak or 0},
    }
    local cols=narrow and 2 or 4;local rows=math.ceil(#values/cols)
    local metrics=section(rows*88+(rows-1)*8,K.Surface,true)
    for i,v in ipairs(values) do
        local col=(i-1)%cols;local row=math.floor((i-1)/cols)
        local box=U.frame(metrics,K.Surface,10);box.Position=UDim2.new(col/cols,col==0 and 0 or 4,0,row*96);box.Size=UDim2.new(1/cols,-6,0,88)
        local num=T(box,tostring(v[2]),22,K.Gold,F.Display,8,12,-16,32);num.TextXAlignment=Enum.TextXAlignment.Center;num.TextWrapped=false
        local cap=T(box,v[1],11,K.Muted,F.Body,4,51,-8,27);cap.TextXAlignment=Enum.TextXAlignment.Center
    end

    -- 3.6.0: статистика по режимам правил.
    local vs=profile.VariantStats
    if type(vs)=="table" then
        local modeRows={}
        for _,key in ipairs(Vr.Order) do
            local entry=vs[key]
            if type(entry)=="table" and (entry.Games or 0)&gt;0 then modeRows[#modeRows+1]={key,entry} end
        end
        if #modeRows&gt;0 then
            note(tr("ПО РЕЖИМАМ","BY MODE"),28,K.Gold)
            local modes=section(#modeRows*44+8,K.Surface,true)
            for i,row in ipairs(modeRows) do
                local box=U.frame(modes,K.Surface,10)
                box.Position=UDim2.fromOffset(0,(i-1)*44)
                box.Size=UDim2.new(1,0,0,40)
                T(box,Vr.name(row[1],ru),14,K.Text,F.Strong,12,9,-160,22)
                local games=row[2].Games or 0;local wins=row[2].Wins or 0
                local rate=games&gt;0 and math.floor(wins/games*100+.5) or 0
                local stat=T(box,games..tr(" матч.  ·  "," games  ·  ")..wins..tr(" поб.  ·  "," wins  ·  ")..rate.."%",13,K.Muted,F.Body,0,9,-12,22)
                stat.TextXAlignment=Enum.TextXAlignment.Right
            end
        end
    end
    local style=section(narrow and 158 or 116)
    T(style,tr("УНИВЕРСАЛЬНЫЙ СТИЛЬ","UNIVERSAL STYLE"),10,K.Sage,F.Strong,16,10,-32,18)
    local skin=C.Skins[profile.Equipped] or C.Skins.Classic;local shape=C.Shapes[profile.Shape] or C.Shapes.Classic
    T(style,localized(skin).."  ·  "..localized(shape),17,K.Text,F.Display,16,34,narrow and -32 or -174,28)
    T(style,tr("Работает в Классике, Блице и Смыве.","Works in Classic, Blitz and Shift."),12,K.Muted,F.Body,16,64,narrow and -32 or -174,24)
    local marks=U.new("Frame",{BackgroundTransparency=1},style);fit(marks,narrow and 16 or visibleWidth()-158,narrow and 96 or 24,132,48)
    for i,sign in ipairs({"X","O"}) do
        local m=U.new("Frame",{BackgroundTransparency=1},marks);fit(m,(i-1)*52,0,44,44)
        U.mark(m,sign,colors(profile.Equipped)[sign],shape[sign])
    end
    local styleButton=U.button(style,tr("Сменить стиль","Change style"),"secondary",function() openPage("Shop") end)
    fit(styleButton,narrow and visibleWidth()-148 or visibleWidth()-158,narrow and 102 or 72,132,38)

    -- 3.5.0: стена медалей.
    local medalRows=profile.Medals
    if type(medalRows)=="table" and #medalRows&gt;0 then
        note(tr("МЕДАЛИ  ·  ","MEDALS  ·  ")..tostring(profile.MedalCount or 0).." / "..#medalRows,28,K.Gold)
        local mcols=narrow and 1 or 2
        local mrows=math.ceil(#medalRows/mcols)
        local wall=section(mrows*72-8,K.Surface,true)
        for i,entry in ipairs(medalRows) do
            local def=C.Medals[entry.Key] or {RU=entry.Key,EN=entry.Key}
            local col=(i-1)%mcols;local row=math.floor((i-1)/mcols)
            local box=U.frame(wall,K.Surface,10)
            box.Position=UDim2.new(col/mcols,col==0 and 0 or 5,0,row*72)
            box.Size=UDim2.new(1/mcols,mcols&gt;1 and -5 or 0,0,64)
            local title=T(box,(entry.Done and "★  " or "☆  ")..localized(def),14,entry.Done and K.Gold or K.Text,F.Strong,12,9,-24,22)
            title.TextWrapped=false;title.TextTruncate=Enum.TextTruncate.AtEnd
            local caption=entry.Done and tr("Получена","Unlocked") or (number(entry.Value or 0).." / "..number(entry.Goal or 0))
            T(box,caption,12,K.Muted,F.Body,12,33,-24,20)
        end
    end
    local quick=section(narrow and 102 or 48,K.Surface,true)
    local play=U.button(quick,tr("Играть","Play"),"primary",function() openPage("Play") end)
    local quests=U.button(quick,tr("Награды","Rewards"),"secondary",function() openPage("Quests") end)
    if narrow then fit(play,0,0,visibleWidth(),44);fit(quests,0,54,visibleWidth(),44)
    else fit(play,0,0,(visibleWidth()-10)/2,44);fit(quests,(visibleWidth()+10)/2,0,(visibleWidth()-10)/2,44) end

    note(tr("НАСТРОЙКИ","SETTINGS"),28,K.Gold)
    local function setting(title,desc,label,fn)
        local stacked=visibleWidth()&lt;400
        local f=section(stacked and 128 or 84)
        T(f,title,16,K.Text,F.Strong,16,8,stacked and -32 or -144,28)
        T(f,desc,12,K.Muted,F.Body,16,38,stacked and -32 or -144,30)
        local btn=U.button(f,label,"secondary",fn)
        if stacked then btn.Position=UDim2.fromOffset(14,76);btn.Size=UDim2.new(1,-28,0,42)
        else btn.AnchorPoint=Vector2.new(1,.5);btn.Position=UDim2.new(1,-14,.5,0);btn.Size=UDim2.fromOffset(112,44) end
    end
    setting(tr("Звуки","Sounds"),tr("Отклик ходов и интерфейса","Moves and interface feedback"),soundOn and tr("Вкл.","On") or tr("Выкл.","Off"),function()
        if os.clock()-settingsAt&lt;1 then return end;settingsAt=os.clock();send("Setting",{Key="Sound",Value=not soundOn})
    end)
    setting(tr("Меньше эффектов","Reduced effects"),tr("Убирает лишнее движение и свечение","Reduces motion and glow"),lowFX and tr("Вкл.","On") or tr("Выкл.","Off"),function()
        if os.clock()-settingsAt&lt;1 then return end;settingsAt=os.clock();send("Setting",{Key="LowFX",Value=not lowFX})
    end)
    setting(tr("Язык","Language"),tr("Меню и подсказки","Menus and hints"),ru and "English" or "Русский",function() ru=not ru;rebuild();updateNav();updateWallet();updateMatchUI();exitPhoto.Text=tr("Вернуть интерфейс · P","Restore interface · P") end)
    setting(tr("Фото-режим","Photo mode"),tr("Чистый кадр без интерфейса","A clean view without UI"),tr("Открыть","Open"),function()
        if match then notify(tr("Фото-режим доступен между матчами.","Photo mode is available between matches."));return end
        closeMenu();setPhoto(true)
    end)
    setting(tr("Вернуться в лобби","Return to lobby"),tr("Покидает очередь, но не матч","Leaves matchmaking, not a match"),tr("Домой","Home"),function()
        if match then notify(tr("Сначала заверши матч.","Finish your match first."));return end
        send("Home");closeMenu()
    end)
    setting(tr("Правила и обучение","Rules and tutorial"),tr("Безопасное поле без наград","Risk-free board without rewards"),tr("Открыть","Open"),function() openPage("Tutorial") end)
    historyRows()
    if #hub.Global&gt;0 then
        note(tr("ЛУЧШИЕ ИГРОКИ","TOP PLAYERS"),26,K.Gold)
        local top=section(#hub.Global*36+12)
        for i,v in ipairs(hub.Global) do
            T(top,string.format("%02d",i),13,K.Gold,F.Strong,14,6+(i-1)*36,-14,28)
            local pn=T(top,v.Name,14,K.Text,F.Body,48,6+(i-1)*36,-152,28);pn.TextWrapped=false;pn.TextTruncate=Enum.TextTruncate.AtEnd
            local rating=T(top,number(v.Rating),14,K.Muted,F.Strong,0,6+(i-1)*36,-16,28);rating.TextXAlignment=Enum.TextXAlignment.Right
        end
    end
    note((profile.Persistent and tr("Прогресс сохраняется","Progress is saved") or tr("Тестовый профиль без сохранения","Test profile, not saved")).."  ·  Skyline Nexus "..C.Version,36)
end
local pagePositions={}
local builders={Pass=buildPass,Play=buildPlay,Shop=buildShop,Quests=buildQuests,Club=buildClub,Profile=buildProfile,Tutorial=buildTutorial}
rebuild=function()
    if not menuOpen then return end
    generation=generation+1;order=0
    local previous=scroll.CanvasPosition
    for _,o in ipairs(scroll:GetChildren()) do if o:IsA("GuiObject") then o:Destroy() end end
    builders[page]();scroll.CanvasPosition=previous
    if page=="Tutorial" and tutorialState.Done then
        task.delay(.05,function()
            if not menuOpen or page~="Tutorial" or not tutorialState.Done or not tutorialAction or not tutorialAction.Parent then return end
            local needed=tutorialAction.AbsolutePosition.Y+tutorialAction.AbsoluteSize.Y-scroll.AbsolutePosition.Y-scroll.AbsoluteSize.Y+12
            if needed&gt;0 then scroll.CanvasPosition=Vector2.new(0,scroll.CanvasPosition.Y+needed) end
        end)
    end
end
closeMenu=function()
    if menuOpen then pagePositions[page]=scroll.CanvasPosition end
    menuOpen=false;window.Visible=false;scrim.Visible=false;updateNav()
    if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(window) then GuiService.SelectedObject=nil end
    if layout then layout() end
end
openPage=function(key)
    if not builders[key] then return end
    if key=="Tutorial" then
        if match or waiting then notify(tr("Для обучения сначала заверши матч или выйди из очереди.","Finish your match or leave the queue before learning."));return end
        tutorialState=Tutor.new()
    end
    if menuOpen then pagePositions[page]=scroll.CanvasPosition end
    setPhoto(false);page=key;menuOpen=true;window.Visible=true;scrim.Visible=true;cameraBoard=false;resetCamera()
    pageAccent.BackgroundColor3=(nav[key] and nav[key].Accent) or K.Gold
    windowScale.Scale=.97;window.BackgroundTransparency=.08
    Tween:Create(windowScale,TweenInfo.new(.18,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Scale=1}):Play()
    Tween:Create(window,TweenInfo.new(.18),{BackgroundTransparency=0}):Play()
    scroll.CanvasPosition=pagePositions[key] or Vector2.zero;layout();rebuild();updateNav()
    if Input.GamepadEnabled then GuiService.SelectedObject=close end
end
-- A single notification system for every menu, match and reward.
local notifications=require(shared.Notifications).new(gui,tr)
notify=function(value) notifications:Push(value) end
-- Queue control: users can choose practice after waiting, never silently switched.
local queue=U.frame(gui,K.Ink,12);queue.ZIndex=25;queue.AnchorPoint=Vector2.new(.5,0);queue.Position=UDim2.new(.5,0,0,80);queue.Size=UDim2.fromOffset(480,82);queue.Visible=false
local queueTitle=T(queue,"",15,K.Text,F.Strong,16,8,-114,24)
local queueDetail=T(queue,"",12,K.Muted,F.Body,16,35,-148,34)
local cancel=U.button(queue,"","secondary",function() send("Cancel") end);cancel.AnchorPoint=Vector2.new(1,0);cancel.Position=UDim2.new(1,-12,0,12);cancel.Size=UDim2.fromOffset(38,38);local qi=U.icon(cancel,"Close",K.Muted);qi.Position=UDim2.fromOffset(7,7)
local practice=U.button(queue,"","secondary",function() join("BOT","Normal") end);practice.AnchorPoint=Vector2.new(1,1);practice.Position=UDim2.new(1,-12,1,-10);practice.Size=UDim2.fromOffset(116,40);practice.TextSize=12;practice.Visible=false
-- Vertical match rail. This module never writes game state or grants rewards.
local matchSidebar=require(shared:WaitForChild("MatchSidebar")).new(gui,tr,C.TurnSeconds)
local boardCard=U.frame(gui,K.Ink,15);boardCard.ZIndex=25;boardCard.Visible=false
local boardCaption=T(boardCard,"",12,K.Muted,F.Strong,16,10,-32,25)
-- Momentum 2.7.2: экранная сетка повёрнута к стороне игрока (X - западный спавн внизу, O - восточный).
local ORDER_X={3,6,9,2,5,8,1,4,7}
local ORDER_O={7,4,1,8,5,2,9,6,3}
local function cellAt(pos)
    if match and match.Symbol=="X" then return ORDER_X[pos] end
    if match and match.Symbol=="O" then return ORDER_O[pos] end
    return pos
end
local board,cells,marks=U.board(boardCard,function(index)
    local cell=cellAt(index)
    if match and not match.Finished and match.Turn==match.Symbol and match.Board[cell]=="" and workspace:GetServerTimeNow()&lt;match.Deadline then send("Move",{Id=match.Id,Revision=match.Revision,Index=cell}) end
end)
local primary=U.button(boardCard,"","secondary",function()
    if not match then return end
    if match.Finished then
        if not replayPending then replayPending=true;send("Replay",{Id=match.Id});updateMatchUI() end
    else cameraBoard=not cameraBoard end
end)
local secondary=U.button(boardCard,"","secondary",function()
    if not match then return end
    if match.Finished then boardOpen=false;layout();return end
    if os.clock()&lt;confirmation then send("Resign",{Id=match.Id});confirmation=0
    else confirmation=os.clock()+4;updateMatchUI() end
end)
local resultDetail=T(boardCard,"",12,K.Muted,F.Body,16,0,-32,28);resultDetail.TextXAlignment=Enum.TextXAlignment.Center
local matchResult=require(shared:WaitForChild("MatchResult")).new(gui,tr,function()
    if match and match.Finished and not replayPending then
        replayPending=true;send("Replay",{Id=match.Id});updateMatchUI()
    end
end,function() boardOpen=false;layout() end)
updateMatchUI=function()
    if not match then return end
    local data=match
    local myTurn=data.Turn==data.Symbol and not data.Finished
    local palette={X=Color3.new(table.unpack(data.Colors.X)),O=Color3.new(table.unpack(data.Colors.O))}
    matchSidebar:Update(data)
    matchResult:Update(data,currentReceipt,currentReceiptFailed,replayPending,receiptSummary(currentReceipt),receiptReason(currentReceipt))
    boardCaption.Text=tr("ТВОЙ СИМВОЛ  ","YOUR MARK  ")..data.Symbol.."   /   "..tr("АРЕНА ","COURT ")..string.format("%02d",data.Arena)..((data.Variant and data.Variant~="Classic") and ("   /   "..string.upper(Vr.name(data.Variant,ru))) or "")
    for i,b in ipairs(cells) do
        local cell=cellAt(i)
        local symbol=data.Board[cell]
        marks[i]:Set(symbol,palette[symbol] or K.Text,data.Glyphs and data.Glyphs[symbol])
        b.BackgroundColor3=(data.Line and table.find(data.Line,cell)) and K.GoldSoft or K.Raised
        if not data.Finished and data.Fading and (data.Fading.X==cell or data.Fading.O==cell) then
            b.BackgroundColor3=K.Surface
        end
        -- Empty cells remain legible during the opponent's turn, but cannot submit.
        b:SetAttribute("Disabled",not myTurn or symbol~="");b.Selectable=myTurn and symbol==""
    end
    primary.Text=data.Finished and (replayPending and tr("Следующий матч…","Next match…") or tr("Ещё матч","Play again")) or tr("Вид сверху","Board camera")
    primary.BackgroundColor3=data.Finished and K.Gold or K.Raised;primary.TextColor3=data.Finished and K.Ink or K.Text
    U.disabled(primary,data.Finished and replayPending)
    secondary.Text=data.Finished and tr("В клуб","Explore") or (os.clock()&lt;confirmation and tr("Точно сдаться?","Confirm resign?") or tr("Сдаться","Resign"))
    secondary.TextColor3=not data.Finished and os.clock()&lt;confirmation and K.Red or K.Muted
    if data.Finished then
        if currentReceiptFailed then resultDetail.Text=tr("Сохранение не подтверждено","Save not confirmed")
        elseif currentReceipt then resultDetail.Text=receiptSummary(currentReceipt)
        else resultDetail.Text=tr("Подводим итоги…","Wrapping up…") end
    else resultDetail.Text=myTurn and tr("Выбери свободную клетку","Choose an empty tile") or tr("Подумай над следующим ходом","Plan your next move") end
end
local ownedTouchGui=nil
local savedTouchEnabled=nil
local function syncTouchControls()
    if not Input.TouchEnabled then return end
    local touch=player.PlayerGui:FindFirstChild("TouchGui")
    local hide=menuOpen or (match~=nil and boardOpen)
    if hide and touch and touch:IsA("ScreenGui") then
        if ownedTouchGui~=touch then ownedTouchGui=touch;savedTouchEnabled=touch.Enabled end
        touch.Enabled=false
    elseif ownedTouchGui then
        if ownedTouchGui.Parent then ownedTouchGui.Enabled=savedTouchEnabled end
        ownedTouchGui=nil;savedTouchEnabled=nil
    end
end
local lastWidthBucket=nil
local resizeSerial=0
layout=function()
    local vp=gui.AbsoluteSize;if vp.X&lt;1 or vp.Y&lt;1 then return end
    local compact=vp.X&lt;620
    local short=vp.Y&lt;500 and vp.X&gt;vp.Y
    local mini=compact or match~=nil
    shell:Layout(vp,menuOpen,match~=nil,waiting~=nil)
    local menuWidth=math.min(900,vp.X-24);local menuHeight=math.min(676,math.max(160,vp.Y-126))
    if short then menuHeight=vp.Y-106 end
    window.Position=UDim2.new(.5,0,.5,-42)
    window.Size=UDim2.fromOffset(menuWidth,menuHeight)
    heading.TextSize=compact and 24 or 30
    if short then
        eyebrow.Visible=false;subheading.Visible=false;heading.Position=UDim2.fromOffset(18,12);heading.Size=UDim2.new(1,-78,0,35)
        close.Position=UDim2.new(1,-12,0,10);scroll.Position=UDim2.fromOffset(18,61);scroll.Size=UDim2.new(1,-36,1,-75)
    else
        eyebrow.Visible=true;subheading.Visible=true;heading.Position=UDim2.fromOffset(22,35);heading.Size=UDim2.new(1,-87,0,38)
        close.Position=UDim2.new(1,-18,0,18);scroll.Position=UDim2.fromOffset(22,112);scroll.Size=UDim2.new(1,-44,1,-130)
    end
    dock.AnchorPoint=Vector2.new(.5,1);dock.Position=UDim2.new(.5,0,1,-10);dock.Size=UDim2.fromOffset(math.min(640,vp.X-20),compact and 76 or 84)
    for _,v in pairs(nav) do v.Label.TextSize=compact and 11 or 12 end
    -- Compact live status, full-sized touch board, one unified result card.
    local margin=compact and 12 or 20
    local portrait=vp.X&lt;620 and not short
    local smallPortrait=portrait and vp.Y&lt;580
    local top=short and 12 or (portrait and (smallPortrait and 194 or 194) or 84)
    local gridTop=(short or smallPortrait) and 28 or 34
    local footerHeight=(short or smallPortrait) and 8 or 30
    local actionsHeight=short and 36 or 44
    local availableHeight=math.max(160,vp.Y-top-(short and 12 or 84))
    local boardSize=math.min(288,vp.X-margin*2-32,availableHeight-gridTop-8-actionsHeight-footerHeight)
    if short then boardSize=math.min(boardSize,math.floor(vp.X*.48)-32) end
    boardSize=math.max(96,boardSize)
    local cardWidth=boardSize+32
    local cardHeight=gridTop+boardSize+8+actionsHeight+footerHeight
    local sidebarWidth=portrait and (vp.X-margin*2) or math.min(294,vp.X-cardWidth-margin*3)
    sidebarWidth=math.max(184,sidebarWidth)
    matchSidebar:Layout(margin,short and 12 or (portrait and 92 or 94),sidebarWidth,80)
    boardCard.AnchorPoint=Vector2.new(portrait and .5 or 1,0)
    local boardY=not short and not portrait and math.max(top,math.floor((vp.Y-cardHeight)/2)) or top
    boardCard.Position=portrait and UDim2.new(.5,0,0,boardY) or UDim2.new(1,-margin,0,boardY)
    boardCard.Size=UDim2.fromOffset(cardWidth,cardHeight)
    fit(board,16,gridTop,boardSize,boardSize)
    boardCaption.Visible=true;boardCaption.TextSize=short and 10 or 11
    fit(boardCaption,16,6,cardWidth-32,20)
    local actionTop=gridTop+boardSize+8
    fit(primary,16,actionTop,(boardSize-8)/2,actionsHeight)
    fit(secondary,20+boardSize/2,actionTop,(boardSize-8)/2,actionsHeight)
    primary.TextSize=cardWidth&lt;250 and 11 or 13;secondary.TextSize=primary.TextSize
    resultDetail.Visible=not short and not smallPortrait
    fit(resultDetail,12,actionTop+actionsHeight+2,cardWidth-24,26)
    resultDetail.TextSize=11
    boardCard.Visible=match~=nil and not match.Finished and boardOpen and not menuOpen
    matchSidebar:SetVisible(match~=nil and not match.Finished and not menuOpen)
    matchResult:Layout(vp)
    matchResult:SetVisible(match~=nil and match.Finished and boardOpen and not menuOpen)
    wallet.Visible=not menuOpen and not (short and match)
    dock.Visible=not (short and match and match.Finished and boardOpen and not menuOpen)
    if short and not menuOpen and match and not match.Finished then
        dock.Size=UDim2.fromOffset(math.min(456,vp.X-16),66)
    end
    layoutNavDock()
    if menuOpen and vp.X&gt;=1000 and not short then
        local railWidth=156
        local fullWidth=math.min(1120,vp.X-48)
        local left=(vp.X-fullWidth)/2
        window.AnchorPoint=Vector2.new(0,.5)
        window.Position=UDim2.new(0,left+railWidth+16,.5,-8)
        window.Size=UDim2.fromOffset(fullWidth-railWidth-16,math.min(720,vp.Y-48))
        dock.AnchorPoint=Vector2.new(0,.5)
        dock.Position=UDim2.new(0,left,.5,-8)
        dock.Size=UDim2.fromOffset(railWidth,396)
        dockBackdrop.Size=UDim2.fromScale(1,1)
        dockGlow.Visible=false
        for i,key in ipairs(pages) do
            local v=nav[key]
            fit(v.Button,8,8+(i-1)*64,140,56)
            v.Icon.AnchorPoint=Vector2.new(0,.5);v.Icon.Position=UDim2.new(0,12,.5,0)
            v.IconTile.Visible=false
            v.Label.Position=UDim2.fromOffset(44,0);v.Label.Size=UDim2.new(1,-50,1,0)
            v.Label.TextXAlignment=Enum.TextXAlignment.Left;v.Label.TextSize=13
            v.Indicator.AnchorPoint=Vector2.new(0,.5);v.Indicator.Position=UDim2.new(0,0,.5,0);v.Indicator.Size=UDim2.fromOffset(2,24)
        end
    else
        window.AnchorPoint=Vector2.new(.5,.5);dockGlow.Visible=false
        for _,v in pairs(nav) do
            v.Icon.AnchorPoint=Vector2.new(.5,0);v.Icon.Position=UDim2.new(.5,0,0,9)
            v.IconTile.Visible=false;v.Label.TextXAlignment=Enum.TextXAlignment.Center
            v.Indicator.AnchorPoint=Vector2.new(.5,1);v.Indicator.Position=UDim2.new(.5,0,1,-5);v.Indicator.Size=UDim2.fromOffset(26,2)
        end
    end
    for _,v in pairs(nav) do v.Label.Visible=not (short and match and not menuOpen and dock.Size.X.Offset&lt;360) end
    player:SetAttribute("AtelierMenuOpen28",menuOpen)
    queue.Position=UDim2.new(.5,0,0,compact and 100 or 148)
    queue.Size=UDim2.fromOffset(math.min(480,vp.X-28),82);queue.Visible=waiting~=nil and not menuOpen and not match
    notifications:Layout(vp,(menuOpen and vp.X&gt;=1000) and 24 or (dock.Visible and (dock.Size.Y.Offset+24) or 24))
    updateNav();syncTouchControls()
    local bucket=math.floor(menuWidth/24)..":"..tostring(short)
    if menuOpen and bucket~=lastWidthBucket then
        lastWidthBucket=bucket;resizeSerial=resizeSerial+1;local version=resizeSerial
        task.delay(.12,function() if menuOpen and version==resizeSerial then rebuild() end end)
    end
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
local cameraConnection=nil
local function bindCamera()
    if cameraConnection then cameraConnection:Disconnect() end
    local cam=workspace.CurrentCamera
    if cam then cameraConnection=cam:GetPropertyChangedSignal("ViewportSize"):Connect(layout) end
    cameraApplied=false;cameraArena=nil;layout()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
bindCamera();updateNav()
remotes.State.OnClientEvent:Connect(function(data)
    if data.Kind=="Profile" then
        local first=profile==nil;local previousFX=lowFX;profile=data.Data
        if first then selectedSkin=profile.Equipped end
        soundOn=profile.Settings.Sound~=false
        updateWallet();updateNav()
        Audio.setEnabled(soundOn);player:SetAttribute("SkylineAmbience",soundOn)
        if first or previousFX~=(profile.Settings.LowFX==true) then applyFX(profile.Settings.LowFX==true) end
        local world=workspace:FindFirstChild("SkylineNexus");local discoveries=world and world:FindFirstChild("Discoveries")
        if discoveries then for _,o in ipairs(discoveries:GetChildren()) do applyWorldVisual(o) end end
        if menuOpen then rebuild() end
        if first then notify(tr("Выбери «Играть», чтобы начать дуэль.","Choose Play to start a duel.")) end
    elseif data.Kind=="Match" then
        local previous=match
        local fresh=not previous or previous.Id~=data.Id
        match=data;waiting=nil;setPhoto(false)
        if fresh then closeMenu();boardOpen=true;replayPending=false;confirmation=0;currentReceipt=receiptCache[data.Id];currentReceiptFailed=false end
        if data.Finished and (not previous or not previous.Finished) then rememberMatch(data);finishAt=workspace:GetServerTimeNow();cameraBoard=false;resetCamera();boardOpen=true;sfx(data.Result==data.Symbol and "Win" or (data.Result=="DRAW" and "Draw" or "Lose"))
        elseif previous and previous.Revision~=data.Revision then sfx(data.Turn==data.Symbol and "Opponent" or "Move") end
        updateMatchUI();layout()
        if Input.GamepadEnabled and data.Finished then
            GuiService.SelectedObject=matchResult.Primary
        elseif Input.GamepadEnabled and data.Symbol==data.Turn and not data.Finished then
            for i,b in ipairs(cells) do if data.Board[cellAt(i)]=="" then GuiService.SelectedObject=b;break end end
        end
    elseif data.Kind=="Lobby" then
        match=nil;waiting=nil;cameraBoard=false;confirmation=0;resetCamera();layout()
    elseif data.Kind=="Queue" then waiting=data;boardOpen=false;layout()
    elseif data.Kind=="Hub" then hub=data;refreshCourts()
    elseif data.Kind=="Open" then if builders[data.Page] then openPage(data.Page) end
    elseif data.Kind=="Notice" then notify(ru and data.RU or data.EN)
    elseif data.Kind=="Rush" then shell:UpdateRush(data);layout()
    elseif data.Kind=="Reward" then
        if type(data.Id)~="string" then return end
        local firstReceipt=receiptCache[data.Id]==nil
        receiptCache[data.Id]=data
        if firstReceipt then receiptOrder[#receiptOrder+1]=data.Id end
        if firstReceipt and (data.Coins or 0)&gt;0 then sfx("Reward") end
        while #receiptOrder&gt;32 do receiptCache[table.remove(receiptOrder,1)]=nil end
        for _,m in ipairs(recentMatches) do if m.Id==data.Id then m.Receipt=data;m.Failed=false end end
        if match and match.Id==data.Id then currentReceipt=data;currentReceiptFailed=false;updateMatchUI() end
        -- Active result already presents this receipt. Do not create a duplicate toast.
        if firstReceipt and not (match and match.Id==data.Id and match.Finished) then
            notify(receiptSummary(data)..". "..receiptReason(data))
        end
        if menuOpen and (page=="Play" or page=="Profile") then rebuild() end
    elseif data.Kind=="RewardFailed" then
        if receiptCache[data.Id] then return end
        for _,m in ipairs(recentMatches) do if m.Id==data.Id then m.Failed=true end end
        if match and match.Id==data.Id then currentReceiptFailed=true;updateMatchUI() end
        if menuOpen and (page=="Play" or page=="Profile") then rebuild() end
    end
end)
Market.PromptGamePassPurchaseFinished:Connect(function(p,id,purchased)
    if p==player and purchased and (id==C.PassIds.VIP or id==C.PassIds.BattlePass) then task.delay(1,function() send("RefreshVIP") end) end
end)
local elapsed=0
local hudElapsed=0
local touchTick=0
Run.RenderStepped:Connect(function(dt)
    if cameraBoard and match and not match.Finished and not menuOpen then
        if not cameraApplied or cameraArena~=match.Arena then
            local world=workspace:FindFirstChild("SkylineNexus")
            local courts=world and world:FindFirstChild("Arenas")
            local court=courts and courts:FindFirstChild("Arena"..match.Arena)
            local center=court and court:FindFirstChild("Center")
            local cam=workspace.CurrentCamera
            if center and cam then
                cam.CameraType=Enum.CameraType.Scriptable;cam.FieldOfView=68
                -- Вид сверху повёрнут к стороне игрока: X с запада, O с востока.
                local side=match.Symbol=="O" and 1 or -1
                cam.CFrame=CFrame.lookAt(center.Position+Vector3.new(side,25,0),center.Position,Vector3.new(-side,0,0))
                cameraApplied=true;cameraArena=match.Arena
            end
        end
    elseif cameraApplied then resetCamera() end
    hudElapsed=hudElapsed+dt;if hudElapsed&gt;=1 then hudElapsed=0;shell:Step() end
    elapsed=elapsed+dt;if elapsed&lt;.1 then return end;elapsed=0
    -- 3.6.0: проверка сенсорных кнопок раз в полсекунды вместо десяти раз в секунду.
    touchTick=touchTick+1
    if touchTick&gt;=5 then touchTick=0;syncTouchControls() end
    if match then
        matchSidebar:Step(workspace:GetServerTimeNow())
        if confirmation&gt;0 and os.clock()&gt;=confirmation then confirmation=0;updateMatchUI() end
    end
    if waiting then
        local seconds=math.max(0,math.floor(workspace:GetServerTimeNow()-waiting.Since))
        queueTitle.Text=waiting.Mode=="PVP" and tr("Ищем твоего соперника","Finding your rival") or tr("Ждём свободную арену","Waiting for a court")
        queueDetail.Text=seconds..tr(" сек. · Позиция "," sec · Position ")..waiting.Position
        practice.Visible=waiting.Mode=="PVP" and seconds&gt;=20
        queue.Size=UDim2.new(queue.Size.X.Scale,queue.Size.X.Offset,0,practice.Visible and 106 or 82)
        practice.Text=tr("В тренировку","Try practice")
    end
end)
Input.InputBegan:Connect(function(input,processed)
    if processed then return end
    local key=input.KeyCode
    if key==Enum.KeyCode.P and not match then if menuOpen then closeMenu() end;setPhoto(not photoMode) end
    if (key==Enum.KeyCode.Q or key==Enum.KeyCode.ButtonX) and match then closeMenu();boardOpen=not boardOpen;layout() end
    if key==Enum.KeyCode.M or key==Enum.KeyCode.ButtonY then if menuOpen then closeMenu() else openPage("Play") end end
    if (key==Enum.KeyCode.ButtonB or key==Enum.KeyCode.Escape) and menuOpen then closeMenu() end
    if key==Enum.KeyCode.R and not match then openPage("Quests") end
    if key==Enum.KeyCode.H and not match and not menuOpen then send("Home") end
end)
player.CharacterAdded:Connect(function() cameraBoard=false;setPhoto(false);task.delay(.3,resetCamera) end)
task.spawn(function() for _=1,30 do send("Ready");if profile then break end;task.wait(2) end end)
print("[Skyline] Horizon 3.7.1 UI ready. Responsive HUD, readable wallet, lighter client loops.")

-- Cosmetic refresh only: the server still decides eligibility and reset boundaries.
task.spawn(function()
    local lastDay=math.floor(workspace:GetServerTimeNow()/86400)
    while gui.Parent do
        task.wait(15)
        local day=math.floor(workspace:GetServerTimeNow()/86400)
        if day~=lastDay then lastDay=day;shell:Step();updateNav();if menuOpen and (page=="Quests" or page=="Club" or page=="Pass") then rebuild() end end
    end
end)
