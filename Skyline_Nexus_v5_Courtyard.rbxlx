    local tag=T(hero,tr("ДУЭЛЬ · PVP","DUEL · PVP"),11,K.Ink,F.Strong,20,17,-145,18)
    local title=T(hero,tr("Один на один","One on one"),wide and 33 or 25,K.Ink,F.Display,18,48,wide and -230 or -113,80);title.TextYAlignment=Enum.TextYAlignment.Top
    local desc=T(hero,tr("Рейтинг · 20 секунд на ход","Ranked · 20 seconds per turn"),13,K.Ink,F.Body,20,wide and 118 or 120,wide and -236 or -125,37)
    local b=buttonAt(hero,tr("Найти соперника","Find a rival"),"secondary",function() join("PVP") end,20,wide and 166 or 158,wide and -240 or -132,44)
    b.BackgroundColor3=K.Ink;b.TextColor3=K.Text
    local practice=section(300)
    T(practice,tr("ТРЕНИРОВКА С БОТОМ","PRACTICE WITH A BOT"),10,K.Gold,F.Strong,18,14,-36,15)
    local names={Easy=tr("Новичок","Easy"),Normal=tr("Тактик","Normal"),Hard=tr("Мастер","Hard")}
    local descriptions={Easy=tr("Спокойное начало: бот часто ошибается.","A relaxed start. This bot makes mistakes."),Normal=tr("Умный соперник с шансом на ошибку.","A tactical opponent, with room for an upset."),Hard=tr("Идеальная стратегия. В классике твоя цель: ничья.","Perfect strategy. In Classic, aim for a draw.")}
    local tabWidth=(visibleWidth()-40)/3
    for i,key in ipairs({"Easy","Normal","Hard"}) do
        local level=key
        local b=U.button(practice,names[key],key==difficulty and "primary" or "secondary",function() difficulty=level;rebuild() end)
        fit(b,16+(i-1)*(tabWidth+4),36,tabWidth-2,40)
    end
    local levelNote=T(practice,descriptions[difficulty],13,K.Muted,F.Body,18,82,-36,34)
    levelNote.TextYAlignment=Enum.TextYAlignment.Top
    U.rule(practice,16,126,-32)
    T(practice,tr("ПРАВИЛА","RULES"),10,K.Gold,F.Strong,18,138,-36,15)
    if not Vr.valid(variant) then variant="Classic" end
    for i,key in ipairs(Vr.Order) do
        local rules=key
