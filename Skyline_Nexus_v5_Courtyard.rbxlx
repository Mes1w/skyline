      <Item class="ModuleScript" referent="RBX1688">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- SKYLINE NEXUS 3.7.3 HORIZON | Единственное место настройки игры.
-- Публикация: сначала сохраните place в Roblox, затем создайте товары ЭТОГО experience.
-- Нулевой ID отключает покупку за Robux. Рекомендуемые цены - лишь гипотеза для теста.
local C = {}
C.Version = "5.0.0"
C.Title = "SKYLINE NEXUS"
C.ArenaCount = 4
C.TurnSeconds = 20
C.ResultSeconds = 10
C.StartRating = 1000
C.KFactor = 24
C.ProfileStore = "SkylineNexus_Profile_v1"
C.RatingStore = "SkylineNexus_Rating_v1"
C.ChampionStore = "SkylineNexus_Champions_v1" -- 3.2.2: чемпионы недели/месяца для Стены истории.
C.CoinRush = {Goal = 20, Seconds = 80, Coins = 120, XP = 60} -- 3.2.2: монетный забег, награда раз в сутки.
C.StudioPreview = {Club=false, Premium=false} -- Only in Studio, only with nonpersistent test profiles.
C.StudioPersistence = false -- Не включать на production-хранилище для обычных тестов.
C.SessionLease = 180
C.HeartbeatSeconds = 55
C.MinRewardSeconds = 14
C.RewardedMatchesPerHour = 40
C.PairRatedMatchesPerHour = 4
C.PassIds = { VIP = 0, BattlePass = 0 } -- Club includes the Tide Premium track. Separate one-time passes.
C.Products = {
    Coins500 = { Id = 0, Coins = 500, RU = "500 монет", EN = "500 coins" }, -- ориентир 39 R$
    Coins1600 = { Id = 0, Coins = 1600, RU = "1600 монет", EN = "1600 coins" }, -- 99 R$
    Coins4200 = { Id = 0, Coins = 4200, RU = "4200 монет", EN = "4200 coins" }, -- 199 R$
}
C.ProductOrder = {"Coins500", "Coins1600", "Coins4200"}
-- Старые ID НЕ удалять из обработчика, пока остаются неполученные покупки.
C.RetiredProducts = {} -- [старыйProductId] = количествоМонет
C.DailyCoins = {75, 100, 125, 150, 175, 200, 300}
C.StreakBonus = {Every = 3, Coins = 25, XP = 15} -- Бонус за каждую N-ю победу подряд. Считает только сервер.
C.Skins = {
    Classic = {Price=0, RU="Классика", EN="Classic", X={255,93,125}, O={69,158,255}},
    Aurora = {Price=350, RU="Аврора", EN="Aurora", X={196,132,255}, O={88,235,203}},
    Sunset = {Price=650, RU="Закат", EN="Sunset", X={255,151,74}, O={255,99,183}},
    Glacier = {Price=900, RU="Ледник", EN="Glacier", X={218,248,255}, O={85,208,255}},
    Sakura = {Price=1200, RU="Сакура", EN="Sakura", X={255,153,198}, O={178,168,255}},
    Obsidian = {Price=1800, RU="Обсидиан", EN="Obsidian", X={241,192,111}, O={179,184,216}},
    Skyline = {Price=0, VIP=true, RU="Skyline Gold", EN="Skyline Gold", X={255,208,103}, O={255,239,182}},
}
-- Only a compact curated set is shown. Legacy definitions above stay valid for existing profiles.
C.SkinOrder = {}
C.QuestOrder = {"Play3", "Win2", "Moves12", "Moves24"}
C.Quests = {
    Play3 = {Field="Games", Goal=3, Coins=90, XP=50, RU="Завершите 3 матча", EN="Complete 3 matches"},
    Win2 = {Field="Wins", Goal=2, Coins=100, XP=70, RU="Победите 2 раза", EN="Win 2 matches"},
    Moves12 = {Field="Moves", Goal=12, Coins=80, XP=40, RU="Сделайте 12 ходов", EN="Make 12 moves"},
    Moves24 = {Field="Moves", Goal=24, Coins=120, XP=60, RU="Сделайте 24 хода", EN="Make 24 moves"},
}
C.Rewards = {
    PVP={Win=55,Draw=28,Loss=12,XP=55},
    Easy={Win=18,Draw=8,Loss=4,XP=22},
    Normal={Win=30,Draw=15,Loss=6,XP=32},
    Hard={Win=45,Draw=25,Loss=9,XP=42},
}
C.BadgeIds = {FirstWin=0, TenWins=0, Explorer=0}
C.Analytics = true -- встроенные события в Creator Dashboard; best-effort, не блокируют игру.

-- TIDE JOURNEY: permanent progress. Never change Key to rotate a live pass.
C.BattlePass={Key="TideJourney1",RU="Прилив",EN="Tide",Tiers=30,XPPerTier=300,
    MatchXP=35,WinXP=15,FirstMatchXP=100,MasteryXP=1000,MasteryCoins=100,Rewards={}}
for i=1,C.BattlePass.Tiers do
    C.BattlePass.Rewards[i]={Free={Coins=40+math.floor(i/5)*10},Premium={Coins=75+math.floor(i/5)*15}}
end
C.WeeklyOrder={"WeekPlay15","WeekWin5","WeekMoves60"}
C.WeeklyQuests={
    WeekPlay15={Field="Games",Goal=15,Coins=200,PassXP=400,RU="Завершите 15 матчей",EN="Complete 15 matches"},
    WeekWin5={Field="Wins",Goal=5,Coins=250,PassXP=500,RU="Победите 5 раз",EN="Win 5 matches"},
    WeekMoves60={Field="Moves",Goal=60,Coins=200,PassXP=400,RU="Сделайте 60 ходов",EN="Make 60 moves"},
}
for _,q in pairs(C.Quests) do q.PassXP=100 end
C.Club={WelcomeCoins=400,DailyCoins=75,PaletteOrder={"Skyline"},
    TrailOrder={"Gold","Mint","Violet","Off"},Trails={
        Gold={RU="Золото",EN="Gold",Color={255,207,125}},
        Mint={RU="Мята",EN="Mint",Color={119,232,204}},
        Violet={RU="Аметист",EN="Amethyst",Color={194,158,255}},
        Off={RU="Без следа",EN="No trail",Color={255,255,255}},
    }}
-- Universal style families: every palette works with every mark set and rules variant.
-- Hidden legacy keys remain server-valid so existing equipped profiles do not break.
local newSkins={
    {"Tide",{RU="Прилив",EN="Tide",X={78,214,199},O={141,190,255},PassOnly=true,Universal=true},5,"Free"},
    {"DeepSea",{RU="Глубина",EN="Deep Sea",X={52,132,184},O={95,238,218},PassOnly=true,Universal=true}},
    {"Eclipse",{RU="Затмение",EN="Eclipse",X={235,173,91},O={137,139,216},PassOnly=true,Universal=true},30,"Free"},
    {"RoseGold",{RU="Розовое золото",EN="Rose Gold",X={245,174,178},O={255,219,155},PassOnly=true,Universal=true}},
    {"Prism",{RU="Призма",EN="Prism",X={173,138,255},O={116,232,223},PassOnly=true,Universal=true}},
    {"Nebula",{RU="Туманность",EN="Nebula",X={204,120,244},O={119,163,248},PassOnly=true,Universal=true}},
    {"Solstice",{RU="Солнцестояние",EN="Solstice",X={255,186,79},O={249,240,201},PassOnly=true,Universal=true}},
    {"ClubJade",{RU="Клубный нефрит",EN="Club Jade",X={103,198,164},O={214,230,190},VIP=true,Universal=true}},
    {"ClubVelvet",{RU="Клубный бархат",EN="Club Velvet",X={187,145,218},O={244,192,206},VIP=true,Universal=true}},
}
for _,entry in ipairs(newSkins) do
    local key,skin=entry[1],entry[2];skin.Price=0;C.Skins[key]=skin
    if entry[3] then C.BattlePass.Rewards[entry[3]][entry[4]]={Skin=key};skin.PassTier=entry[3];skin.PassTrack=entry[4] end
end
for _,key in ipairs({"Classic","Aurora","Sunset","Glacier","Obsidian","Tide","Eclipse","Skyline"}) do
    C.Skins[key].Universal=true;table.insert(C.SkinOrder,key)
end

-- Skyline 3.1 · сток монет поздней игры: наборы ЗНАЧКОВ, а не новые палитры.
-- Палитра меняет цвет метки, набор значков меняет её форму и в UI, и на арене.
-- Ключи X/O — это имена глифов из модуля Glyphs.
C.Shapes = {
    Classic = {Price=0, RU="Крестик и нолик", EN="Cross &amp; Ring", X="cross", O="ring"},
    Blocks = {Price=900, RU="Квадрат и клин", EN="Block &amp; Wedge", X="square", O="triangle"},
    Prism = {Price=1800, RU="Ромб и плюс", EN="Diamond &amp; Plus", X="diamond", O="plus"},
    Lumen = {Price=3200, RU="Звезда и сота", EN="Star &amp; Hex", X="star", O="hex"},
}
C.ShapeOrder = {"Classic","Blocks","Prism","Lumen"}

-- 3.5.0 · Медали: одноразовые достижения с наградой. Всё выдаёт сервер в транзакции профиля.
C.Medals = {
    FirstSteps = {Field="Games",      Goal=1,    Coins=50,  XP=25,  RU="Первый шаг",        EN="First steps"},
    FirstWin   = {Field="Wins",       Goal=1,    Coins=75,  XP=40,  RU="Первая победа",     EN="First win"},
    Regular    = {Field="Games",      Goal=25,   Coins=150, XP=80,  RU="Завсегдатай",       EN="Regular"},
    Winner     = {Field="Wins",       Goal=25,   Coins=250, XP=120, RU="Победитель",        EN="Winner"},
    Streak5    = {Field="BestStreak", Goal=5,    Coins=200, XP=90,  RU="Серия из пяти",     EN="Five in a row"},
    Rated1200  = {Field="Rating",     Goal=1200, Coins=300, XP=150, RU="Рейтинг 1200",      EN="Rating 1200"},
    RushRunner = {Field="RushBest",   Goal=10,   Coins=180, XP=90,  RU="Бегун забега",      EN="Rush runner"},
    Explorer5  = {Field="Explorer",   Goal=5,    Coins=220, XP=110, RU="Исследователь",     EN="Explorer"},
    Veteran    = {Field="Games",      Goal=100,  Coins=400, XP=200, RU="Ветеран арены",     EN="Arena veteran"},
    Champion   = {Field="Wins",       Goal=100,  Coins=650, XP=320, RU="Чемпион",           EN="Champion"},
    Streak10   = {Field="BestStreak", Goal=10,   Coins=450, XP=220, RU="Несокрушимый",      EN="Unstoppable"},
    Rated1400  = {Field="Rating",     Goal=1400, Coins=700, XP=350, RU="Рейтинг 1400",      EN="Rating 1400"},
}
C.MedalOrder = {"FirstSteps","FirstWin","Regular","Winner","Streak5","Rated1200","RushRunner","Explorer5","Veteran","Champion","Streak10","Rated1400"}

-- 3.5.0 · Режим дня: один вариант правил каждый день приносит больше монет.
C.DailyFeature = {Mult = 1.15}

return C
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX1689">
        <Properties>
          <string name="Name">Logic</string>
          <ProtectedString name="Source">-- Чистая игровая логика. Не доверяет клиентскому результату или суммам наград.
local L = {}
L.Lines = {{1,2,3},{4,5,6},{7,8,9},{1,4,7},{2,5,8},{3,6,9},{1,5,9},{3,5,7}}
function L.other(s) return s == "X" and "O" or "X" end
function L.outcome(b)
    for _, line in ipairs(L.Lines) do
        local s = b[line[1]]
        if s ~= "" and s == b[line[2]] and s == b[line[3]] then return s, line end
    end
    for i=1,9 do if b[i] == "" then return nil end end
    return "DRAW"
end
function L.empty(b)
    local t = {}
    for i=1,9 do if b[i] == "" then t[#t+1] = i end end
    return t
end
local memo = {}
local memoCount = 0
local function solve(b, turn, bot)
    local result = L.outcome(b)
    if result then
        if result == "DRAW" then return 0 end
        return result == bot and (10+#L.empty(b)) or (-10-#L.empty(b))
    end
    local key = table.concat(b, ".")..turn..bot
    if memo[key] then return memo[key] end
    local best = turn == bot and -100 or 100
    for _, i in ipairs(L.empty(b)) do
        b[i] = turn
        local score = solve(b, L.other(turn), bot)
        b[i] = ""
        if turn == bot then best = math.max(best,score) else best = math.min(best,score) end
    end
    if memoCount &gt; 40000 then memo = {}; memoCount = 0 end
    memo[key] = best
    memoCount = memoCount + 1
    return best
end
function L.bot(b, symbol, difficulty, rng)
    local moves = L.empty(b)
    if #moves == 0 then return nil end
    local function randomMove() return moves[rng:NextInteger(1,#moves)] end
    if difficulty == "Easy" and rng:NextNumber() &lt; .7 then return randomMove() end
    if difficulty == "Normal" and rng:NextNumber() &lt; .22 then return randomMove() end
    local best, choices = -100, {}
    for _, i in ipairs(moves) do
        b[i] = symbol
        local score = solve(b,L.other(symbol),symbol)
        b[i] = ""
        if score &gt; best then best=score; choices={i}
        elseif score == best then choices[#choices+1]=i end
    end
    return choices[rng:NextInteger(1,#choices)]
end
function L.elo(a,b,score,k)
    return math.max(100, math.floor(a + k*(score-1/(1+10^((b-a)/400))) + .5))
end
function L.level(xp) return math.floor(math.sqrt(math.max(0,xp)/80))+1 end
function L.day() return math.floor(os.time()/86400) end
function L.daily(d,day)
    if d.QuestDay ~= day then
        d.QuestDay=day; d.QuestProgress={Games=0,Wins=0,Moves=0}; d.QuestClaims={}
    end
end
function L.copy(t)
    if type(t) ~= "table" then return t end
    local r={} for k,v in pairs(t) do r[k]=L.copy(v) end return r
end
-- Skyline 3.0 · поддержка вариантов правил. Всё чистое, без побочных эффектов.
-- maxMarks=0 — классика. maxMarks&gt;0 — у символа не больше N знаков, старейший исчезает.
function L.place(board,history,index,symbol,maxMarks)
    board[index]=symbol
    history[symbol]=history[symbol] or {}
    local queue=history[symbol]
    queue[#queue+1]=index
    if maxMarks and maxMarks&gt;0 and #queue&gt;maxMarks then
        local removed=table.remove(queue,1)
        if board[removed]==symbol then board[removed]="" end
        return removed
    end
    return nil
end

-- Индекс знака, который исчезнет при следующем ходе этого символа.
function L.fading(history,symbol,maxMarks)
    if not history or not maxMarks or maxMarks&lt;=0 then return nil end
    local queue=history[symbol]
    if not queue or #queue&lt;maxMarks then return nil end
    return queue[1]
end

-- Бот для варианта "Смыв": полный minimax здесь неприменим (игра не конечна),
-- поэтому считаем победу в один ход, ответные угрозы и позиционный бонус.
function L.shiftBot(board,history,symbol,difficulty,rng,maxMarks)
    local moves=L.empty(board)
    if #moves==0 then return nil end
    local function randomMove() return moves[rng:NextInteger(1,#moves)] end
    if difficulty=="Easy" and rng:NextNumber()&lt;.55 then return randomMove() end
    if difficulty=="Normal" and rng:NextNumber()&lt;.2 then return randomMove() end
    local rival=L.other(symbol)
    local function historyCopy(source)
        local out={X={},O={}}
        for _,key in ipairs({"X","O"}) do
            for i,value in ipairs((source and source[key]) or {}) do out[key][i]=value end
        end
        return out
    end
    local function score(index)
        local b=L.copy(board)
        local h=historyCopy(history)
        L.place(b,h,index,symbol,maxMarks)
        if L.outcome(b)==symbol then return 1000 end
        local threats=0
        for _,j in ipairs(L.empty(b)) do
            local b2=L.copy(b)
            local h2=historyCopy(h)
            L.place(b2,h2,j,rival,maxMarks)
            if L.outcome(b2)==rival then threats=threats+1 end
        end
        local value=-threats*120
        if index==5 then value=value+8 end
        if index==1 or index==3 or index==7 or index==9 then value=value+4 end
        return value
    end
    local best,choices=-math.huge,{}
    for _,index in ipairs(moves) do
        local value=score(index)
        if value&gt;best then best=value;choices={index}
        elseif value==best then choices[#choices+1]=index end
    end
    return choices[rng:NextInteger(1,#choices)]
end

return L
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_CLUB_50117">
        <Properties>
          <string name="Name">DesignSystem</string>
          <ProtectedString name="Source">-- Skyline Atelier: one readable Builder Sans typographic family, no third-party assets.
local D={}
D.Color={
    Ink=Color3.fromRGB(30,33,38),Surface=Color3.fromRGB(40,44,49),Raised=Color3.fromRGB(52,56,60),
    Border=Color3.fromRGB(119,116,105),Text=Color3.fromRGB(239,235,223),Muted=Color3.fromRGB(185,184,174),
    Gold=Color3.fromRGB(205,175,120),GoldSoft=Color3.fromRGB(65,57,43),Sage=Color3.fromRGB(144,170,143),
    Red=Color3.fromRGB(226,145,131),White=Color3.fromRGB(255,253,246),Blue=Color3.fromRGB(153,174,181),
}
D.Font={
    Body=Font.new("rbxasset://fonts/families/BuilderSans.json",Enum.FontWeight.Regular),
    Strong=Font.new("rbxasset://fonts/families/BuilderSans.json",Enum.FontWeight.Bold),
    Display=Font.new("rbxasset://fonts/families/BuilderSans.json",Enum.FontWeight.SemiBold),
    Brand=Font.new("rbxasset://fonts/families/BuilderSans.json",Enum.FontWeight.Bold),
}
D.Type={Display=32,Title=24,Heading=18,Body=15,Small=13,Caption=11}
return D
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_CLUB_50118">
        <Properties>
          <string name="Name">UIComponents</string>
          <ProtectedString name="Source">-- Reusable native Roblox UI. All icons and board marks are geometry, not emoji.
local Tween=game:GetService("TweenService")
local D=require(script.Parent.DesignSystem)
local Glyph=require(script.Parent.Glyphs)
local U={Motion=true}
local C=D.Color
function U.new(class,props,parent)
    local o=Instance.new(class)
    if o:IsA("GuiObject") then
        o.BorderSizePixel=0
        o.ZIndex=(parent and parent:IsA("GuiObject")) and parent.ZIndex+1 or 2
    end
    for k,v in pairs(props or {}) do o[k]=v end
    o.Parent=parent
    return o
end
function U.round(o,r) return U.new("UICorner",{CornerRadius=UDim.new(0,math.min(r or 8,12))},o) end
function U.stroke(o,color,alpha,width)
    return U.new("UIStroke",{Color=color or C.Border,Thickness=width or 1,Transparency=alpha or .55,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},o)
end
function U.frame(parent,color,radius)
    local f=U.new("Frame",{BackgroundColor3=color or C.Surface},parent)
    if radius~=0 then U.round(f,radius or 12) end
    return f
end
function U.text(parent,value,size,color,font)
    return U.new("TextLabel",{BackgroundTransparency=1,Text=value or "",TextColor3=color or C.Text,TextSize=size or 15,FontFace=font or D.Font.Body,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,RichText=false},parent)
end
function U.rule(parent,x,y,w,color)
    return U.new("Frame",{Position=UDim2.new(0,x,0,y),Size=UDim2.new(1,w,0,1),BackgroundColor3=color or C.Border,BackgroundTransparency=.55},parent)
end
function U.disabled(b,disabled)
    b:SetAttribute("Disabled",disabled==true)
    b.Selectable=not disabled
    b.TextTransparency=disabled and .5 or 0
    b.BackgroundTransparency=disabled and .38 or 0
end
function U.button(parent,value,style,fn)
    style=style or "secondary"
    local primary=style=="primary"
    local b=U.new("TextButton",{Text=value or "",TextSize=14,FontFace=D.Font.Strong,TextColor3=primary and C.Ink or (style=="danger" and C.Red or C.Text),BackgroundColor3=primary and C.Gold or C.Raised,AutoButtonColor=false,Selectable=true,TextWrapped=true},parent)
    U.round(b,9)
    local focus=U.stroke(b,primary and C.White or C.Border,primary and .65 or .75,1)
    focus.Name="ButtonOutline"
    local activatedAt=-math.huge
    local overlay=U.new("Frame",{BackgroundColor3=C.White,BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Active=false},b);U.round(overlay,9)
    local function state(v)
        if b:GetAttribute("Disabled") then return end
        if U.Motion then Tween:Create(focus,TweenInfo.new(.13),{Transparency=v}):Play()
        else focus.Transparency=v end
    end
    b.MouseEnter:Connect(function() state(.45) end)
    b.MouseLeave:Connect(function() state(.75) end)
    b.SelectionGained:Connect(function() state(.1) end)
    b.SelectionLost:Connect(function() state(.75) end)
    b.MouseButton1Down:Connect(function() if not b:GetAttribute("Disabled") then overlay.BackgroundTransparency=.94 end end)
    b.MouseButton1Up:Connect(function() overlay.BackgroundTransparency=1 end)
    b.MouseLeave:Connect(function() overlay.BackgroundTransparency=1 end)
    b.Activated:Connect(function()
        overlay.BackgroundTransparency=1
        if not b:GetAttribute("Disabled") and os.clock()-activatedAt&gt;=.14 then activatedAt=os.clock();if fn then fn() end end
    end)
    return b
end
local function line(parent,x1,y1,x2,y2,color,thickness)
    local dx,dy=x2-x1,y2-y1
    local f=U.new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset((x1+x2)/2,(y1+y2)/2),Size=UDim2.fromOffset(math.sqrt(dx*dx+dy*dy),thickness or 1.7),Rotation=math.deg(math.atan2(dy,dx)),BackgroundColor3=color},parent)
    U.round(f,2);return f
end
function U.icon(parent,key,color)
    color=color or C.Muted
    local f=U.new("Frame",{BackgroundTransparency=1,Size=UDim2.fromOffset(24,24)},parent)
    local function l(a,b,c,d,t) return line(f,a,b,c,d,color,t or 2) end
    local function ring(x,y,w,h,t)
        local p=U.new("Frame",{Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),BackgroundTransparency=1},f)
        U.round(p,math.min(w,h)/2);U.stroke(p,color,0,t or 2);return p
    end
    local function box(x,y,w,h,r,t)
        local p=U.new("Frame",{Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),BackgroundTransparency=1},f)
        U.round(p,r or 3);U.stroke(p,color,0,t or 2);return p
    end
    local function fill(x,y,w,h,r)
        local p=U.new("Frame",{Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),BackgroundColor3=color},f)
        U.round(p,r or 2.5);return p
    end
    if key=="Play" then
        fill(3.5,3.5,7.5,7.5,2.5);ring(13,3.5,7.5,7.5,2);ring(3.5,13,7.5,7.5,2);fill(13,13,7.5,7.5,2.5)
    elseif key=="Shop" then
        box(4,8,16,13,4);l(9,8,9,5.5);l(9,5.5,15,5.5);l(15,5.5,15,8);fill(8,13,3,3,1.5);fill(13,13,3,3,1.5)
    elseif key=="Pass" then
        ring(6.5,2.5,11,11,2);fill(10.5,6,3,4,1.5);l(9,14,7,21.5);l(7,21.5,12,18.5);l(12,18.5,17,21.5);l(17,21.5,15,14)
    elseif key=="Quests" then
        box(4.5,4,15,17,4);fill(9,2,6,4,2);l(8,11,10.5,13.5,2.3);l(10.5,13.5,16,7,2.3);l(8,17.5,16,17.5,2)
    elseif key=="Club" then
        l(12,2.5,20,6);l(20,6,20,12);l(20,12,12,21.5);l(12,21.5,4,12);l(4,12,4,6);l(4,6,12,2.5);fill(9.5,9.5,5,5,1.6)
    elseif key=="Profile" then
        ring(7.5,2.5,9,9,2);l(3.5,21.5,3.5,17.5);l(3.5,17.5,8.5,14);l(8.5,14,15.5,14);l(15.5,14,20.5,17.5);l(20.5,17.5,20.5,21.5)
    elseif key=="Trophy" then
        l(7,4,17,4);l(7,4,8,11.5);l(8,11.5,16,11.5);l(16,11.5,17,4);l(7.5,6,4,6);l(4,6,5.5,10.5);l(16.5,6,20,6);l(20,6,18.5,10.5);l(12,11.5,12,16.5);l(8,20.5,16,20.5);l(9.5,16.5,14.5,16.5)
    elseif key=="Coin" then
        ring(3,3,18,18,2);ring(7,7,10,10,1.4);l(12,7.5,12,16.5,1.8);l(8.5,12,15.5,12,1.8)
    elseif key=="Gift" then
        box(4,10,16,11,2);box(2.5,7,19,4,1.5);l(12,7,12,21)
        l(12,7,6,5);l(6,5,7,2);l(7,2,12,7);l(12,7,17,2);l(17,2,18,5);l(18,5,12,7)
    elseif key=="Sound" then
        l(3,9,7,9);l(7,9,12,5);l(12,5,12,19);l(12,19,7,15);l(7,15,3,15);l(3,15,3,9)
        l(16,8,18,10);l(18,10,18,14);l(18,14,16,16);l(20,5,22,9);l(22,9,22,15);l(22,15,20,19)
    elseif key=="Help" then
        ring(2,2,20,20,1.8);l(8,8,9,6);l(9,6,14,6);l(14,6,16,9);l(16,9,12,12);l(12,12,12,14);fill(11,17,2,2,1)
    elseif key=="Close" then l(6,6,18,18,2.2);l(6,18,18,6,2.2)
    elseif key=="Arrow" then l(4,12,19,12,2.2);l(13,6,19.5,12,2.2);l(13,18,19.5,12,2.2)
    elseif key=="Check" then l(4,13,9.5,18.5,2.6);l(9.5,18.5,20,6,2.6)
    elseif key=="Camera" then box(3,7.5,18,13,4);ring(8,10,8,8,2);fill(9,4,6,3.2,1.6);fill(16.5,10,2.4,2.4,1.2)
    end
    return f
end
function U.tintIcon(f,color)
    for _,o in ipairs(f:GetDescendants()) do
        if o:IsA("UIStroke") then o.Color=color
        elseif o:IsA("Frame") and o.BackgroundTransparency&lt;1 then o.BackgroundColor3=color end
    end
end
function U.mark(parent,symbol,color,kind)
    local root=U.new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromScale(.52,.52),BackgroundTransparency=1,Visible=symbol~=""},parent)
    U.new("UIAspectRatioConstraint",{AspectRatio=1},root)
    local built,strokes={},{}
    local function build(name)
        local spec=Glyph.get(name)
        local holder=U.new("Frame",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Visible=false},root)
        if spec.Round then
            local circle=U.new("Frame",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1},holder)
            U.round(circle,100)
            strokes[name]=U.stroke(circle,C.Text,0,5)
        else
            for _,seg in ipairs(spec.Segments) do
                local dx,dy=seg[3]-seg[1],seg[4]-seg[2]
                local length=math.sqrt(dx*dx+dy*dy)
                local bar=U.new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale((seg[1]+seg[3])/2,(seg[2]+seg[4])/2),Size=UDim2.fromScale(length,spec.Thickness),Rotation=math.deg(math.atan2(dy,dx)),BackgroundColor3=C.Text},holder)
                U.round(bar,100)
            end
        end
        built[name]=holder
        return holder
    end
    local function resize()
        for _,stroke in pairs(strokes) do stroke.Thickness=math.max(2,root.AbsoluteSize.X*.13) end
    end
    root:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
    local obj={Root=root}
    function obj:Set(value,tint,glyph)
        local name=Glyph.valid(glyph) and glyph or Glyph.fallback(value)
        root.Visible=value~=""
        for _,holder in pairs(built) do holder.Visible=false end
        if value=="" then return end
        local holder=built[name] or build(name)
        holder.Visible=true
        local paint=tint or C.Text
        if strokes[name] then strokes[name].Color=paint end
        for _,bar in ipairs(holder:GetDescendants()) do
            if bar:IsA("Frame") and bar.BackgroundTransparency&lt;1 then bar.BackgroundColor3=paint end
        end
        resize()
    end
    obj:Set(symbol,color,kind)
    return obj
end

function U.board(parent,callback)
    local f=U.new("Frame",{BackgroundTransparency=1},parent)
    U.new("UIGridLayout",{CellSize=UDim2.new(1/3,-4,1/3,-4),CellPadding=UDim2.fromOffset(6,6),SortOrder=Enum.SortOrder.LayoutOrder},f)
    local cells,marks={},{}
    for i=1,9 do
        local index=i
        local b=U.button(f,"","secondary",function() if callback then callback(index) end end)
        b.LayoutOrder=i;b.Name="Cell"..i;b.Selectable=callback~=nil
        if not callback then b:SetAttribute("Disabled",true);b.Active=false end
        marks[i]=U.mark(b,"",C.Text);cells[i]=b
    end
    return f,cells,marks
end
return U
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_ATELIER_25_TUTORIAL">
        <Properties>
          <string name="Name">Tutorial</string>
          <ProtectedString name="Source">-- Optional three-move lesson. This module never grants coins, XP, rating or wins.
local L=require(script.Parent.Logic)
local T={}
T.Targets={5,1,9}
T.Replies={2,3}
function T.new() return {Board={"","","","","","","","",""},Step=1,Done=false,Mistake=false} end
function T.move(state,index)
    local out=L.copy(state)
    if out.Done then return out,"DONE" end
    if type(index)~="number" or index~=T.Targets[out.Step] then out.Mistake=true;return out,"TRY_AGAIN" end
    if out.Board[index]~="" then return out,"OCCUPIED" end
    out.Board[index]="X";out.Mistake=false
    local reply=T.Replies[out.Step]
    if reply then out.Board[reply]="O" end
    out.Step=out.Step+1
    if out.Step&gt;3 then out.Done=true;out.Line={1,5,9} end
    return out,out.Done and "COMPLETE" or "NEXT"
end
return T
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_ATELIER_26_0094">
        <Properties>
          <string name="Name">MatchSidebar</string>
          <ProtectedString name="Source">-- Skyline 3.2 · Match sidebar: перерисованное уведомление слева. Статус всегда от сервера.
local Tween=game:GetService("TweenService")
local D=require(script.Parent.DesignSystem)
local U=require(script.Parent.UIComponents)
local V=require(script.Parent.Variants)
local K,F=D.Color,D.Font
local Sidebar={}
Sidebar.__index=Sidebar
local function fit(o,x,y,w,h) o.Position=UDim2.fromOffset(x,y);o.Size=UDim2.fromOffset(w,h) end
function Sidebar.new(parent,tr,turnSeconds)
    local self=setmetatable({Tr=tr,TurnSeconds=turnSeconds or 20},Sidebar)
    self.Root=U.new("Frame",{Name="MatchSidebar",BackgroundTransparency=1,ZIndex=25,Visible=false},parent)
    self.Card=U.new("CanvasGroup",{Name="Status",Size=UDim2.fromScale(1,1),BackgroundColor3=K.Ink,GroupTransparency=0},self.Root)
    U.round(self.Card,16);U.stroke(self.Card,K.Border,.4)
    self.Accent=U.new("Frame",{BackgroundColor3=K.Gold,BorderSizePixel=0},self.Card);U.round(self.Accent,3)
    self.SymbolBox=U.frame(self.Card,K.Raised,12)
    U.stroke(self.SymbolBox,K.Border,.6)
    self.Mark=U.mark(self.SymbolBox,"",K.Gold)
    self.State=U.text(self.Card,"",18,K.Text,F.Strong)
    self.Opponent=U.text(self.Card,"",13,K.Muted,F.Body)
    for _,o in ipairs({self.State,self.Opponent}) do o.TextWrapped=false;o.TextTruncate=Enum.TextTruncate.AtEnd end
    self.Timer=U.text(self.Card,"",26,K.Gold,F.Display);self.Timer.TextXAlignment=Enum.TextXAlignment.Right
    self.Chip=U.frame(self.Card,K.Raised,8)
    self.ChipText=U.text(self.Chip,"",12,K.Gold,F.Strong)
    self.ChipText.TextXAlignment=Enum.TextXAlignment.Center
    self.ChipText.Size=UDim2.fromScale(1,1)
    self.Track=U.frame(self.Card,K.Raised,3)
    self.Fill=U.frame(self.Track,K.Gold,3)
    return self
end
function Sidebar:Layout(x,y,w,h)
    fit(self.Root,x,y,w,92)
    fit(self.Accent,0,14,3,64)
    fit(self.SymbolBox,13,15,42,42)
    fit(self.State,65,13,w-125,25)
    fit(self.Opponent,65,38,w-150,19)
    fit(self.Timer,w-54,14,40,29)
    fit(self.Chip,w-84,46,70,20)
    fit(self.Track,14,74,w-28,5)
    self.State.TextSize=w&lt;250 and 16 or 18
    self.Chip.Visible=w&gt;=224
end
function Sidebar:Animate()
    if self.Tween then self.Tween:Cancel() end
    self.Card.GroupTransparency=0
    if not U.Motion or not self.Root.Visible then return end
    self.Card.GroupTransparency=.55
    self.Tween=Tween:Create(self.Card,TweenInfo.new(.2,Enum.EasingStyle.Quad),{GroupTransparency=0});self.Tween:Play()
end
function Sidebar:SetVisible(value)
    local opening=value and not self.Root.Visible
    self.Root.Visible=value
    if opening then self:Animate() end
end
function Sidebar:Update(data)
    self.Data=data
    self.TurnSeconds=data.TurnSeconds or self.TurnSeconds
    local mine=not data.Finished and data.Turn==data.Symbol
    self.Tone=mine and K.Gold or K.Blue
    self.State.Text=mine and self.Tr("Твой ход","Your turn") or self.Tr("Ход соперника","Their turn")
    self.State.TextColor3=mine and K.Text or K.Muted
    self.Opponent.Text=data.Opponent or ""
    self.Accent.BackgroundColor3=self.Tone
    local variant=data.Variant or "Classic"
    self.ChipText.Text=string.upper(self.Tr(V.name(variant,true),V.name(variant,false)))..(data.Rated and " · R" or "")
    self.Mark:Set(data.Symbol,Color3.new(table.unpack(data.Colors[data.Symbol])),data.Glyphs and data.Glyphs[data.Symbol])
    local key=tostring(data.Id)..":"..tostring(data.Turn)
    if self.Key~=key then self.Key=key;self:Animate() end
    self:Step(workspace:GetServerTimeNow())
end
function Sidebar:Step(now)
    local data=self.Data
    if not data or data.Finished then return end
    local remaining=math.max(0,(data.Deadline or now)-now)
    self.Timer.Text=tostring(math.ceil(remaining))
    local urgent=math.max(2,math.floor(self.TurnSeconds*.34+.5))
    local color=remaining&lt;=urgent and K.Red or self.Tone
    self.Timer.TextColor3=color;self.Fill.BackgroundColor3=color;self.Accent.BackgroundColor3=color
    self.Fill.Size=UDim2.fromScale(math.clamp(remaining/math.max(1,self.TurnSeconds),0,1),1)
    if remaining==0 then self.State.Text=self.Tr("Ожидаем…","Waiting…") end
end
return Sidebar
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_TIDE28_00644">
        <Properties>
          <string name="Name">MatchResult</string>
          <ProtectedString name="Source">-- Tide Journey 2.9. One result card; rewards come ONLY from the server receipt.
local Tween=game:GetService("TweenService")
local D=require(script.Parent.DesignSystem)
local U=require(script.Parent.UIComponents)
local K,F=D.Color,D.Font
local Result={};Result.__index=Result
local function fit(o,x,y,w,h) o.Position=UDim2.fromOffset(x,y);o.Size=UDim2.fromOffset(w,h) end
local function line(parent,x1,y1,x2,y2,color)
    local dx,dy=x2-x1,y2-y1
    local o=U.new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset((x1+x2)/2,(y1+y2)/2),Size=UDim2.fromOffset(math.sqrt(dx*dx+dy*dy),2.5),Rotation=math.deg(math.atan2(dy,dx)),BackgroundColor3=color},parent)
    U.round(o,2)
end
function Result.new(parent,tr,onReplay,onClose)
    local self=setmetatable({Tr=tr},Result)
    self.Root=U.new("CanvasGroup",{Name="DuelResult",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(368,300),BackgroundColor3=K.Ink,ZIndex=30,Visible=false},parent)
    self.Scale=U.new("UIScale",{Scale=1},self.Root)
    U.round(self.Root,18);self.Border=U.stroke(self.Root,K.Gold,.55)
    self.Icon=U.frame(self.Root,K.GoldSoft,12);fit(self.Icon,20,20,48,48)
    self.Art={}
    for _,key in ipairs({"Win","Draw","Loss"}) do self.Art[key]=U.new("Frame",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Visible=false},self.Icon) end
    for _,s in ipairs({{14,11,34,11},{14,11,16,25},{16,25,24,30},{24,30,32,25},{32,25,34,11},{14,14,8,14},{8,14,9,23},{9,23,17,25},{34,14,40,14},{40,14,39,23},{39,23,31,25},{24,30,24,37},{17,39,31,39}}) do line(self.Art.Win,s[1],s[2],s[3],s[4],K.Gold) end
    line(self.Art.Draw,13,19,35,19,K.Blue);line(self.Art.Draw,13,29,35,29,K.Blue)
    line(self.Art.Loss,12,30,34,15,K.Red);line(self.Art.Loss,23,15,34,15,K.Red);line(self.Art.Loss,34,15,34,26,K.Red)
    self.Title=U.text(self.Root,"",28,K.Text,F.Display)
    self.Sub=U.text(self.Root,"",12,K.Muted,F.Body)
    self.Sub.TextWrapped=false;self.Sub.TextTruncate=Enum.TextTruncate.AtEnd
    self.Reward=U.frame(self.Root,K.Surface,10)
    self.RewardText=U.text(self.Reward,"",18,K.Text,F.Strong)
    self.RewardText.TextXAlignment=Enum.TextXAlignment.Center
    self.RewardText.Position=UDim2.fromOffset(8,0);self.RewardText.Size=UDim2.new(1,-16,1,0)
    self.Detail=U.text(self.Root,"",12,K.Muted,F.Body)
    self.Detail.TextXAlignment=Enum.TextXAlignment.Center
    self.Primary=U.button(self.Root,"","primary",onReplay)
    self.Close=U.button(self.Root,tr("Закрыть","Close"),"secondary",onClose)
    self.Foot=U.text(self.Root,tr("Подробности в истории матчей","Details in match history"),10,K.Muted,F.Body)
    self.Foot.TextXAlignment=Enum.TextXAlignment.Center
    return self
end
function Result:Layout(vp)
    local w=math.min(368,math.max(260,vp.X-24))
    self.Root.Size=UDim2.fromOffset(w,300)
    self.Root.Position=UDim2.new(.5,0,.5,vp.Y&gt;=500 and -22 or 0)
    self.Scale.Scale=math.min(1,(vp.Y-24)/300,(vp.X-24)/w)
    fit(self.Title,82,18,w-102,35);fit(self.Sub,83,54,w-103,18)
    fit(self.Reward,20,88,w-40,52)
    fit(self.Detail,22,149,w-44,43)
    fit(self.Primary,20,205,(w-48)*.58,44)
    fit(self.Close,28+(w-48)*.58,205,(w-48)*.42,44)
    fit(self.Foot,20,263,w-40,18)
end
function Result:SetVisible(value)
    local opening=value and not self.Root.Visible
    self.Root.Visible=value
    if opening then
        if self.Tween then self.Tween:Cancel() end
        self.Root.GroupTransparency=U.Motion and .65 or 0
        if U.Motion then self.Tween=Tween:Create(self.Root,TweenInfo.new(.22),{GroupTransparency=0});self.Tween:Play() end
    end
end
function Result:Update(data,receipt,failed,pending,summary,reason)
    if not data.Finished then return end
    local tr=self.Tr
    local win=data.Result==data.Symbol
    local draw=data.Result=="DRAW"
    local key=win and "Win" or (draw and "Draw" or "Loss")
    local accent=win and K.Gold or (draw and K.Blue or K.Red)
    self.Border.Color=accent
    for k,o in pairs(self.Art) do o.Visible=k==key end
    self.Icon.BackgroundColor3=win and K.GoldSoft or K.Raised
    self.Title.Text=win and tr("Победа","Victory") or (draw and tr("Ничья","Draw") or tr("Поражение","Defeat"))
    self.Sub.Text=(data.Opponent or "").."  ·  "..tr("Арена ","Court ")..string.format("%02d",data.Arena)
    self.RewardText.Text=failed and tr("Сохранение не подтверждено","Save not confirmed") or (receipt and summary or tr("Подводим итоги…","Wrapping up…"))
    self.RewardText.TextSize=failed and 14 or 18
    self.RewardText.TextColor3=failed and K.Red or K.Text
    self.Detail.Text=failed and tr("Награда не показана как полученная. Проверь историю матчей.","Reward not shown as received. Check match history.") or (receipt and reason or tr("Ждём подтверждение сервера","Waiting for server confirmation"))
    self.Foot.Text=(receipt and not failed and (receipt.PassXP or 0)&gt;0) and ("+"..receipt.PassXP.." BP XP"..(receipt.FirstMatch and tr(" · первый матч дня"," · first match today") or tr(" · Батл Пасс"," · Battle Pass"))) or tr("Подробности в истории матчей","Details in match history")
    self.Foot.TextSize=11
    self.Foot.TextColor3=(receipt and (receipt.PassXP or 0)&gt;0) and K.Sage or K.Muted
    self.Primary.Text=pending and tr("Следующий матч…","Next match…") or tr("Ещё матч","Play again")
    U.disabled(self.Primary,pending)
end
return Result
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_TIDE29_PROGRESSION">
        <Properties>
          <string name="Name">Progression</string>
          <ProtectedString name="Source">-- Skyline 2.9: pure profile mutations. Only Main / MatchRewards grant rewards.
local shared=game:GetService("ReplicatedStorage"):WaitForChild("SkylineShared")
local C=require(shared.Config)
local L=require(shared.Logic)
local G={}
local function integer(v,default)
    if type(v)~="number" or v~=v or v==math.huge or v==-math.huge then return default or 0 end
    return math.floor(v)
end
function G.ensure(d)
    if type(d.Journeys)~="table" then d.Journeys={} end
    local key=C.BattlePass.Key
    if type(d.Journeys[key])~="table" then d.Journeys[key]={} end
    local b=d.Journeys[key]
    b.XP=math.clamp(integer(b.XP),0,100000000)
    for _,k in ipairs({"Free","Premium"}) do if type(b[k])~="table" then b[k]={} end end
    b.MasteryClaims=math.max(0,integer(b.MasteryClaims))
    b.FirstMatchDay=integer(b.FirstMatchDay,-1)
    if type(d.Weekly)~="table" then d.Weekly={} end
    local w=d.Weekly;w.Week=integer(w.Week,-1)
    if type(w.Progress)~="table" then w.Progress={} end
    if type(w.Claims)~="table" then w.Claims={} end
    for _,k in ipairs({"Games","Wins","Moves"}) do w.Progress[k]=math.max(0,integer(w.Progress[k])) end
    if type(d.Club)~="table" then d.Club={} end
    d.Club.Welcome=d.Club.Welcome==true
    d.Club.LastDaily=integer(d.Club.LastDaily,-1)
    if not C.Club.Trails[d.Club.Trail] then d.Club.Trail="Gold" end
    return b,w
end
function G.week(day) return math.floor((day+3)/7) end -- Monday 00:00 UTC
function G.weekly(d,day)
    local b,w=G.ensure(d);local week=G.week(day)
    if w.Week~=week then w.Week=week;w.Progress={Games=0,Wins=0,Moves=0};w.Claims={} end
    return b,w
end
function G.level(xp) return math.clamp(math.floor(xp/C.BattlePass.XPPerTier),0,C.BattlePass.Tiers) end
function G.addXP(d,amount)
    local b=G.ensure(d);b.XP=math.min(100000000,b.XP+math.max(0,integer(amount)))
end
function G.match(d,day,win,moves)
    local b,w=G.weekly(d,day)
    local xp=C.BattlePass.MatchXP+(win and C.BattlePass.WinXP or 0)
    local first=b.FirstMatchDay~=day
    if first then b.FirstMatchDay=day;xp=xp+C.BattlePass.FirstMatchXP end
    G.addXP(d,xp)
    w.Progress.Games=w.Progress.Games+1;w.Progress.Moves=w.Progress.Moves+moves
    if win then w.Progress.Wins=w.Progress.Wins+1 end
    return xp,first
end
local function grant(d,r)
    if r.Coins then d.Coins=d.Coins+r.Coins end
    if r.Skin then d.Owned[r.Skin]=true end
end
function G.claimPass(d,tier,track,premium)
    local b=G.ensure(d)
    if type(tier)~="number" or tier~=tier or tier%1~=0 or tier&lt;1 or tier&gt;C.BattlePass.Tiers then return "INVALID" end
    if track~="Free" and track~="Premium" then return "INVALID" end
    if track=="Premium" and not premium then return "LOCKED" end
    local key=tostring(tier)
    if b[track][key] then return "CLAIMED" end
    if G.level(b.XP)&lt;tier then return "NOT_READY" end
    local reward=C.BattlePass.Rewards[tier][track]
    grant(d,reward);b[track][key]=true
    return "OK"
end
function G.claimAll(d,premium)
    local b=G.ensure(d);local count=0
    for tier=1,G.level(b.XP) do
        for _,track in ipairs({"Free","Premium"}) do
            if G.claimPass(d,tier,track,premium)=="OK" then count=count+1 end
        end
    end
    return count
end
function G.claimWeekly(d,day,key)
    local _,w=G.weekly(d,day);local q=C.WeeklyQuests[key]
    if not q then return "INVALID" end
    if w.Claims[key] then return "CLAIMED" end
    if w.Progress[q.Field]&lt;q.Goal then return "NOT_READY" end
    w.Claims[key]=true;d.Coins=d.Coins+q.Coins;G.addXP(d,q.PassXP)
    return "OK"
end
function G.claimClub(d,day,kind,club)
    if not club then return "LOCKED" end
    local b=G.ensure(d)
    if kind=="Welcome" then
        if d.Club.Welcome then return "CLAIMED" end
        d.Club.Welcome=true;d.Coins=d.Coins+C.Club.WelcomeCoins
    elseif kind=="Daily" then
        if d.Club.LastDaily&gt;=day then return "CLAIMED" end
        if b.FirstMatchDay~=day then return "NOT_READY" end
        d.Club.LastDaily=day;d.Coins=d.Coins+C.Club.DailyCoins
    else return "INVALID" end
    return "OK"
end
function G.claimMastery(d)
    local b=G.ensure(d)
    local extra=math.max(0,b.XP-C.BattlePass.Tiers*C.BattlePass.XPPerTier)
    local earned=math.floor(extra/C.BattlePass.MasteryXP)
    local count=earned-b.MasteryClaims
    if count&lt;=0 then return "NOT_READY" end
    d.Coins=d.Coins+count*C.BattlePass.MasteryCoins;b.MasteryClaims=earned
    return "OK"
end
function G.snapshot(d)
    -- Read-only from the caller's point of view, no mutation of the live profile cache.
    local copy={Journeys=L.copy(d.Journeys),Weekly=L.copy(d.Weekly),Club=L.copy(d.Club)}
    local b,w=G.ensure(copy)
    return {Pass=L.copy(b),Weekly=L.copy(w),Club=L.copy(copy.Club)}
end
return G
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_TIDE29_JOURNEYUI">
        <Properties>
          <string name="Name">JourneyUI</string>
          <ProtectedString name="Source">-- Presentation only. Every claim is a request to the authoritative server.
local shared=script.Parent
local C=require(shared.Config)
local G=require(shared.Progression)
local D=require(shared.DesignSystem)
local U=require(shared.UIComponents)
local K,F=D.Color,D.Font
local J={}
local function rewardName(ctx,r)
    if r.Skin then return ctx.localized(C.Skins[r.Skin]) end
    return ctx.number(r.Coins)..ctx.tr(" монет"," coins")
end
function J.Weekly(ctx)
    local p=ctx.profile();local tr,T=ctx.tr,ctx.T
    local w=p.Progression.Weekly;local today=math.floor(workspace:GetServerTimeNow()/86400)
    local current=w.Week==G.week(today)
    ctx.note(tr("НЕДЕЛЬНЫЕ ЦЕЛИ","WEEKLY GOALS"),30,K.Gold)
    for _,key in ipairs(C.WeeklyOrder) do
        local q=C.WeeklyQuests[key];local progress=current and (w.Progress[q.Field] or 0) or 0
        local done=current and w.Claims[key];local ready=progress&gt;=q.Goal and not done
        local f=ctx.section(148)
        T(f,ctx.localized(q),17,K.Text,F.Strong,16,10,-32,29)
        T(f,math.min(progress,q.Goal).." / "..q.Goal.." · +"..q.Coins..tr(" мон."," coins").." · +"..q.PassXP.." BP XP",12,K.Muted,F.Body,16,42,-32,30)
        ctx.progressBar(f,16,78,progress/q.Goal)
        local questKey=key
        local b=ctx.buttonAt(f,done and tr("Получено","Claimed") or (ready and tr("Забрать награду","Claim reward") or tr("В процессе","In progress")),ready and "primary" or "secondary",function() ctx.send("Weekly",{Key=questKey}) end,16,94,-32,40)
        U.disabled(b,not ready)
    end
    ctx.note(tr("Неделя начинается в понедельник, 00:00 UTC. Засчитываются только матчи, прошедшие проверку наград.","Weeks start Monday, 00:00 UTC. Only reward-eligible matches count."),62)
end
function J.Pass(ctx)
    local tr,T=ctx.tr,ctx.T
    ctx.eyebrow.Text="TIDE JOURNEY   /   01"
    ctx.heading.Text=tr("Батл Пасс · Прилив","Battle Pass · Tide")
    ctx.subheading.Text=tr("30 уровней. Без таймера и сброса прогресса.","30 tiers. No deadline. No progress reset.")
    local p=ctx.profile();if not p then ctx.note(tr("Загрузка профиля…","Loading profile…"));return end
    local b=p.Progression.Pass;local level=G.level(b.XP);local maxXP=C.BattlePass.Tiers*C.BattlePass.XPPerTier
    local narrow=ctx.visibleWidth()&lt;520
    local hero=ctx.section(210,K.GoldSoft)
    T(hero,tr("ТВОЯ КОЛЛЕКЦИЯ ПРИКЛЮЧЕНИЙ","YOUR JOURNEY COLLECTION"),11,K.Gold,F.Strong,18,14,-36,22)
    T(hero,tr("Уровень ","Tier ")..level.." / "..C.BattlePass.Tiers,28,K.Text,F.Display,18,42,-36,42)
    T(hero,level&lt;30 and (ctx.number(b.XP%C.BattlePass.XPPerTier).." / "..C.BattlePass.XPPerTier..tr(" XP до следующего уровня"," XP toward next tier")) or tr("Все уровни открыты. Продолжай ради мастерства.","All tiers unlocked. Keep playing for mastery rewards."),13,K.Muted,F.Body,18,89,-36,40)
    ctx.progressBar(hero,18,140,level&lt;30 and (b.XP%C.BattlePass.XPPerTier)/C.BattlePass.XPPerTier or 1)
    local readyCount=0
    for tier=1,level do
        if not b.Free[tostring(tier)] then readyCount=readyCount+1 end
        if p.Premium and not b.Premium[tostring(tier)] then readyCount=readyCount+1 end
    end
    local claim=ctx.buttonAt(hero,readyCount&gt;0 and tr("Забрать доступное · ","Claim available · ")..readyCount or tr("Играй, чтобы открыть награды","Play to unlock rewards"),readyCount&gt;0 and "primary" or "secondary",function() ctx.send("PassClaim",{All=true}) end,18,158,-36,40)
    U.disabled(claim,readyCount==0)
    local info=ctx.section(narrow and 180 or 152)
    T(info,p.Premium and tr("Premium активен","Premium active") or tr("Больше наград с Premium","More rewards with Premium"),21,K.Gold,F.Display,16,10,-32,32)
    T(info,tr("Бесплатная дорожка доступна всем. Premium входит в Skyline Club или покупается отдельно. Уже открытые уровни сохраняются.","The free track is for everyone. Premium is included with Club or sold separately. Already unlocked tiers are kept."),13,K.Muted,F.Body,16,48,-32,narrow and 70 or 46)
    local y=narrow and 126 or 98
    if p.Premium then
        local done=ctx.buttonAt(info,tr("Премиальные награды доступны ниже","Premium rewards available below"),"secondary",function() end,16,y,-32,40);U.disabled(done,true)
    elseif C.PassIds.BattlePass&gt;0 then
        local buy=ctx.buttonAt(info,"…","primary",function() ctx.purchase(C.PassIds.BattlePass,"PASS") end,16,y,-32,40)
        ctx.priceButton(buy,C.PassIds.BattlePass,"PASS",tr("Premium · ","Premium · "))
    else
        local off=ctx.buttonAt(info,tr("Продажа Premium не подключена","Premium sales are not configured"),"secondary",function() end,16,y,-32,40);U.disabled(off,true)
    end
    ctx.note(tr("За матч: +35 BP XP, за победу ещё +15. Первый зачтённый матч дня: +100. Ежедневные задания: +100 каждое. Недельные цели: до +1300.","Match: +35 BP XP; win: +15 extra. First eligible match each day: +100. Daily quests: +100 each. Weekly goals: up to +1300."),narrow and 100 or 64)
    local shortcuts=ctx.section(44,K.Surface,true)
    ctx.buttonAt(shortcuts,tr("Открыть задания и ежедневные награды","Open quests and daily rewards"),"secondary",function() ctx.openPage("Quests") end,0,0,0,42)
    for tier=1,C.BattlePass.Tiers do
        local thisTier=tier;local unlocked=level&gt;=tier
        local row=ctx.section(narrow and 282 or 164)
        T(row,string.format("%02d",tier).."  ·  "..(unlocked and tr("Открыт","Unlocked") or ctx.number(tier*C.BattlePass.XPPerTier).." BP XP"),12,unlocked and K.Gold or K.Muted,F.Strong,14,8,-28,22)
        for i,track in ipairs({"Free","Premium"}) do
            local trackKey=track;local premiumTrack=track=="Premium";local r=C.BattlePass.Rewards[tier][track]
            local done=b[track][tostring(tier)]==true;local owned=not premiumTrack or p.Premium
            local ready=unlocked and owned and not done
            local box=U.frame(row,premiumTrack and K.GoldSoft or K.Raised,10)
            box.Position=narrow and UDim2.fromOffset(12,36+(i-1)*120) or UDim2.new((i-1)*.5,12,0,36)
            box.Size=narrow and UDim2.new(1,-24,0,112) or UDim2.new(.5,-18,0,116)
            local badge=U.icon(box,r.Skin and "Shop" or "Coin",premiumTrack and K.Gold or K.Sage);badge.Position=UDim2.fromOffset(12,12)
            T(box,premiumTrack and "PREMIUM" or tr("БЕСПЛАТНО","FREE"),10,premiumTrack and K.Gold or K.Sage,F.Strong,44,9,-56,18)
            local title=T(box,rewardName(ctx,r),15,K.Text,F.Strong,44,29,-56,32)
            if r.Skin then
                local colors=C.Skins[r.Skin]
                for j,sign in ipairs({"X","O"}) do
                    local chip=U.frame(box,Color3.fromRGB(table.unpack(colors[sign])),4)
                    chip.Size=UDim2.fromOffset(12,5);chip.Position=UDim2.fromOffset(12+(j-1)*15,42)
                end
            end
            local label=done and tr("Получено","Claimed") or (not owned and tr("Нужен Premium","Requires Premium") or (ready and tr("Забрать","Claim") or tr("Закрыто","Locked")))
            local button=ctx.buttonAt(box,label,ready and "primary" or "secondary",function() ctx.send("PassClaim",{Tier=thisTier,Track=trackKey}) end,12,68,-24,36)
            U.disabled(button,not ready)
        end
    end
    if level&gt;=C.BattlePass.Tiers then
        local f=ctx.section(150)
        T(f,tr("Мастерство после финала","Beyond the final tier"),19,K.Text,F.Display,16,8,-32,36)
        local extra=math.max(0,b.XP-maxXP);local available=math.floor(extra/C.BattlePass.MasteryXP)-b.MasteryClaims
        T(f,tr("Каждые 1000 BP XP: ещё 100 монет. ","Every 1,000 BP XP: 100 more coins. ")..(extra%C.BattlePass.MasteryXP).." / 1000",13,K.Muted,F.Body,16,45,-32,48)
        local button=ctx.buttonAt(f,tr("Забрать награду мастерства","Claim mastery reward"),available&gt;0 and "primary" or "secondary",function() ctx.send("Mastery") end,16,100,-32,40);U.disabled(button,available&lt;=0)
    end
end
function J.Club(ctx)
    local tr,T=ctx.tr,ctx.T
    ctx.eyebrow.Text="SKYLINE   /   MEMBERSHIP"
    ctx.heading.Text="Skyline Club"
    ctx.subheading.Text=tr("Твой стиль. Твоя коллекция. Честные дуэли.","Your style. Your collection. Fair duels.")
    local p=ctx.profile();if not p then ctx.note(tr("Загрузка профиля…","Loading profile…"));return end
    local narrow=ctx.visibleWidth()&lt;520
    local hero=ctx.section(narrow and 210 or 178,K.GoldSoft)
    T(hero,p.VIP and tr("ДОБРО ПОЖАЛОВАТЬ В CLUB","WELCOME TO THE CLUB") or tr("ОДНА ПОКУПКА · БЕЗ ПОДПИСКИ","ONE PURCHASE · NO SUBSCRIPTION"),11,K.Gold,F.Strong,18,14,-36,30)
    T(hero,tr("Больше, чем золотой след","More than a golden trail"),26,K.Text,F.Display,18,49,-36,narrow and 62 or 40)
    T(hero,tr("Три клубные палитры, три цвета следа, Premium «Прилив», 400 монет при вступлении и 75 за игровой день.","Three Club palettes, three trail colors, Tide Premium, 400 welcome coins and 75 per active day."),14,K.Text,F.Body,18,narrow and 115 or 94,-36,78)
    local c=ctx.section(52,K.Surface,true)
    if p.VIP then
        local b=ctx.buttonAt(c,tr("Членство активно","Membership active"),"secondary",function() end,0,2,0,46);U.disabled(b,true)
    elseif C.PassIds.VIP&gt;0 then
        local b=ctx.buttonAt(c,"…","primary",function() ctx.purchase(C.PassIds.VIP,"PASS") end,0,2,0,46);ctx.priceButton(b,C.PassIds.VIP,"PASS",tr("Вступить · ","Join · "))
    else
        local b=ctx.buttonAt(c,tr("Продажа Club не подключена","Club sales are not configured"),"secondary",function() end,0,2,0,46);U.disabled(b,true)
    end
    if p.Premium and not p.VIP then ctx.note(tr("Premium у тебя уже есть. Club добавит клубные стили и подарки, но не вторую дорожку наград.","You already own Premium. Club adds Club styles and gifts, not a second reward track."),68) end
    for _,key in ipairs(C.Club.PaletteOrder) do
        local skin=C.Skins[key];local paletteKey=key;local f=ctx.section(104)
        for i,sign in ipairs({"X","O"}) do
            local chip=U.frame(f,Color3.fromRGB(table.unpack(skin[sign])),8)
            chip.Position=UDim2.fromOffset(14+(i-1)*34,14);chip.Size=UDim2.fromOffset(26,26)
        end
        T(f,ctx.localized(skin),16,K.Text,F.Strong,90,10,-104,38)
        local b=ctx.buttonAt(f,p.VIP and tr("Посмотреть и выбрать","Preview and equip") or tr("Клубная палитра","Club palette"),"secondary",function() ctx.selectSkin(paletteKey);ctx.openPage("Shop") end,14,56,-28,36)
        U.disabled(b,not p.VIP)
    end
    local trails=ctx.section(narrow and 146 or 104)
    T(trails,tr("След персонажа","Character trail"),18,K.Text,F.Display,14,8,-28,30)
    local cols=narrow and 2 or 4
    for i,key in ipairs(C.Club.TrailOrder) do
        local trailKey=key;local chosen=p.Progression.Club.Trail==key
        local b=U.button(trails,(chosen and "✓ " or "")..ctx.localized(C.Club.Trails[key]),chosen and "primary" or "secondary",function() ctx.send("ClubTrail",{Key=trailKey}) end)
        b.Position=UDim2.new(((i-1)%cols)/cols,12,0,48+math.floor((i-1)/cols)*44);b.Size=UDim2.new(1/cols,-18,0,36);U.disabled(b,not p.VIP)
    end
    local today=math.floor(workspace:GetServerTimeNow()/86400)
    local gifts={{Key="Welcome",Title=tr("Подарок за вступление","Welcome gift"),Coins=C.Club.WelcomeCoins,Done=p.Progression.Club.Welcome,Ready=p.VIP},
        {Key="Daily",Title=tr("Подарок за игровой день","Active-day gift"),Coins=C.Club.DailyCoins,Done=p.Progression.Club.LastDaily&gt;=today,Ready=p.VIP and p.Progression.Pass.FirstMatchDay==today}}
    for _,gift in ipairs(gifts) do
        local f=ctx.section(116);local key=gift.Key;local ready=gift.Ready and not gift.Done
        T(f,gift.Title.." · +"..gift.Coins,17,K.Text,F.Strong,14,8,-28,38)
        local b=ctx.buttonAt(f,gift.Done and tr("Получено","Claimed") or (ready and tr("Забрать монеты","Claim coins") or (not p.VIP and tr("Для участников Club","Club members only") or tr("Заверши один матч сегодня","Complete one match today"))),ready and "primary" or "secondary",function() ctx.send("ClubClaim",{Key=key}) end,14,58,-28,42);U.disabled(b,not ready)
    end
    local pass=ctx.section(48,K.Surface,true)
    ctx.buttonAt(pass,tr("Открыть Батл Пасс","Open Battle Pass"),"secondary",function() ctx.openPage("Pass") end,0,0,0,44)
    ctx.note(tr("Монеты тратятся только на оформление. Club не меняет рейтинг, силу бота или время хода. Доступ к аренам остаётся бесплатным.","Coins are for cosmetics only. Club does not change rating, bot strength or turn time. Arenas remain free."),narrow and 100 or 66)
end
return J
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX90001">
        <Properties>
          <string name="Name">Audio</string>
          <ProtectedString name="Source">-- Skyline 3.0 · Audio: один пул переиспользуемых Sound вместо Instance.new на каждый клик.
-- Используются только встроенные rbxasset-звуки: сторонние ассеты не нужны.
local SoundService = game:GetService("SoundService")

local A = {}

A.Library = {
    Click    = {Id="rbxasset://sounds/clickfast.wav",            Volume=.085, Speed=1},
    Move     = {Id="rbxasset://sounds/switch3.wav",              Volume=.110, Speed=1},
    Opponent = {Id="rbxasset://sounds/switch3.wav",              Volume=.100, Speed=.82},
    Win      = {Id="rbxasset://sounds/electronicpingshort.wav",  Volume=.160, Speed=1.35},
    Lose     = {Id="rbxasset://sounds/electronicpingshort.wav",  Volume=.130, Speed=.72},
    Draw     = {Id="rbxasset://sounds/electronicpingshort.wav",  Volume=.120, Speed=.95},
    Reward   = {Id="rbxasset://sounds/bass.wav",                 Volume=.130, Speed=1.1},
    Error    = {Id="rbxasset://sounds/switch3.wav",              Volume=.100, Speed=.6},
    Fade     = {Id="rbxasset://sounds/switch3.wav",              Volume=.090, Speed=1.4},
}

local enabled = true
local pool = {}

function A.setEnabled(value)
    enabled = value ~= false
end

function A.enabled()
    return enabled
end

function A.play(key, pitch)
    if not enabled then return end
    local def = A.Library[key] or A.Library.Click
    local sound = pool[key]
    if not sound or not sound.Parent then
        sound = Instance.new("Sound")
        sound.Name = "SkylineSfx_" .. tostring(key)
        sound.SoundId = def.Id
        sound.Volume = def.Volume
        sound.Parent = SoundService
        pool[key] = sound
    end
    sound.PlaybackSpeed = (pitch or 1) * (def.Speed or 1)
    sound.TimePosition = 0
    sound:Play()
end

return A
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX90002">
        <Properties>
          <string name="Name">Variants</string>
          <ProtectedString name="Source">-- Skyline 3.2 · Variants: варианты правил. Сервер всегда валидирует ключ через V.valid.
local V = {}

V.Order = {"Classic", "Blitz", "Shift"}

V.Rules = {
    Classic = {
        TurnSeconds = 20, RewardMult = 1, MaxMarks = 0,
        RU = "Классика", EN = "Classic",
        DescRU = "Канонические правила: 20 секунд на ход.",
        DescEN = "Canonical rules: 20 seconds per move.",
    },
    Blitz = {
        TurnSeconds = 5, RewardMult = 1.2, MaxMarks = 0,
        RU = "Блиц", EN = "Blitz",
        DescRU = "5 секунд на ход и +20% к награде.",
        DescEN = "5 seconds per move and +20% rewards.",
    },
    Shift = {
        TurnSeconds = 16, RewardMult = 1.25, MaxMarks = 3,
        RU = "Смыв", EN = "Shift",
        DescRU = "У тебя не больше трёх знаков: старейший исчезает. +25% к награде.",
        DescEN = "You keep three marks at most: the oldest fades. +25% rewards.",
    },
}

-- 3.5.0: режим дня — детерминированный выбор по UTC-дню, одинаковый на сервере и клиенте.
function V.featured(day)
    day = tonumber(day) or 0
    return V.Order[(math.floor(day) % #V.Order) + 1]
end

function V.valid(key)
    return type(key) == "string" and V.Rules[key] ~= nil
end

function V.get(key)
    return V.Rules[V.valid(key) and key or "Classic"]
end

function V.name(key, ru)
    local rules = V.get(key)
    return ru and rules.RU or rules.EN
end

function V.describe(key, ru)
    local rules = V.get(key)
    return ru and rules.DescRU or rules.DescEN
end

return V
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX91002">
        <Properties>
          <string name="Name">Glyphs</string>
          <ProtectedString name="Source">-- Skyline 3.1 · Glyphs: геометрия значков. Один источник правды для UI и для мира.
-- Каждый значок описан отрезками в квадрате 0..1, поэтому одна форма рисуется
-- и рамками в интерфейсе, и деталями на арене без дублирования данных.
local G = {}

local function poly(points)
    local segments = {}
    for i = 1, #points do
        local a = points[i]
        local b = points[(i % #points) + 1]
        segments[#segments + 1] = {a[1], a[2], b[1], b[2]}
    end
    return segments
end

local function ring(sides, radius)
    local points = {}
    for i = 0, sides - 1 do
        local angle = math.pi * 2 * i / sides - math.pi / 2
        points[#points + 1] = {.5 + math.cos(angle) * radius, .5 + math.sin(angle) * radius}
    end
    return points
end

G.Kinds = {
    cross = {Segments = {{.08, .08, .92, .92}, {.92, .08, .08, .92}}, Thickness = .15},
    ring = {Round = true, Thickness = .14},
    square = {Segments = poly({{.11, .11}, {.89, .11}, {.89, .89}, {.11, .89}}), Thickness = .14},
    triangle = {Segments = poly({{.5, .07}, {.93, .87}, {.07, .87}}), Thickness = .14},
    diamond = {Segments = poly({{.5, .05}, {.95, .5}, {.5, .95}, {.05, .5}}), Thickness = .14},
    plus = {Segments = {{.5, .05, .5, .95}, {.05, .5, .95, .5}}, Thickness = .16},
    star = {Segments = {{.5, .03, .5, .97}, {.09, .26, .91, .74}, {.09, .74, .91, .26}}, Thickness = .13},
    hex = {Segments = poly(ring(6, .46)), Thickness = .13},
}

G.Order = {"cross", "ring", "square", "triangle", "diamond", "plus", "star", "hex"}

function G.valid(kind)
    return type(kind) == "string" and G.Kinds[kind] ~= nil
end

function G.fallback(symbol)
    return symbol == "O" and "ring" or "cross"
end

function G.get(kind)
    return G.Kinds[G.valid(kind) and kind or "cross"]
end

-- Набор значков задан в Config (C.Shapes). Здесь только геометрия, без цен.
function G.kind(shapeSet, symbol)
    local kind = shapeSet and shapeSet[symbol]
    return G.valid(kind) and kind or G.fallback(symbol)
end

return G
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXD59BC56975D04F9C9EE0F0B34E506A74">
        <Properties>
          <string name="Name">HUDState34</string>
          <ProtectedString name="Source">-- Pure presentation calculations. Eligibility and currency remain server-owned.
local C=require(script.Parent.Config)
local G=require(script.Parent.Progression)
local M={}
function M.daily(profile,now)
    local today=math.floor(now/86400)
    local claimed=profile~=nil and (profile.LastDaily or 0)&gt;=today
    local streak=profile and profile.DailyStreak or 0
    local day=claimed and streak or (profile and profile.LastDaily==today-1 and streak%7+1 or 1)
    day=math.clamp(day,1,7)
    return {Day=day,Claimed=claimed,Amount=C.DailyCoins[day],Seconds=math.max(0,math.ceil((today+1)*86400-now)),Today=today}
end
function M.ready(profile,now)
    if not profile then return 0,0 end
    local daily=M.daily(profile,now)
    local rewards=daily.Claimed and 0 or 1
    for _,key in ipairs(C.QuestOrder) do
        local q=C.Quests[key]
        if profile.QuestDay==daily.Today and not profile.QuestClaims[key] and (profile.QuestProgress[q.Field] or 0)&gt;=q.Goal then rewards=rewards+1 end
    end
    local pass=profile.Progression and profile.Progression.Pass
    local count=0
    if pass then
        for i=1,G.level(pass.XP) do
            if not pass.Free[tostring(i)] then count=count+1 end
            if profile.Premium and not pass.Premium[tostring(i)] then count=count+1 end
        end
    end
    return rewards,count
end
function M.clock(seconds)
    seconds=math.max(0,math.ceil(seconds))
    return string.format('%02d:%02d:%02d',math.floor(seconds/3600),math.floor(seconds/60)%60,seconds%60)
end
return M
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0B55E16FEE4C42F2949D7311B6DBC81F">
        <Properties>
          <string name="Name">HudShell34</string>
          <ProtectedString name="Source">-- Courtyard edition: restrained, responsive HUD. No world-space labels.
local Tween=game:GetService("TweenService")
local Players=game:GetService("Players")
local U=require(script.Parent.UIComponents)
local D=require(script.Parent.DesignSystem)
local State=require(script.Parent.HUDState34)
local K,F=D.Color,D.Font
local M={}
local function fit(o,x,y,w,h) o.Position=UDim2.fromOffset(x,y);o.Size=UDim2.fromOffset(w,h) end
local function count(n)
    return (tostring(math.max(0,math.floor(n or 0))):reverse():gsub("(%d%d%d)","%1 "):reverse():gsub("^ ",""))
end
function M.new(gui,tr,actions)
    local self={ClaimUntil=0}
    local wallet=U.frame(gui,K.Ink,10);wallet.Name="PlayerOverview";wallet.ZIndex=10
    wallet.AnchorPoint=Vector2.new(1,0);U.stroke(wallet,K.Border,.4)
    local profileButton=U.button(wallet,"","secondary",function() actions.Open("Profile") end)
    local level=U.text(profileButton,"01",18,K.Gold,F.Strong);level.Size=UDim2.fromScale(1,1);level.TextXAlignment=Enum.TextXAlignment.Center
    local name=U.text(wallet,Players.LocalPlayer.DisplayName,13,K.Text,F.Strong)
    name.TextWrapped=false;name.TextTruncate=Enum.TextTruncate.AtEnd
    local rank=U.text(wallet,"",11,K.Muted)
    local money=U.text(wallet,"…",21,K.Text,F.Strong)
    local coin=U.icon(wallet,"Coin",K.Gold)
    local track=U.frame(wallet,K.Raised,2)
    local fill=U.frame(track,K.Gold,2);fill.Size=UDim2.fromScale(0,1)
    local daily=U.frame(gui,K.Ink,10);daily.Name="DailyReward";daily.ZIndex=10;daily.AnchorPoint=Vector2.new(1,0)
    U.stroke(daily,K.Border,.5)
    local dailyTitle=U.text(daily,"",13,K.Text,F.Strong)
    local dailySub=U.text(daily,"",11,K.Muted)
    local claim=U.button(daily,"","primary",function()
        if not self.Profile or os.clock()&lt;self.ClaimUntil then return end
        if State.daily(self.Profile,workspace:GetServerTimeNow()).Claimed then actions.Open("Quests");return end
        self.ClaimUntil=os.clock()+3;actions.Daily();self:Step()
    end)
    local rush=U.frame(gui,K.Ink,10);rush.Name="CourtyardProgress";rush.ZIndex=18;U.stroke(rush,K.Border,.4)
    rush.AnchorPoint=Vector2.new(.5,0);rush.Visible=false
    local rushTitle=U.text(rush,tr("МАРШРУТ В САДУ","GARDEN CIRCUIT"),11,K.Gold,F.Strong)
    local rushDetail=U.text(rush,"",17,K.Text,F.Strong)
    local timer=U.text(rush,"",24,K.Text,F.Display);timer.TextXAlignment=Enum.TextXAlignment.Right
    local rushTrack=U.frame(rush,K.Raised,2)
    local rushFill=U.frame(rushTrack,K.Gold,2)
    self.Wallet=wallet
    function self:Update(profile,sound)
        self.Profile=profile;self.Sound=sound
        if profile then
            local lv=profile.Level or 1
            level.Text=string.format("%02d",lv)
            rank.Text=count(profile.Rating)..tr(" рейтинга"," rating")
            money.Text=count(profile.Coins)
            local base=80*(lv-1)^2;local nextXP=80*lv^2
            local size=UDim2.fromScale(math.clamp((profile.XP-base)/(nextXP-base),0,1),1)
            if self.FillTween then self.FillTween:Cancel() end
            if U.Motion then self.FillTween=Tween:Create(fill,TweenInfo.new(.25),{Size=size});self.FillTween:Play() else fill.Size=size end
        end
        self:Step()
    end
    function self:Step()
        local status=State.daily(self.Profile,workspace:GetServerTimeNow())
        dailyTitle.Text=status.Claimed and tr("Награда получена","Reward claimed") or tr("Ежедневный подарок","Daily gift")
        dailySub.Text=status.Claimed and State.clock(status.Seconds) or (tr("День ","Day ")..status.Day.." / 7")
        local busy=os.clock()&lt;self.ClaimUntil
        claim.Text=not self.Profile and "…" or (status.Claimed and tr("Награды","Rewards") or (busy and "…" or "+"..status.Amount))
        U.disabled(claim,not self.Profile or busy)
        if self.Rush then
            local left=math.max(0,math.ceil(self.Rush.Deadline-workspace:GetServerTimeNow()))
            timer.Text=string.format("%02d:%02d",math.floor(left/60),left%60)
            timer.TextColor3=left&lt;=10 and K.Red or K.Text
            rushDetail.Text=(self.Rush.Count or 0).." / "..self.Rush.Goal..tr(" монет"," coins")
            rushFill.Size=UDim2.fromScale(math.clamp((self.Rush.Count or 0)/self.Rush.Goal,0,1),1)
        end
    end
    function self:UpdateRush(data)
        self.Rush=data.Active and data or nil
        if self.Viewport then self:Layout(self.Viewport,self.Menu,self.Match,self.Waiting) end
        self:Step()
    end
    function self:Layout(vp,menu,inMatch,waiting)
        self.Viewport=vp;self.Menu=menu;self.Match=inMatch;self.Waiting=waiting
        local compact=vp.X&lt;620;local short=vp.Y&lt;500 and vp.X&gt;vp.Y
        local w=compact and 216 or 260
        wallet.Position=UDim2.new(1,-12,0,12);wallet.Size=UDim2.fromOffset(w,76)
        wallet.Visible=not menu and not (short and inMatch)
        fit(profileButton,10,10,44,44);fit(name,66,9,w-78,18);fit(rank,66,29,w-78,16)
        fit(coin,66,48,24,24);fit(money,96,45,w-108,26)
        track.Position=UDim2.new(0,10,1,-5);track.Size=UDim2.new(1,-20,0,2)
        daily.Position=UDim2.new(1,-12,0,98);daily.Size=UDim2.fromOffset(w,74)
        fit(dailyTitle,12,10,w-24,20);fit(dailySub,12,38,w-112,22);fit(claim,w-100,34,88,30)
        daily.Visible=not menu and not inMatch and not waiting and not self.Rush and not short
        local rw=math.min(400,vp.X-24)
        rush.Position=UDim2.new(.5,0,0,100);rush.Size=UDim2.fromOffset(rw,82)
        fit(rushTitle,16,10,rw-120,18);fit(rushDetail,16,32,rw-120,30);fit(timer,rw-104,22,88,34)
        fit(rushTrack,16,70,rw-32,3)
        rush.Visible=self.Rush~=nil and not menu and not inMatch
    end
    return self
end
return M
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_REDESIGN_00212">
        <Properties>
          <string name="Name">Notifications</string>
          <ProtectedString name="Source">local U=require(script.Parent.UIComponents)
local D=require(script.Parent.DesignSystem)
local Run=game:GetService("RunService")
local N={}
function N.new(gui,tr)
    local K=D.Color
    local self={Queue={},History={},Until=0,Current=nil}
    local root=U.frame(gui,K.Surface,10);root.Name="Notifications";root.ZIndex=100
    root.AnchorPoint=Vector2.new(.5,1);root.Visible=false
    U.stroke(root,K.Border,.35)
    local heading=U.text(root,tr("УВЕДОМЛЕНИЕ","NOTIFICATION"),10,K.Gold,D.Font.Strong)
    heading.Position=UDim2.fromOffset(18,10);heading.Size=UDim2.new(1,-80,0,16)
    local text=U.text(root,"",14,K.Text)
    text.Position=UDim2.fromOffset(18,30);text.Size=UDim2.new(1,-76,0,60)
    local progress=U.frame(root,K.Gold,2);progress.Position=UDim2.new(0,12,1,-5)
    local close
    local function advance()
        self.Current=table.remove(self.Queue,1)
        root.Visible=self.Current~=nil
        if self.Current then
            text.Text=self.Current
            self.Duration=math.clamp(utf8.len(self.Current)/20,4.5,12)
            self.Until=os.clock()+self.Duration
            heading.Text=tr("УВЕДОМЛЕНИЕ","NOTIFICATION")..(#self.Queue&gt;0 and "  ·  +"..#self.Queue or "")
        end
    end
    close=U.button(root,"×","secondary",advance)
    close.AnchorPoint=Vector2.new(1,0);close.Position=UDim2.new(1,-10,0,10);close.Size=UDim2.fromOffset(42,42)
    function self:Push(value)
        if type(value)~="string" or value=="" then return end
        if value==self.Current or value==self.Queue[#self.Queue] then return end
        self.Queue[#self.Queue+1]=value
        self.History[#self.History+1]=value
        if #self.History&gt;40 then table.remove(self.History,1) end
        if not self.Current then advance() end
    end
    function self:Layout(vp,bottom)
        root.Size=UDim2.fromOffset(math.min(460,vp.X-28),104)
        root.Position=UDim2.new(.5,0,1,-bottom)
    end
    Run.RenderStepped:Connect(function()
        if not self.Current then return end
        local left=self.Until-os.clock()
        progress.Size=UDim2.fromOffset(math.max(0,root.AbsoluteSize.X-24)*math.clamp(left/self.Duration,0,1),2)
        if left&lt;=0 then advance() end
    end)
    return self
end
return N
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="RBX1690">
      <Properties>
        <string name="Name">SkylineRemotes</string>
      </Properties>
      <Item class="RemoteEvent" referent="RBX1691">
        <Properties>
          <string name="Name">Action</string>
        </Properties>
      </Item>
      <Item class="RemoteEvent" referent="RBX1692">
        <Properties>
          <string name="Name">State</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX1693">
      <Properties>
        <string name="Name">SkylineServer</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX1694">
        <Properties>
          <string name="Name">Profiles</string>
          <ProtectedString name="Source">-- Atomic UpdateAsync transactions, session lease, serialized local writes.
-- Coins and developer-product receipt IDs are committed in ONE profile update.
-- Never acknowledges an unpaid/uncommitted receipt; never replaces failed loads with defaults.
local DSS=game:GetService("DataStoreService")
local Run=game:GetService("RunService")
local Http=game:GetService("HttpService")
local Players=game:GetService("Players")
local C=require(game:GetService("ReplicatedStorage"):WaitForChild("SkylineShared").Config)
local L=require(game:GetService("ReplicatedStorage"):WaitForChild("SkylineShared").Logic)
local G=require(game:GetService("ReplicatedStorage"):WaitForChild("SkylineShared").Progression)
local P={}
local live=(game.GameId~=0) and (not Run:IsStudio() or C.StudioPersistence)
local store=live and DSS:GetDataStore(C.ProfileStore) or nil
local sessions={}
local serverToken=(game.JobId~="" and game.JobId or "studio")..":"..Http:GenerateGUID(false)
local function default()
    return {Version=1,Rating=C.StartRating,Coins=100,XP=0,Wins=0,Losses=0,Draws=0,Games=0,
        Streak=0,BestStreak=0,RankedGames=0,Owned={Classic=true},Equipped="Classic",Shapes={Classic=true},Shape="Classic",
        LastDaily=-1,DailyStreak=0,RushDay=-1,RushBest=0,QuestDay=-1,QuestProgress={Games=0,Wins=0,Moves=0},QuestClaims={},
        Explorer={},ExplorerClaimed=false,Settings={LowFX=false,Sound=true,TutorialSeen=false},RewardHour=0,RewardCount=0,
        PairHour=0,Pairs={},Receipts={},MatchGrants={},MatchOrder={},Journeys={},Weekly={},Club={},Medals={},VariantStats={}}
end
local function finite(v) return type(v)=="number" and v==v and v&gt; -math.huge and v&lt;math.huge end
local function normalize(d)
    local base=default()
    if type(d)~="table" then return base end
    for k,v in pairs(base) do if type(d[k])~=type(v) then d[k]=L.copy(v) end end
    for _,k in ipairs({"Coins","XP","Wins","Losses","Draws","Games","Streak","BestStreak","RankedGames"}) do
        if not finite(d[k]) then d[k]=base[k] end
        d[k]=math.max(0,math.floor(d[k]))
    end
    if not finite(d.Rating) then d.Rating=C.StartRating end
    d.Rating=math.max(100,math.floor(d.Rating));d.Owned.Classic=true
    d.Shapes=type(d.Shapes)=="table" and d.Shapes or {};d.Shapes.Classic=true
    for key,value in pairs(base.Settings) do if type(d.Settings[key])~="boolean" then d.Settings[key]=value end end
    d.DailyStreak=finite(d.DailyStreak) and math.clamp(math.floor(d.DailyStreak),0,7) or 0
    if d.LastDaily&gt;=L.day() and d.DailyStreak==0 then d.DailyStreak=1 end
    if not C.Skins[d.Equipped] then d.Equipped="Classic" end
    if type(d.Shape)~="string" or not C.Shapes[d.Shape] then d.Shape="Classic" end
    G.ensure(d)
    return d
end
function P.isLive() return live end
function P.get(p) local s=sessions[p];return s and not s.Closing and s.Data or nil end
function P.load(p)
    if sessions[p] then return false,"already loaded" end
    local s={Token=serverToken..":"..p.UserId..":"..Http:GenerateGUID(false),Busy=false,Closing=false,Lease=os.time()+C.SessionLease}
    if not live then s.Data=default();sessions[p]=s;return true end
    for attempt=1,6 do
        local ok,record=pcall(function()
            return store:UpdateAsync("u_"..p.UserId,function(old)
                old=type(old)=="table" and old or {}
                if old.Session and old.Session.Token~=s.Token and (old.Session.Expires or 0)&gt;os.time() then return nil end
                return {Data=normalize(old.Data),Session={Token=s.Token,Expires=os.time()+C.SessionLease}}
            end)
        end)
        if ok and record and record.Session and record.Session.Token==s.Token then
            s.Data=record.Data;s.Lease=record.Session.Expires;sessions[p]=s;return true
        end
        if attempt&lt;6 then task.wait(3) end
    end
    return false,"profile unavailable or still active on another server"
end
local function acquire(s)
    local deadline=os.clock()+22
    while s.Busy and os.clock()&lt;deadline do task.wait(.05) end
    if s.Busy then return false end
    s.Busy=true;return true
end
-- callback must be pure and non-yielding. Return a status code, not a side effect.
function P.change(p,fn)
    local s=sessions[p]
    if not s or s.Closing or not acquire(s) then return false,"BUSY" end
    if s.Closing then s.Busy=false;return false,"CLOSING" end
    local result=nil
    local ok,record=pcall(function()
        if not live then
            local d=L.copy(s.Data);result=fn(d);return {Data=d}
        end
        return store:UpdateAsync("u_"..p.UserId,function(old)
            if not old or not old.Session or old.Session.Token~=s.Token then return nil end
            local d=normalize(old.Data)
            result=fn(d)
            return {Data=d,Session={Token=s.Token,Expires=os.time()+C.SessionLease}}
        end)
    end)
    if ok and record and record.Data then
        s.Data=record.Data;s.Lease=record.Session and record.Session.Expires or os.time()+C.SessionLease
    end
    s.Busy=false
    if not ok or not record then
        warn("[Skyline] profile transaction failed",p.UserId,ok and "lease lost" or tostring(record))
        if live and ((ok and not record) or os.time()&gt;s.Lease-10) then
            task.defer(function() if p.Parent==Players then p:Kick("Сохранение недоступно. Перезайдите, чтобы защитить прогресс. / Please rejoin to protect your data.") end end)
        end
        return false,"SAVE_FAILED"
    end
    return true,result
end
function P.close(p)
    local s=sessions[p]
    if not s or s.Closing then return end
    s.Closing=true
    if not acquire(s) then return end
    if live then
        local ok,err=pcall(function()
            store:UpdateAsync("u_"..p.UserId,function(old)
                if not old or not old.Session or old.Session.Token~=s.Token then return nil end
                old.Session=nil;return old -- no stale cached snapshot overwrites newer data
            end)
        end)
        if not ok then warn("[Skyline] lease release deferred to expiry",p.UserId,err) end
    end
    s.Busy=false;sessions[p]=nil
end
function P.count() local n=0 for _ in pairs(sessions) do n=n+1 end return n end
function P.players() local t={} for p in pairs(sessions) do t[#t+1]=p end return t end
-- Renew even for idle players; persisted transactions already save actual progress.
task.spawn(function()
    while true do
        task.wait(C.HeartbeatSeconds)
        for p,s in pairs(sessions) do
            if not s.Closing then task.spawn(function() P.change(p,function() return "HEARTBEAT" end) end) end
        end
    end
end)
return P
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX1695">
        <Properties>
          <string name="Name">Main</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source">-- SKYLINE NEXUS | Authoritative server. No client-controlled currency, rating or purchases.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Market=game:GetService("MarketplaceService")
local DSS=game:GetService("DataStoreService")
local Badge=game:GetService("BadgeService")
local Analytics=game:GetService("AnalyticsService")
local Http=game:GetService("HttpService")
local shared=RS:WaitForChild("SkylineShared")
local C=require(shared.Config)
local L=require(shared.Logic)
local P=require(script.Parent.Profiles)
local Rewards=require(script.Parent.MatchRewards)
local Medals=require(script.Parent.Milestones35)
local G=require(shared.Progression)
local V=require(shared.Variants)
local Gl=require(shared.Glyphs)
local world=workspace:WaitForChild("SkylineNexus")
local hub=world:WaitForChild("Hub")
local af=world:WaitForChild("Arenas")
local remotes=RS:WaitForChild("SkylineRemotes")
local action=remotes.Action
local state=remotes.State
local rng=Random.new()
local arenas,assigned,queued,queues={},{},{},{PVP={},BOT={}}
local vip,limits,leaving={},{},{}
local premium={}
local rewardPending={}
local rushRuns={}
local replayRequests={}
local processing=false
local closing=false
local globalRows={}
local ordered=P.isLive() and DSS:GetOrderedDataStore(C.RatingStore) or nil
local epoch=Http:GenerateGUID(false)
local counter=0
local startMatch,processQueues,finish,beginTurn,move,join,claimDaily,updateRatingBoard
local function fire(p,payload) if p and p.Parent==Players then state:FireClient(p,payload) end end
local function notice(p,ru,en) fire(p,{Kind="Notice",RU=ru,EN=en or ru}) end
local function analytics(p,event,value)
    if C.Analytics and not game:GetService("RunService"):IsStudio() and p.Parent==Players then
        task.spawn(function() pcall(function() Analytics:LogCustomEvent(p,event,value or 1) end) end)
    end
end
local function awardBadge(p,key)
    local id=C.BadgeIds[key]
    if id and id&gt;0 then task.spawn(function() pcall(function() Badge:AwardBadgeAsync(p.UserId,id) end) end) end
end
local function sync(p)
    local d=P.get(p);if not d then return end
    local stats=p:FindFirstChild("leaderstats")
    if not stats then
        stats=Instance.new("Folder");stats.Name="leaderstats";stats.Parent=p
        for _,n in ipairs({"Rating","Wins","Coins"}) do local v=Instance.new("IntValue");v.Name=n;v.Parent=stats end
    end
    stats.Rating.Value=d.Rating;stats.Wins.Value=d.Wins;stats.Coins.Value=d.Coins
    local out={}
    for _,k in ipairs({"Rating","Wins","Losses","Draws","Games","RankedGames","Coins","XP","Streak","BestStreak","Owned","Equipped","Shapes","Shape","LastDaily","DailyStreak","QuestDay","QuestProgress","QuestClaims","Explorer","ExplorerClaimed","Settings","RushDay","RushBest","VariantStats"}) do out[k]=L.copy(d[k]) end
    out.Progression=G.snapshot(d);out.Premium=(vip[p]==true or premium[p]==true)
    out.VIP=vip[p]==true;out.Persistent=P.isLive();out.Day=L.day();out.Level=L.level(d.XP)
    -- 3.2.2: место в рейтинге для карточки в меню «Профиль».
    local board=globalRows
    if #board==0 then
        board={}
        for _,q in ipairs(Players:GetPlayers()) do local qd=P.get(q);if qd then board[#board+1]={Name=q.DisplayName,Rating=qd.Rating,UserId=q.UserId} end end
        table.sort(board,function(a,b) return a.Rating&gt;b.Rating end)
    end
    local place,gap=nil,nil
    for i,row in ipairs(board) do if row.UserId==p.UserId then place=i;break end end
    if #board&gt;=10 and board[10] then gap=math.max(0,math.floor((board[10].Rating or 0)-d.Rating)) end
    out.Rank=place;out.TopGap=gap;out.TopSize=#board
    -- 3.5.0: медали и режим дня для меню.
    local medalRows,medalDone=Medals.snapshot(d)
    out.Medals=medalRows;out.MedalCount=medalDone;out.Featured=V.featured(out.Day)
    fire(p,{Kind="Profile",Data=out})
end
local function root(p) return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") end
local function teleport(p,target)
    local r=root(p)
    if r and target then
        p.Character:PivotTo(target.CFrame+Vector3.new(0,3.5,0))
        r.AssemblyLinearVelocity=Vector3.zero;r.AssemblyAngularVelocity=Vector3.zero
    end
end
local function isAlive(p)
    local hum=p and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health&gt;0 and root(p)~=nil
end
local function appearance(p)
    local ch=p.Character;if not ch then return end
    local r=ch:FindFirstChild("HumanoidRootPart");local head=ch:FindFirstChild("Head")
    if r then
        for _,n in ipairs({"SkylineTrail","SkylineA0","SkylineA1"}) do local o=r:FindFirstChild(n);if o then o:Destroy() end end
    end
    if head then local o=head:FindFirstChild("SkylineClub");if o then o:Destroy() end end
    if not vip[p] or not r then return end
    local d=P.get(p);local trailKey=d and d.Club and d.Club.Trail or "Gold"
    if trailKey=="Off" then return end
    local trail=C.Club.Trails[trailKey] or C.Club.Trails.Gold
    local a=Instance.new("Attachment");a.Name="SkylineA0";a.Position=Vector3.new(-.75,0,0);a.Parent=r
    local b=Instance.new("Attachment");b.Name="SkylineA1";b.Position=Vector3.new(.75,0,0);b.Parent=r
    local t=Instance.new("Trail");t.Name="SkylineTrail";t.Attachment0=a;t.Attachment1=b;t.Lifetime=.45;t.MinLength=.2
    t.Color=ColorSequence.new(Color3.fromRGB(table.unpack(trail.Color)));t.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.45),NumberSequenceKeypoint.new(1,1)});t.LightEmission=.35;t.Parent=r

end
local function refreshVIP(p)
    if game:GetService("RunService"):IsStudio() and not P.isLive() then
        vip[p]=C.StudioPreview.Club==true;premium[p]=C.StudioPreview.Premium==true
        appearance(p);sync(p);return
    end
    for _,entry in ipairs({{C.PassIds.VIP,vip},{C.PassIds.BattlePass,premium}}) do
        local id,bucket=entry[1],entry[2]
        if id&gt;0 then
            local ok,owned=pcall(function() return Market:UserOwnsGamePassAsync(p.UserId,id) end)
            if ok and p.Parent==Players then bucket[p]=owned==true end
        elseif p.Parent==Players then bucket[p]=false end
    end
    if p.Parent==Players then appearance(p);sync(p) end
end
local function removeQueue(p)
    queued[p]=nil
    for _,q in pairs(queues) do for i=#q,1,-1 do if q[i].Player==p then table.remove(q,i) end end end
end
local function cleanQueues()
    for _,q in pairs(queues) do for i=#q,1,-1 do
        local p=q[i].Player
        if p.Parent~=Players or assigned[p] or leaving[p] or not P.get(p) then queued[p]=nil;table.remove(q,i) end
    end end
end
local function colorFor(p,symbol)
    local d=p and P.get(p);local key=d and d.Equipped or "Classic"
    if not C.Skins[key] or (C.Skins[key].VIP and not vip[p]) then key="Classic" end
    return Color3.fromRGB(table.unpack(C.Skins[key][symbol]))
end
local function shapeFor(p,symbol)
    local d=p and P.get(p);local key=d and d.Shape or "Classic"
    if not C.Shapes[key] then key="Classic" end
    return Gl.kind(C.Shapes[key],symbol)
end
local function sign(a)
    local m=a.Match
    a.Model:SetAttribute("CourtStatus",not m and "OPEN" or (m.Finished and "RESULT" or "PLAYING"))
end
local function paint(a)
    local m=a.Match
    a.Model.Marks:ClearAllChildren()
    for i,cell in ipairs(a.Cells) do
        local s=m and m.Board[i] or ""
        cell.Color=s=="" and Color3.fromRGB(220,222,210) or m.Colors[s]:Lerp(Color3.fromRGB(241,237,225),.78)
        cell:SetAttribute("Owner",s)
        cell.PlacePrompt.Enabled=m~=nil and not m.Finished and s==""
        if s~="" then
            local function bar(name,sz,cf)
                local p=Instance.new("Part");p.Name=name;p.Size=sz;p.CFrame=cf;p.Color=m.Colors[s];p.Material=Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Parent=a.Model.Marks
            end
            -- 3.1: форма метки берётся из набора значков игрока (одна геометрия с UI).
            local glyph=Gl.get((m.Glyphs and m.Glyphs[s]) or Gl.fallback(s))
            if glyph.Round then
                for k=1,16 do
                    local angle=k*math.pi*2/16
                    bar(s,Vector3.new(1.18,.35,.65),cell.CFrame*CFrame.new(math.sin(angle)*2.85,.5,math.cos(angle)*2.85)*CFrame.Angles(0,angle,0))
                end
            else
                local span=7.4
                local width=math.max(.45,glyph.Thickness*span)
                for _,seg in ipairs(glyph.Segments) do
                    local x1,z1=(seg[1]-.5)*span,(seg[2]-.5)*span
                    local x2,z2=(seg[3]-.5)*span,(seg[4]-.5)*span
                    local dx,dz=x2-x1,z2-z1
                    local length=math.sqrt(dx*dx+dz*dz)
                    if length&gt;.05 then
                        bar(s,Vector3.new(length+width*.6,.35,width),cell.CFrame*CFrame.new((x1+x2)/2,.5,(z1+z2)/2)*CFrame.Angles(0,-math.atan2(dz,dx),0))
                    end
                end
            end
        end
    end
    if m and not m.Finished then
        local maxMarks=V.get(m.Variant).MaxMarks
        if maxMarks&gt;0 then
            for _,s in ipairs({"X","O"}) do
                local index=L.fading(m.History,s,maxMarks)
                local cell=index and a.Cells[index]
                if cell then cell.Color=cell.Color:Lerp(Color3.fromRGB(255,255,255),.5) end
            end
        end
    end
    if m and m.Line then
        for _,i in ipairs(m.Line) do a.Cells[i].Color=Color3.fromRGB(255,224,157) end
    end
    sign(a)
end
local function matchPayload(a,p)
    local m=a.Match
    local opponent=m.X==p and m.O or nil
    if m.O==p then opponent=m.X end
    return {Kind="Match",Id=m.Id,Arena=a.Id,Mode=m.Mode,Difficulty=m.Difficulty,Board=L.copy(m.Board),
        Symbol=m.X==p and "X" or "O",Turn=m.Turn,Deadline=m.Deadline,Revision=m.Revision,
        Opponent=opponent and opponent.DisplayName or "NEXUS BOT",
        Finished=m.Finished,Result=m.Result,Line=m.Line,Reason=m.Reason,Rated=m.Rated,
        Variant=m.Variant or "Classic",TurnSeconds=V.get(m.Variant).TurnSeconds,
        Fading={X=L.fading(m.History,"X",V.get(m.Variant).MaxMarks),O=L.fading(m.History,"O",V.get(m.Variant).MaxMarks)},
        Glyphs={X=(m.Glyphs and m.Glyphs.X) or "cross",O=(m.Glyphs and m.Glyphs.O) or "ring"},
        Colors={X={m.Colors.X.R,m.Colors.X.G,m.Colors.X.B},O={m.Colors.O.R,m.Colors.O.G,m.Colors.O.B}}}
end
local function sendMatch(a)
    local m=a.Match
    for _,p in pairs({m.X,m.O}) do if p then fire(p,matchPayload(a,p)) end end
end
local function pushHubState()
    cleanQueues()
    local rows={};local free=0
    for _,a in ipairs(arenas) do
        local m=a.Match
        if not m then free=free+1 end
        rows[#rows+1]={Id=a.Id,Busy=m~=nil,Mode=m and m.Mode or "",X=m and (m.X and m.X.DisplayName or "BOT") or "",O=m and (m.O and m.O.DisplayName or "BOT") or ""}
    end
    for _,p in ipairs(Players:GetPlayers()) do fire(p,{Kind="Hub",Courts=rows,Queue=#queues.PVP,Global=globalRows}) end
    for _,q in pairs(queues) do for i,e in ipairs(q) do fire(e.Player,{Kind="Queue",Mode=e.Mode,Position=i,Since=e.Since}) end end
end
-- 3.5.0: снимок холла рассылается не чаще четырёх раз в секунду: один общий отложенный вызов вместо десятка подряд.
local hubPending=false
local function hubState()
    if hubPending then return end
    hubPending=true
    task.delay(.25,function()
        hubPending=false
        if not closing then pcall(pushHubState) end
    end)
end
local function medalNotice(p,medal)
    notice(p,"Медаль: "..medal.RU.."  ·  +"..medal.Coins.." монет, +"..medal.XP.." XP","Medal: "..medal.EN.."  ·  +"..medal.Coins.." coins, +"..medal.XP.." XP")
end
local function grantResult(p,m,symbol)
    if not P.get(p) then return end
    local success,status=false,nil
    for attempt=1,3 do
        if not P.get(p) then return end
        success,status=P.change(p,function(d)
            local receipt,code=Rewards.apply(d,m,symbol,m.RewardHour)
            return {Receipt=receipt,Code=code}
        end)
        if success then break end
        if attempt&lt;3 then task.wait(attempt*2) end
    end
    if not success or type(status)~="table" or not status.Receipt then
        fire(p,{Kind="RewardFailed",Id=m.Id,Reason="SAVE_FAILED"})
        notice(p,"Сохранение результата не подтверждено. Награда не показана как полученная.","Result saving was not confirmed. The reward is not shown as received.")
        return
    end
    sync(p)
    local payload=L.copy(status.Receipt)
    payload.Kind="Reward";payload.Persisted=P.isLive()
    fire(p,payload)
    if type(payload.Medals)=="table" then for _,medal in ipairs(payload.Medals) do medalNotice(p,medal) end end
    if status.Code=="GRANTED" then
        analytics(p,"MatchCompleted")
        local d=P.get(p)
        if d and d.Wins&gt;=1 then awardBadge(p,"FirstWin") end
        if d and d.Wins&gt;=10 then awardBadge(p,"TenWins") end
        if ordered and payload.Rated and d then task.spawn(function() pcall(function() ordered:SetAsync(tostring(p.UserId),d.Rating) end) end) end
    end
end
finish=function(a,result,reason,line)
    local m=a.Match;if not m or m.Finished then return end
    m.RewardHour=math.floor(os.time()/3600);m.RewardDay=L.day()
    m.Duration=os.clock()-m.Started;m.Finished=true;m.Result=result;m.Reason=reason or "NORMAL";m.Line=line;m.Revision=m.Revision+1
    paint(a);sendMatch(a)
    for symbol,p in pairs({X=m.X,O=m.O}) do
        if p then
            rewardPending[p]=true
            task.spawn(function()
                local ok,err=pcall(grantResult,p,m,symbol)
                rewardPending[p]=nil
                if not ok then warn("[Skyline] reward error",err);fire(p,{Kind="RewardFailed",Id=m.Id,Reason="SAVE_FAILED"});notice(p,"Не удалось подтвердить сохранение результата.","Could not confirm that the result was saved.") end
            end)
        end
    end
    task.delay(C.ResultSeconds,function()
        if a.Match~=m then return end
        for _,p in pairs({m.X,m.O}) do
            if p then assigned[p]=nil;p:SetAttribute("SkylineArena",nil);teleport(p,hub.LobbySpawn);fire(p,{Kind="Lobby"});sync(p) end
        end
        a.Match=nil;paint(a);processQueues();hubState()
        for _,p in pairs({m.X,m.O}) do
            local intent=p and replayRequests[p]
            if intent and intent.Id==m.Id then
                task.spawn(function()
                    local deadline=os.clock()+20
                    while rewardPending[p] and p.Parent==Players and not closing and os.clock()&lt;deadline do task.wait(.1) end
                    if replayRequests[p]~=intent then return end
                    replayRequests[p]=nil
                    if closing or leaving[p] or p.Parent~=Players or assigned[p] or queued[p] then return end
                    if rewardPending[p] then
                        notice(p,"Награда ещё сохраняется. Начните следующий матч через меню.","Your reward is still saving. Start the next match from Play.")
                        return
                    end
                    join(p,intent.Mode,intent.Difficulty,intent.Variant)
                end)
            end
        end
    end)
end
move=function(a,index,symbol,manual)
    local m=a.Match
    if m and not m.Finished and workspace:GetServerTimeNow()&gt;m.Deadline then finish(a,L.other(m.Turn),"TIMEOUT");return end
    if not m or m.Finished or m.Turn~=symbol or type(index)~="number" or index%1~=0 or index&lt;1 or index&gt;9 or m.Board[index]~="" then return end
    if not m.History then m.History={X={},O={}} end
    m.Faded=L.place(m.Board,m.History,index,symbol,V.get(m.Variant).MaxMarks)
    if manual then m.Manual[symbol]=m.Manual[symbol]+1;m.Timeouts[symbol]=0 end
    m.Revision=m.Revision+1
    local result,line=L.outcome(m.Board)
    if result then finish(a,result,"NORMAL",line);return end
    m.Turn=L.other(symbol);beginTurn(a)
end
beginTurn=function(a)
    local m=a.Match;if not m or m.Finished then return end
    m.Deadline=workspace:GetServerTimeNow()+V.get(m.Variant).TurnSeconds
    local revision=m.Revision
    paint(a);sendMatch(a)
    if not m[m.Turn] then
        task.delay(.75+rng:NextNumber()*.45,function()
            if a.Match==m and not m.Finished and m.Revision==revision then
                local rules=V.get(m.Variant)
                local choice=rules.MaxMarks&gt;0
                    and L.shiftBot(m.Board,m.History,m.Turn,m.Difficulty,rng,rules.MaxMarks)
                    or L.bot(m.Board,m.Turn,m.Difficulty,rng)
                move(a,choice,m.Turn,false)
            end
        end)
    end
end
startMatch=function(a,e1,e2)
    local p1=e1.Player;local p2=e2 and e2.Player
    if not isAlive(p1) or (p2 and not isAlive(p2)) then
        notice(p1,"Персонаж возрождается. Попробуйте ещё раз.","Character respawning. Please try again.")
        fire(p1,{Kind="Lobby"});if p2 then fire(p2,{Kind="Lobby"}) end
        return
    end
    counter=counter+1
    local x,o=p1,p2
    if rng:NextNumber()&lt;.5 then x,o=p2,p1 end
    local d1,d2=P.get(p1),p2 and P.get(p2)
    if not d1 or (p2 and not d2) then return end
    local hour=math.floor(os.time()/3600)
    local function pairCount(d,id) return d.PairHour==hour and (d.Pairs[tostring(id)] or 0) or 0 end
    local rated=p2~=nil and game.PrivateServerId=="" and pairCount(d1,p2.UserId)&lt;C.PairRatedMatchesPerHour and pairCount(d2,p1.UserId)&lt;C.PairRatedMatchesPerHour
    local variant=(p2==nil and V.valid(e1.Variant)) and e1.Variant or "Classic"
    local m={Id=epoch..":"..counter,X=x,O=o,Mode=p2 and "PVP" or "BOT",Difficulty=e1.Difficulty or "Normal",
        Board={"","","","","","","","",""},Turn="X",Revision=0,Started=os.clock(),Finished=false,
        Manual={X=0,O=0},Timeouts={X=0,O=0},Rated=rated,Variant=variant,History={X={},O={}},
        Ratings={X=x and P.get(x).Rating or 1000,O=o and P.get(o).Rating or 1000},
        Colors={X=colorFor(x,"X"),O=colorFor(o,"O")},Glyphs={X=shapeFor(x,"X"),O=shapeFor(o,"O")}}
    a.Match=m
    for symbol,p in pairs({X=x,O=o}) do
        if p then assigned[p]=a;p:SetAttribute("SkylineArena",a.Id);teleport(p,a.Model["Spawn"..symbol]);analytics(p,"MatchStarted") end
    end
    beginTurn(a)
end
processQueues=function()
    if processing or closing then return end
    processing=true;cleanQueues()
    for _,a in ipairs(arenas) do if not a.Match then
        if #queues.PVP&gt;=2 then
            local e1=table.remove(queues.PVP,1)
            local bestIndex,bestDiff=1,math.huge
            for i,e in ipairs(queues.PVP) do
                local diff=math.abs(P.get(e.Player).Rating-P.get(e1.Player).Rating)
                if diff&lt;bestDiff then bestIndex=i;bestDiff=diff end
            end
            local e2=table.remove(queues.PVP,bestIndex)
            queued[e1.Player]=nil;queued[e2.Player]=nil;startMatch(a,e1,e2)
        elseif #queues.BOT&gt;0 then
            local e=table.remove(queues.BOT,1);queued[e.Player]=nil;startMatch(a,e,nil)
        end
    end end
    processing=false;hubState()
end
join=function(p,mode,difficulty,variant)
    if rushRuns[p] then notice(p,"Заверши забег перед входом в матч.","Finish your courtyard run before joining a match.");return end
    if not P.get(p) or assigned[p] or leaving[p] then return end
    if rewardPending[p] then notice(p,"Предыдущий результат ещё сохраняется. Подождите немного.","Previous result is still saving. Please wait a moment.");return end
    if mode~="PVP" and mode~="BOT" then return end
    if not isAlive(p) then notice(p,"Дождитесь появления персонажа.","Wait for your character to spawn.");return end
    if difficulty~="Easy" and difficulty~="Normal" and difficulty~="Hard" then difficulty="Normal" end
    if not V.valid(variant) or mode~="BOT" then variant="Classic" end
    removeQueue(p)
    local e={Player=p,Mode=mode,Difficulty=difficulty,Variant=variant,Since=workspace:GetServerTimeNow()}
    queued[p]=e;table.insert(queues[mode],e);processQueues()
end
for id=1,C.ArenaCount do
    local model=af:WaitForChild("Arena"..id)
    local a={Id=id,Model=model,Cells={}}
    for i=1,9 do
        local index=i
        local cell=model.Cells:WaitForChild("Cell"..i);a.Cells[i]=cell
        cell.PlacePrompt.Triggered:Connect(function(p)
            local m=a.Match;local r=root(p)
            if assigned[p]~=a or not m or not r or not isAlive(p) or (r.Position-cell.Position).Magnitude&gt;16 then return end
            local s=m.X==p and "X" or "O";move(a,index,s,true)
        end)
    end
    arenas[id]=a;paint(a)
end
-- Per-player token bucket shared by all remote requests.
local function allowed(p)
    local t=limits[p] or {Tokens=16,At=os.clock(),Last={}};limits[p]=t
    local now=os.clock();t.Tokens=math.min(16,t.Tokens+(now-t.At)*5);t.At=now
    if t.Tokens&lt;1 then return false end;t.Tokens=t.Tokens-1;return true
end
local function cooldown(p,key,seconds)
    local t=limits[p];local now=os.clock()
    if t.Last[key] and now-t.Last[key]&lt;seconds then return false end
    t.Last[key]=now;return true
end
local function saveAction(p,fn)
    local ok,res=P.change(p,fn)
    if ok then sync(p)
    else notice(p,"Не удалось подтвердить сохранение. Проверьте профиль после переподключения.","Could not confirm the save. Check your profile after reconnecting.") end
    return ok,res
end
action.OnServerEvent:Connect(function(p,kind,data)
    if closing or leaving[p] or type(kind)~="string" or #kind&gt;24 or not allowed(p) then return end
    data=type(data)=="table" and data or {}
    if kind=="Ready" then
        if not cooldown(p,"Ready",1) then return end
        sync(p);local a=assigned[p]
        if a and a.Match then fire(p,matchPayload(a,p))
        elseif queued[p] then fire(p,{Kind="Queue",Mode=queued[p].Mode,Position=1,Since=queued[p].Since})
        else fire(p,{Kind="Lobby"}) end
        return
    end
    if not P.get(p) then return end
    if kind=="Move" then
        local a=assigned[p];local m=a and a.Match;local r=root(p)
        if not m or not r or not isAlive(p) or data.Id~=m.Id or data.Revision~=m.Revision or (r.Position-a.Model.Center.Position).Magnitude&gt;58 then return end
        if not cooldown(p,"Move",.16) then return end
        move(a,data.Index,m.X==p and "X" or "O",true)
    elseif kind=="Queue" then
        if cooldown(p,"Queue",1.5) then replayRequests[p]=nil;join(p,data.Mode,data.Difficulty,data.Variant) end
    elseif kind=="Replay" and cooldown(p,"Replay",1) then
        local a=assigned[p];local m=a and a.Match
        if m and m.Finished and data.Id==m.Id then
            replayRequests[p]={Id=m.Id,Mode=m.Mode,Difficulty=m.Difficulty,Variant=m.Variant}
            notice(p,"Следующий матч начнётся после сохранения результата.","The next match starts after your result is saved.")
        end
    elseif kind=="Cancel" then
        replayRequests[p]=nil;removeQueue(p);if not assigned[p] then fire(p,{Kind="Lobby"}) end;processQueues()
    elseif kind=="Resign" then
        local a=assigned[p];if a and a.Match and data.Id==a.Match.Id and cooldown(p,"Resign",2) then
            finish(a,L.other(a.Match.X==p and "X" or "O"),"RESIGN")
        end
    elseif kind=="Daily" and cooldown(p,"Daily",3) then
        claimDaily(p)
    elseif kind=="Quest" and cooldown(p,"Quest",1.5) then
        local key=type(data.Key)=="string" and data.Key or "";local q=C.Quests[key]
        if not q then return end
        local ok,res=saveAction(p,function(d)
            L.daily(d,L.day())
            if d.QuestClaims[key] or (d.QuestProgress[q.Field] or 0)&lt;q.Goal then return "NOT_READY" end
            d.QuestClaims[key]=true;d.Coins=d.Coins+q.Coins;d.XP=d.XP+q.XP;G.addXP(d,q.PassXP);return "OK"
        end)
        if ok and res=="OK" then notice(p,"Награда за задание получена!","Quest reward claimed!") end
    elseif kind=="Skin" and cooldown(p,"Skin",.8) then
        local key=type(data.Key)=="string" and data.Key or "";local item=C.Skins[key]
        if not item or (item.VIP and not vip[p]) then return end
        local ok,res=saveAction(p,function(d)
            if item.PassOnly and not d.Owned[key] then return "LOCKED" end
            if not d.Owned[key] and not item.VIP then
                if d.Coins&lt;item.Price then return "POOR" end
                d.Coins=d.Coins-item.Price;d.Owned[key]=true
            end
            d.Equipped=key;return "OK"
        end)
        if res=="LOCKED" then notice(p,"Эта палитра открывается в Батл Пассе.","Unlock this palette in the Battle Pass.");return end
        if ok then notice(p,res=="POOR" and "Недостаточно монет." or "Стиль выбран для следующего матча.",res=="POOR" and "Not enough coins." or "Style equipped for the next match.") end
    elseif kind=="Shape" and cooldown(p,"Shape",.8) then
        local key=type(data.Key)=="string" and data.Key or "";local item=C.Shapes[key]
        if not item then return end
        local ok,res=saveAction(p,function(d)
            d.Shapes=type(d.Shapes)=="table" and d.Shapes or {}
            if not d.Shapes[key] and item.Price&gt;0 then
                if d.Coins&lt;item.Price then return "POOR" end
                d.Coins=d.Coins-item.Price
            end
            d.Shapes[key]=true;d.Shape=key;return "OK"
        end)
        if ok then notice(p,res=="POOR" and "Недостаточно монет." or "Набор значков выбран для следующего матча.",res=="POOR" and "Not enough coins." or "Mark set equipped for the next match.") end
    elseif kind=="PassClaim" and cooldown(p,"PassClaim",1) then
        local entitled=vip[p]==true or premium[p]==true
        local ok,res=saveAction(p,function(d)
            if data.All==true then return G.claimAll(d,entitled)&gt;0 and "OK" or "NOT_READY" end
            return G.claimPass(d,data.Tier,data.Track,entitled)
        end)
        if ok and res=="OK" then notice(p,"Награды Батл Пасса получены!","Battle Pass rewards claimed!");analytics(p,"PassRewardClaimed") end
    elseif kind=="Weekly" and cooldown(p,"Weekly",1) then
        local day=L.day();local key=type(data.Key)=="string" and data.Key or ""
        local ok,res=saveAction(p,function(d) return G.claimWeekly(d,day,key) end)
        if ok and res=="OK" then notice(p,"Недельная награда получена!","Weekly reward claimed!");analytics(p,"WeeklyRewardClaimed") end
    elseif kind=="Mastery" and cooldown(p,"Mastery",1) then
        local ok,res=saveAction(p,G.claimMastery)
        if ok and res=="OK" then notice(p,"Награда мастерства получена!","Mastery reward claimed!") end
    elseif kind=="ClubClaim" and cooldown(p,"ClubClaim",1) then
        local day=L.day();local entitled=vip[p]==true
        local ok,res=saveAction(p,function(d) return G.claimClub(d,day,data.Key,entitled) end)
        if ok and res=="OK" then notice(p,"Подарок Club получен!","Club gift claimed!") end
    elseif kind=="ClubTrail" and cooldown(p,"ClubTrail",.8) then
        local key=type(data.Key)=="string" and data.Key or ""
        if not vip[p] or not C.Club.Trails[key] then return end
        local ok=saveAction(p,function(d) G.ensure(d);d.Club.Trail=key;return "OK" end)
        if ok then appearance(p) end
    elseif kind=="Setting" and cooldown(p,"Setting",.8) then
        if (data.Key=="LowFX" or data.Key=="Sound" or data.Key=="TutorialSeen") and type(data.Value)=="boolean" then
            saveAction(p,function(d) d.Settings[data.Key]=data.Value;return "OK" end)
        end
    elseif kind=="Home" and not assigned[p] and cooldown(p,"Home",3) then replayRequests[p]=nil;removeQueue(p);teleport(p,hub.LobbySpawn);fire(p,{Kind="Lobby"});processQueues()
    elseif kind=="RefreshVIP" and cooldown(p,"VIP",10) then task.spawn(refreshVIP,p)
    end
end)
-- World prompts are also validated on server; no automatic purchase popups.
local function connectPrompt(part,callback)
    part.Prompt.Triggered:Connect(function(p)
        local r=root(p)
        if not closing and not leaving[p] and isAlive(p) and r and (r.Position-part.Position).Magnitude&lt;=18 and allowed(p) then callback(p) end
    end)
end
local shopKiosk=hub:FindFirstChild("ShopKiosk"); if shopKiosk then connectPrompt(shopKiosk,function(p) fire(p,{Kind="Open",Page="Shop"}) end) end
-- Daily/Quests lives only in the bottom bar from 3.3; the spawn kiosk was removed.
-- The upstairs Club kiosk was removed. Club remains accessible from the HUD.
for _,node in ipairs(world.Discoveries:GetChildren()) do
    local part=node
    connectPrompt(part,function(p)
        if not P.get(p) or assigned[p] or not cooldown(p,"Explore",2) then return end
        local key=part.Name
        local ok,res=saveAction(p,function(d)
            if d.Explorer[key] then return "OLD" end
            d.Explorer[key]=true
            local n=0 for _ in pairs(d.Explorer) do n=n+1 end
            if n&gt;=5 and not d.ExplorerClaimed then d.ExplorerClaimed=true;d.Coins=d.Coins+200;d.XP=d.XP+120;return "ALL" end
            return "NEW"
        end)
        if ok and res=="ALL" then awardBadge(p,"Explorer");notice(p,"Все 5 знаков найдены: +200 монет и +120 XP!","All 5 emblems found: +200 coins and +120 XP!")
        elseif ok and res=="NEW" then notice(p,"Знак найден! Соберите все пять.","Emblem found! Discover all five.") end
    end)
end
local productAmounts={}
for _,v in pairs(C.Products) do if v.Id&gt;0 then assert(not productAmounts[v.Id],"Duplicate developer product ID");productAmounts[v.Id]=v.Coins end end
for id,coins in pairs(C.RetiredProducts) do assert(not productAmounts[id],"Duplicate retired product ID");productAmounts[id]=coins end
-- Exactly-once grant within the persistent profile, even on replay or concurrent callbacks.
Market.ProcessReceipt=function(receipt)
    local p=Players:GetPlayerByUserId(receipt.PlayerId)
    local amount=productAmounts[receipt.ProductId]
    if closing or not p or not amount or not P.get(p) or not P.isLive() or leaving[p] then return Enum.ProductPurchaseDecision.NotProcessedYet end
    local id=tostring(receipt.PurchaseId)
    local ok,result=P.change(p,function(d)
        if d.Receipts[id] then return "ALREADY" end
        d.Coins=d.Coins+amount
        d.Receipts[id]={Product=receipt.ProductId,At=os.time()}
        -- Do not prune receipts: pruning could duplicate a delayed/replayed grant.
        return "GRANTED"
    end)
    if not ok then return Enum.ProductPurchaseDecision.NotProcessedYet end
    sync(p)
    if result=="GRANTED" then notice(p,"Покупка сохранена: +"..amount.." монет.","Purchase saved: +"..amount.." coins.");analytics(p,"CoinPackGranted",amount) end
    return Enum.ProductPurchaseDecision.PurchaseGranted
end
Market.PromptGamePassPurchaseFinished:Connect(function(p,id,purchased)
    if not purchased or id&lt;=0 or p.Parent~=Players then return end
    -- Only this SERVER Marketplace event may grant a fresh entitlement.
    if id==C.PassIds.VIP then vip[p]=true;appearance(p);sync(p);analytics(p,"ClubPurchased")
    elseif id==C.PassIds.BattlePass then premium[p]=true;sync(p);analytics(p,"PremiumPurchased") end
end)
local function setup(p)
    local ok,err=P.load(p)
    if not ok then p:Kick("Профиль ещё занят или недоступен. Подождите 30 секунд и перезайдите. / Please wait and rejoin.");warn(err);return end
    if p.Parent~=Players or closing then P.close(p);return end
    local function spawned(ch)
        local run=rushRuns[p]
        if run then run.Done=true;rushRuns[p]=nil;p:SetAttribute("SkylineRush",false);fire(p,{Kind="Rush",Active=false}) end
        ch:WaitForChild("HumanoidRootPart",10);task.wait(.2)
        local humanoid=ch:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None end
        if p.Parent~=Players or p.Character~=ch then return end
        local a=assigned[p];local m=a and a.Match
        teleport(p,m and a.Model[m.X==p and "SpawnX" or "SpawnO"] or hub.LobbySpawn);appearance(p)
    end
    p.CharacterAdded:Connect(spawned)
    if p.Character then task.spawn(spawned,p.Character) end
    sync(p);task.spawn(refreshVIP,p);analytics(p,"SessionStarted")
end
Players.PlayerAdded:Connect(setup)
for _,p in ipairs(Players:GetPlayers()) do task.spawn(setup,p) end
Players.PlayerRemoving:Connect(function(p)
    leaving[p]=true;replayRequests[p]=nil;removeQueue(p)
    local a=assigned[p];local m=a and a.Match
    if m and not m.Finished then
        if not closing then
            -- 4.2: finish() уже запускает grantResult для обоих игроков (rewardPending).
            -- Повторный прямой вызов давал двойную запись в DataStore. Ждём ниже.
            finish(a,L.other(m.X==p and "X" or "O"),"DISCONNECT")
        end
    end
    local rewardDeadline=os.clock()+20
    while rewardPending[p] and os.clock()&lt;rewardDeadline do task.wait(.1) end
    assigned[p]=nil
    P.close(p);vip[p]=nil;premium[p]=nil;limits[p]=nil;leaving[p]=nil
    processQueues()
end)
task.spawn(function()
    local ticks=0
    while not closing do
        task.wait(1);ticks=ticks+1
        for _,a in ipairs(arenas) do
            local m=a.Match
            if m and not m.Finished then
                if workspace:GetServerTimeNow()&gt;=m.Deadline then
                    -- No automatic best move and no AFK coin generation.
                    finish(a,L.other(m.Turn),"TIMEOUT")
                else sign(a) end
                for symbol,p in pairs({X=m.X,O=m.O}) do
                    if p then local r=root(p)
                        if r and ((r.Position-a.Model.Center.Position).Magnitude&gt;58 or math.abs(r.Position.Y-a.Model.Center.Position.Y)&gt;20) then teleport(p,a.Model["Spawn"..symbol]) end
                    end
                end
            end
        end
        -- 3.5.0: единственная проверка падений (отдельный скрипт HorizonSafety34 удалён).
        for _,p in ipairs(Players:GetPlayers()) do
            local r=root(p)
            if r and r.Position.Y&lt; -14 then
                local a=assigned[p];local m=a and a.Match
                if m and not m.Finished then teleport(p,a.Model[m.X==p and "SpawnX" or "SpawnO"])
                else teleport(p,hub.LobbySpawn) end
            end
        end
        if ticks%5==0 then processQueues() end
        -- 3.6.0: табло обновляется в общем тике, отдельный цикл больше не нужен.
        if ticks%10==0 and updateRatingBoard then pcall(updateRatingBoard) end
        -- Рейтинги живут в профиле HUD и в глобальной таблице; мёртвый список на 20-м тике удалён.
    end
end)
local nameCache={}
if ordered then task.spawn(function()
    while not closing do
        local ok,pages=pcall(function() return ordered:GetSortedAsync(false,10) end)
        if ok then
            local out={}
            for _,row in ipairs(pages:GetCurrentPage()) do
                local uid=tonumber(row.key)
                local name=uid and nameCache[uid]
                if uid and not name then
                    local success,res=pcall(function() return Players:GetNameFromUserIdAsync(uid) end)
                    if success and type(res)=="string" then name=res;nameCache[uid]=res end
                end
                out[#out+1]={Name=name or "Player",Rating=row.value,UserId=uid}
            end
            globalRows=out
        end
        task.wait(120)
    end
end) end
-- Momentum 2.7.3: читаемый архитектурный рейтинг.
-- 3.4: HUD-only daily gift. The server owns eligibility, saving and duplicate protection.
claimDaily=function(p)
    local day=L.day()
    local ok,res=saveAction(p,function(d)
        if d.LastDaily&gt;=day then return "CLAIMED" end
        d.DailyStreak=d.LastDaily==day-1 and (d.DailyStreak%7+1) or 1
        d.LastDaily=day;d.Coins=d.Coins+C.DailyCoins[d.DailyStreak];L.daily(d,day);return "OK"
    end)
    if ok then notice(p,res=="OK" and "Ежедневная награда получена!" or "Сегодня награда уже получена.",res=="OK" and "Daily reward claimed!" or "Already claimed today.") end
    return ok,res
end
-- 3.5.0: медали проверяются только когда порог уже взят — лишних записей в DataStore нет.
local function checkMedals(p)
    local d=P.get(p);if not d or not Medals.pending(d) then return end
    local ok,res=saveAction(p,function(dd) return {Earned=Medals.check(dd)} end)
    if ok and type(res)=="table" and type(res.Earned)=="table" and #res.Earned&gt;0 then
        for _,medal in ipairs(res.Earned) do medalNotice(p,medal) end
        sync(p)
    end
end
-- Included inside Main: all collection, timing and grants are server-owned.
local rushRewardPending={}
local rushZone=world:WaitForChild("CoinRush322",15)
if rushZone then
    local pad=rushZone:FindFirstChild("StartPad")
    local spots={}
    for _,marker in ipairs(rushZone.Spots:GetChildren()) do
        if marker:IsA("BasePart") then spots[#spots+1]=marker end
    end
    table.sort(spots,function(a,b) return a.Name&lt;b.Name end)
    local function finishRush(p,run,reason)
        if run.Done then return end
        run.Done=true
        if rushRuns[p]==run then rushRuns[p]=nil end
        if p.Parent~=Players then return end
        p:SetAttribute("SkylineRush",false)
        fire(p,{Kind="Rush",Active=false})
        if reason then
            notice(p,"Забег завершён без награды: "..reason,"Run cancelled. Return to the courtyard to try again.")
            return
        end
        if run.Count&gt;=C.CoinRush.Goal then
            -- Never yield the shared collection loop while a profile is saving.
            rushRewardPending[p]=true
            task.defer(function()
            local day=L.day()
            local ok,res=saveAction(p,function(d)
                d.RushBest=math.max(d.RushBest or 0,run.Count)
                if d.RushDay&gt;=day then return "OLD" end
                d.RushDay=day;d.Coins+=C.CoinRush.Coins;d.XP+=C.CoinRush.XP
                return "OK"
            end)
            if ok and res=="OK" then
                notice(p,"Маршрут пройден: +"..C.CoinRush.Coins.." монет и +"..C.CoinRush.XP.." XP.","Route complete: +"..C.CoinRush.Coins.." coins and +"..C.CoinRush.XP.." XP.")
            elseif ok then
                notice(p,"Маршрут пройден. Сегодняшняя награда уже получена.","Route complete. Today's reward was already claimed.")
            end
            rushRewardPending[p]=nil
            if p.Parent==Players then task.spawn(checkMedals,p) end
            end)
        else
            notice(p,"Время вышло: "..run.Count.." / "..C.CoinRush.Goal..". Можно попробовать снова.","Time is up: "..run.Count.." / "..C.CoinRush.Goal..". Try again.")
        end
    end
    local function publish(p,run)
        local marker=spots[run.Count+1]
        fire(p,{Kind="Rush",Active=true,Count=run.Count,Goal=C.CoinRush.Goal,Deadline=run.Deadline,Target=marker and marker.Position})
    end
    local function startRush(p)
        if rushRuns[p] or rushRewardPending[p] or assigned[p] or not P.get(p) or not isAlive(p) or not cooldown(p,"Rush",4) then return end
        if queued[p] or rewardPending[p] then
            notice(p,"Сначала выйди из очереди или дождись сохранения матча.","Leave the queue or wait for your match reward to save first.");return
        end
        if #spots&lt;C.CoinRush.Goal or not root(p) or (root(p).Position-pad.Position).Magnitude&gt;14 then return end
        local now=workspace:GetServerTimeNow()
        local run={Count=0,Done=false,Deadline=now+C.CoinRush.Seconds,Character=p.Character,Last=root(p).Position,LastTime=now,Travel=0}
        rushRuns[p]=run;p:SetAttribute("SkylineRush",true)
        publish(p,run)
        local claimed=P.get(p).RushDay&gt;=L.day()
        notice(p,claimed and "Тренировочный круг: награда за сегодня уже получена." or "Собирай монеты по порядку. Награда — за полный маршрут.",claimed and "Practice lap: today's reward is already claimed." or "Collect each coin in order. Finish the route for your reward.")
    end
    if pad and pad:FindFirstChild("Prompt") then connectPrompt(pad,startRush) end
    -- Poll server positions instead of relying on client-owned Touched events.
    task.spawn(function()
        while not closing do
            task.wait(.1)
            local now=workspace:GetServerTimeNow()
            for p,run in pairs(rushRuns) do
                local r=root(p)
                if not isAlive(p) or p.Character~=run.Character or assigned[p] then
                    finishRush(p,run,"персонаж сменился или начался матч")
                elseif now&gt;=run.Deadline then finishRush(p,run)
                elseif r then
                    local dt=math.max(.01,now-run.LastTime)
                    local moved=(r.Position-run.Last).Magnitude
                    if moved&gt;36*dt+10 or math.abs(r.Position.X)&gt;139 or r.Position.Z&lt;260 or r.Position.Z&gt;366 or r.Position.Y&lt;1 or r.Position.Y&gt;20 then
                        finishRush(p,run,"выход за пределы маршрута")
                    else
                        run.Travel+=moved;run.Last=r.Position;run.LastTime=now
                        local target=spots[run.Count+1]
                        local minTime=run.MinTime or 0
                        if target and now&gt;=minTime and (r.Position-target.Position).Magnitude&lt;=4.5 then
                            run.Count+=1
                            if run.Count&gt;=C.CoinRush.Goal then finishRush(p,run)
                            else
                                local distance=(spots[run.Count+1].Position-target.Position).Magnitude
                                run.MinTime=now+math.max(.2,(distance-9)/28)
                                publish(p,run)
                            end
                        end
                    end
                end
            end
        end
    end)
    Players.PlayerRemoving:Connect(function(p) rushRuns[p]=nil end)
end

-- Rankings remain available in the screen menu. No world displays.
updateRatingBoard=function() end
game:BindToClose(function()
    closing=true
    -- Allow already-finished matches to commit before releasing profile leases.
    local rewardDeadline=os.clock()+12
    while next(rewardPending) and os.clock()&lt;rewardDeadline do task.wait(.1) end
    local pending=0
    for _,p in ipairs(P.players()) do
        pending=pending+1
        task.spawn(function() P.close(p);pending=pending-1 end)
    end
    local deadline=os.clock()+15
    while pending&gt;0 and os.clock()&lt;deadline do task.wait(.1) end
end)
hubState()
print("[Skyline Nexus] v"..C.Version.." ready. Persistence="..tostring(P.isLive()).." Featured="..tostring(V.featured(L.day())))
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX1698">
        <Properties>
          <string name="Name">SkylineSelfTest</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source">-- Runs only in Studio. Offline structural checks do not replace a real playtest.
local Run=game:GetService("RunService")
if not Run:IsStudio() then return end
task.wait(1) -- Runtime architecture scripts may start in any order.
local shared=game:GetService("ReplicatedStorage"):WaitForChild("SkylineShared")
local L=require(shared.Logic)
local C=require(shared.Config)
local world=workspace:WaitForChild("SkylineNexus")
assert(#world.Arenas:GetChildren()==C.ArenaCount,"Arena count mismatch")
assert(#world.Discoveries:GetChildren()==5,"Expected 5 explorer emblems")
local spawns=0
for _,v in ipairs(workspace:GetDescendants()) do if v:IsA("SpawnLocation") and v.Enabled then spawns=spawns+1 end end
assert(spawns==1,"Only the lobby should be a SpawnLocation")
for i=1,C.ArenaCount do
    local a=world.Arenas:FindFirstChild("Arena"..i)
    assert(a and a.Center and a.SpawnX and a.SpawnO)
    for j=1,9 do assert(a.Cells:FindFirstChild("Cell"..j).PlacePrompt) end
end
assert(L.outcome({"X","X","X","O","O","","","",""})=="X")
assert(L.outcome({"X","O","X","X","O","O","O","X","X"})=="DRAW")
assert(L.outcome({"","","","","","","","",""})==nil)
local b={"O","O","","X","X","","","",""}
assert(L.bot(b,"O","Hard",Random.new(24))==3,"Bot must take immediate win")
assert(b[3]=="","Bot search must not mutate board")
assert(L.elo(1000,1000,1,24)==1012)
assert(L.elo(1000,1000,0,24)==988)
assert(L.elo(1000,1000,.5,24)==1000)
assert(L.level(0)==1 and L.level(80)==2 and L.level(320)==3)
assert(world:FindFirstChild("ClubGarden"),"Missing Club Garden")
assert(not world:FindFirstChild("RatingBoard27",true),"World rating board must be removed")
for _,o in ipairs(world:GetDescendants()) do
    assert(not o:IsA("SurfaceGui") and not o:IsA("BillboardGui"),"World text must not return")
    if o:IsA("BasePart") then assert(o.Material~=Enum.Material.Neon,"Neon must not return") end
    if o:IsA("ProximityPrompt") then assert(o.Style==Enum.ProximityPromptStyle.Custom,"Prompt must be screen-space") end
end
assert(not world:FindFirstChild("AtelierRefinement27"),"Floor inlays were rolled back")
for _,o in ipairs(world:GetDescendants()) do assert(not o:IsA("BillboardGui"),"Unexpected billboard") end
assert(not world.Hub:FindFirstChild("BotKiosk"),"Practice kiosk should be removed")
assert(not world.Hub:FindFirstChild("PVPKiosk"),"Duel kiosk should be removed")
assert(shared:FindFirstChild("DesignSystem") and shared:FindFirstChild("UIComponents"),"Missing UI modules")
local ids={}
for _,v in pairs(C.Products) do
    assert(v.Id&gt;=0 and v.Coins&gt;0)
    if v.Id&gt;0 then assert(not ids[v.Id],"Duplicate product id");ids[v.Id]=true end
end
for _,k in ipairs(C.QuestOrder) do assert(type(C.Quests[k])=="table","Quest config missing: "..k) end
assert(type(C.StreakBonus)=="table" and C.StreakBonus.Every&gt;=2 and C.StreakBonus.Coins&gt;0 and C.StreakBonus.XP&gt;=0,"Streak bonus config invalid")
print("[SkylineSelfTest] PASS: hierarchy, 36 cells, single lobby spawn, minimax basics, Elo, XP, product/quest/streak config.")

-- Atelier Tide 2.8 regression checks, executed in Roblox Studio only.
assert(not world.Hub:FindFirstChild("ClubKiosk"),"Club cube must be removed")
assert(shared:FindFirstChild("MatchResult"),"Missing result presentation module")
assert(world:FindFirstChild("GrandFountain28"),"Missing grand fountain")
for i=1,C.ArenaCount do
    local count=0
    for _,o in ipairs(world.Arenas["Arena"..i]:GetDescendants()) do
        if o:IsA("Seat") and o.Name=="SpectatorSeat" then count=count+1 end
    end
    assert(count==8,"Each court needs eight spectator seats")
end
assert(world.Hub.LobbySpawn.CFrame.LookVector.Z&gt;.9,"Arrival spawn should face the atrium")
print("[AtelierTide28] PASS: one rating screen, removed Club cube, 32 spectator seats, result module, spawn direction.")
task.delay(3,function()
    assert(workspace.Terrain:GetAttribute("AtelierOceanVersion")==28,"Native ocean did not initialise; inspect AtelierEnvironmentBoot28")
    assert(world.GrandFountain28:FindFirstChild("WaterEffects28"),"Fountain effects did not initialise")
    print("[AtelierTide28] PASS: native ocean and fountain effects initialised.")
end)

-- Tide Journey 2.9: tests mutate only local, disposable tables.
do
    local G=require(shared.Progression)
    assert(shared:FindFirstChild("JourneyUI"),"Missing JourneyUI")
    assert(C.BattlePass.Tiers==30 and C.BattlePass.XPPerTier&gt;0,"Invalid pass config")
    assert(C.PassIds.VIP==0 or C.PassIds.VIP~=C.PassIds.BattlePass,"Club and Premium must use different IDs")
    local d={Coins=100,XP=0,Owned={Classic=true}}
    G.addXP(d,300)
    assert(G.claimPass(d,1,"Premium",false)=="LOCKED","Premium entitlement bypass")
    assert(G.claimPass(d,1,"Free",false)=="OK","Free claim failed")
    local coins=d.Coins
    assert(G.claimPass(d,1,"Free",false)=="CLAIMED" and d.Coins==coins,"Duplicate reward")
    local premiumCoins=d.Coins
    assert(G.claimPass(d,1,"Premium",true)=="OK","Premium reward not granted")
    assert(d.Coins==premiumCoins+(C.BattlePass.Rewards[1].Premium.Coins or 0),"Premium coin reward mismatch")
    assert(G.claimPass(d,2,"Free",false)=="NOT_READY","Tier gate bypass")
    local xp,first=G.match(d,21000,true,3)
    assert(xp==150 and first,"First-match bonus incorrect")
    xp,first=G.match(d,21000,true,3)
    assert(xp==50 and not first,"Daily bonus duplicated")
    assert(G.claimClub(d,21000,"Welcome",false)=="LOCKED","Club gate bypass")
    assert(G.claimClub(d,21000,"Welcome",true)=="OK","Club welcome failed")
    assert(G.claimClub(d,21000,"Welcome",true)=="CLAIMED","Club welcome repeated")
    for tier=1,C.BattlePass.Tiers do
        for _,track in ipairs({"Free","Premium"}) do
            local reward=C.BattlePass.Rewards[tier][track]
            assert(reward and ((reward.Skin and C.Skins[reward.Skin]) or (reward.Coins and reward.Coins&gt;0)),"Missing reward")
        end
    end
    print("[TideJourney29] PASS: permanent pass, rewards, entitlement gates, first-match bonus, Club, catalog.")
end

-- Tide Horizon 3.0: проверка вариантов правил, затухающих знаков и новых палитр.
do
    local L=require(shared.Logic)
    local V=require(shared.Variants)
    assert(shared:FindFirstChild("Audio"),"Missing Audio module")
    assert(shared:FindFirstChild("Variants"),"Missing Variants module")
    assert(V.valid("Classic") and V.valid("Blitz") and V.valid("Shift"),"Variant registry incomplete")
    assert(not V.valid("Nope") and not V.valid(nil),"Variant validation too permissive")
    assert(V.get("Classic").MaxMarks==0 and V.get("Shift").MaxMarks==3,"Variant rules incorrect")
    assert(V.get(nil).TurnSeconds==V.get("Classic").TurnSeconds,"Variant fallback broken")
    local board,history={"","","","","","","","",""},{X={},O={}}
    for _,index in ipairs({1,4,7}) do L.place(board,history,index,"X",3) end
    assert(L.fading(history,"X",3)==1,"Fading index incorrect")
    assert(L.fading(history,"O",3)==nil,"Fading reported too early")
    assert(L.fading(history,"X",0)==nil,"Classic must never fade")
    local removed=L.place(board,history,5,"X",3)
    assert(removed==1 and board[1]=="" and #history.X==3,"Shift did not retire the oldest mark")
    local rng=Random.new(7)
    local choice=L.shiftBot(board,history,"O","Hard",rng,3)
    assert(choice and board[choice]=="","Shift bot returned an occupied cell")
    print("[TideHorizon30] PASS: variants, fading marks, shift bot, audio modules.")
end

do
    -- 3.1.0 TIDE HORIZON: наборы значков, глифы, рейтинговый экран, площадь старта.
    local glyphModule = shared:FindFirstChild("Glyphs")
    assert(glyphModule, "Glyphs module missing")
    local Gl = require(glyphModule)

    assert(C.Version == "5.0.0", "version should be 5.0.0")
    assert(type(C.Shapes) == "table" and type(C.ShapeOrder) == "table", "shape catalog missing")
    assert(#C.ShapeOrder &gt;= 4, "expected at least 4 mark sets")
    assert(C.Shapes.Classic and C.Shapes.Classic.Price == 0, "Classic set must be free")

    for _, key in ipairs(C.ShapeOrder) do
        local set = C.Shapes[key]
        assert(set, "missing shape set " .. key)
        assert(Gl.valid(set.X) and Gl.valid(set.O), "invalid glyph in set " .. key)
        assert(type(set.RU) == "string" and type(set.EN) == "string", "set needs names: " .. key)
        if key ~= "Classic" then
            assert(set.Price &gt; 0, "paid set needs a price: " .. key)
        end
    end

    assert(Gl.valid("nope") == false, "unknown glyph must be invalid")
    assert(Gl.get("ring").Round == true, "ring must be a round glyph")
    assert(#Gl.get("square").Segments == 4, "square needs 4 segments")
    assert(#Gl.get("triangle").Segments == 3, "triangle needs 3 segments")
    assert(#Gl.get("hex").Segments == 6, "hex needs 6 segments")
    assert(#Gl.get("diamond").Segments == 4, "diamond needs 4 segments")
    assert(#Gl.get("cross").Segments == 2, "cross needs 2 segments")

    assert(Gl.kind(C.Shapes.Blocks, "X") == "square", "Blocks X should be a square")
    assert(Gl.kind(C.Shapes.Blocks, "O") == "triangle", "Blocks O should be a triangle")
    assert(Gl.kind(nil, "X") == "cross", "missing set falls back to cross")
    assert(Gl.kind({}, "O") == "ring", "missing set falls back to ring")

    assert(C.Skins.Ember == nil and C.Skins.Frostfire == nil, "coin palettes from 3.0 should be gone")
    assert(C.Skins.Verdant == nil and C.Skins.Monochrome == nil, "coin palettes from 3.0 should be gone")
    assert(C.Skins.Classic and C.Skins.Aurora, "base palettes must stay")

    assert(not script.Parent:FindFirstChild("BoardRender31"), "World renderer must be removed")
    assert(world.Hub:FindFirstChild("TideHorizonPlaza31"), "Static arrival plaza missing")

    local hubFolder = workspace:WaitForChild("SkylineNexus"):WaitForChild("Hub")
    local spawnPad = hubFolder:FindFirstChild("LobbySpawn")
    assert(spawnPad and spawnPad:IsA("SpawnLocation"), "LobbySpawn must stay a SpawnLocation")

    print("[TideHorizon31] PASS: наборы значков, глифы, рейтинговый экран, площадь старта.")
end

do
    -- 3.2.0 TIDE HORIZON: рейтинг-парк, подиум топ-3, блиц 5 секунд, новые иконки.
    local shared32 = game:GetService("ReplicatedStorage"):WaitForChild("SkylineShared")
    local Variants32 = require(shared32:WaitForChild("Variants"))

    assert(Variants32.Rules.Blitz.TurnSeconds == 5, "blitz must be 5 seconds")
    assert(Variants32.Rules.Classic.TurnSeconds == 20, "classic stays at 20 seconds")
    assert(string.find(Variants32.describe("Blitz", true), "5") ~= nil, "blitz description must mention 5")
    assert(Variants32.Rules.Blitz.RewardMult &gt; 1, "blitz keeps a reward bonus")

    assert(not world:FindFirstChild("RankingPark32"),"Statistics hall must not return")
    assert(not game:GetService("ServerScriptService"):FindFirstChild("StatsPavilion42"),"Hall generator must be removed")
    local rush=world:WaitForChild("CoinRush322")
    assert(#rush.Spots:GetChildren()==C.CoinRush.Goal,"Full courtyard circuit must exist")
    assert(rush.StartPad.Prompt.Style==Enum.ProximityPromptStyle.Custom,"Screen interaction required")
    assert(rush.LimestoneCourt.Size.X&gt;=280 and rush.LimestoneCourt.Size.Z&gt;=110,"Courtyard footprint")
    assert(shared32:FindFirstChild("Notifications"),"Notification system missing")
    print("[Courtyard50] PASS: hall removed, screen prompts, full courtyard route.")
end

-- Horizon 3.4: pure HUD state must follow UTC without granting anything.
do
    local S=require(shared.HUDState34)
    local now=21000*86400+10
    local p={LastDaily=20999,DailyStreak=7}
    local status=S.daily(p,now)
    assert(status.Day==1 and not status.Claimed and status.Amount==C.DailyCoins[1],"Daily streak rollover")
    p.LastDaily=21000;p.DailyStreak=3
    assert(S.daily(p,now).Claimed,"Claimed gift state")
    assert(not S.daily(p,21001*86400).Claimed,"UTC gift reset")
    assert(S.clock(3661)=="01:01:01","Countdown format")
    print("[Horizon34] PASS: HUD-only gift, removed spawn sign, daily UTC state.")
end

-- Horizon 3.5: медали, режим дня и объединённые серверные циклы.
do
    local box=game:GetService("ReplicatedStorage"):WaitForChild("SkylineShared")
    local Cfg=require(box.Config)
    local Vr=require(box.Variants)
    local Med=require(script.Parent.Milestones35)
    assert(Cfg.Version=="5.0.0","version must be 5.0.0")
    assert(#Cfg.MedalOrder==12,"medal order must list every medal")
    for _,key in ipairs(Cfg.MedalOrder) do
        local medal=Cfg.Medals[key]
        assert(medal and medal.Goal&gt;0 and medal.Coins&gt;0 and medal.RU and medal.EN,"broken medal: "..key)
    end
    local d={Games=100,Wins=60,BestStreak=9,Rating=1400,RushBest=12,Coins=0,XP=0,
        Explorer={a=true,b=true,c=true,d=true,e=true}}
    assert(Med.pending(d),"a strong profile must have pending medals")
    local earned=Med.check(d)
    assert(#earned&gt;0 and d.Coins&gt;0 and d.XP&gt;0,"medals must pay out once")
    assert(#Med.check(d)==0 and not Med.pending(d),"medals must never pay twice")
    local rows,done=Med.snapshot(d)
    assert(#rows==#Cfg.MedalOrder and done==#earned,"snapshot must mirror the medal wall")
    assert(rows[1].Goal&gt;0 and rows[1].Value&lt;=rows[1].Goal,"snapshot must clamp progress")
    local fresh={Games=0,Wins=0,BestStreak=0,Rating=1000,RushBest=0,Coins=0,XP=0,Explorer={}}
    assert(not Med.pending(fresh) and #Med.check(fresh)==0,"a fresh profile earns nothing")
    assert(Vr.valid(Vr.featured(0)) and Vr.featured(1)~=Vr.featured(0),"featured mode must rotate daily")
    assert(Vr.featured(3)==Vr.featured(0),"featured mode must be stable per day")
    assert(Cfg.DailyFeature.Mult&gt;1,"featured mode must pay more")
    assert(game:GetService("ServerScriptService"):FindFirstChild("HorizonSafety34")==nil,"fall recovery is merged into Main")
    print("[Horizon35] PASS: медали, режим дня, объединённые циклы и кэш рейтинг-борда.")
end

-- Horizon 3.6: статистика по режимам и зал медалей.
do
    local box=game:GetService("ReplicatedStorage"):WaitForChild("SkylineShared")
    local Cfg=require(box.Config)
    local Vr=require(box.Variants)
    assert(Cfg.Version=="5.0.0","version must be 5.0.0")
    local Pr=require(script.Parent.Profiles)
    assert(game:GetService("ServerScriptService"):FindFirstChild("MedalWall36")==nil,"Medals remain in menu, not on walls")
    local fake={Games=0,VariantStats={}}
    for _,key in ipairs(Vr.Order) do
        fake.VariantStats[key]={Games=2,Wins=1,Draws=0}
        assert(Vr.valid(key),"variant order must stay valid: "..key)
    end
    local total=0
    for _,entry in pairs(fake.VariantStats) do total=total+entry.Games end
    assert(total==#Vr.Order*2,"per-variant stats must cover every mode")
    assert(type(Pr)=="table","profiles module must load")
    print("[Horizon36] PASS: статистика по режимам, зал медалей, единый серверный тик.")
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_ATELIER_25_REWARDS">
        <Properties>
          <string name="Name">MatchRewards</string>
          <ProtectedString name="Source">-- Pure mutation of the transaction's private profile copy. No yields or side effects.
-- Match receipts and balances are committed together by Profiles.change / UpdateAsync.
local shared=game:GetService("ReplicatedStorage"):WaitForChild("SkylineShared")
local C=require(shared.Config)
local L=require(shared.Logic)
local G=require(shared.Progression)
local V=require(shared.Variants)
local Med=require(script.Parent.Milestones35)
local R={}
function R.apply(d,m,symbol,hour)
    local existing=d.MatchGrants[m.Id]
    if existing then
        if type(existing)=="table" then return L.copy(existing),"ALREADY" end
        return {Id=m.Id,Coins=0,XP=0,RatingDelta=0,Rated=false,Reason="LEGACY",Unknown=true},"ALREADY"
    end
    local win=m.Result==symbol
    local draw=m.Result=="DRAW"
    local opponent=m[L.other(symbol)]
    local manual=m.Manual[symbol] or 0
    local enough=(m.Duration or 0)&gt;=C.MinRewardSeconds and manual&gt;=2 and m.Reason~="CANCELLED"
    local reward=C.Rewards[m.Mode=="PVP" and "PVP" or m.Difficulty]
    local requested=enough and (win and reward.Win or (draw and reward.Draw or reward.Loss)) or 0
    requested=math.floor(requested*V.get(m.Variant).RewardMult+.5)
    -- 3.5.0: режим дня считается от серверного дня матча, так что повтор транзакции безопасен.
    local featured=C.DailyFeature~=nil and V.featured(m.RewardDay or 0)==(m.Variant or "Classic")
    if featured and requested&gt;0 then requested=math.floor(requested*C.DailyFeature.Mult+.5) end
    if d.RewardHour~=hour then d.RewardHour=hour;d.RewardCount=0 end
    if d.PairHour~=hour then d.PairHour=hour;d.Pairs={} end
    local pairKey=opponent and tostring(opponent.UserId) or nil
    local pairOK=not pairKey or (d.Pairs[pairKey] or 0)&lt;C.PairRatedMatchesPerHour
    local hourlyOK=d.RewardCount&lt;C.RewardedMatchesPerHour
    local awarded=(hourlyOK and pairOK) and requested or 0
    local reason="OK"
    if m.Reason=="CANCELLED" then reason="CANCELLED"
    elseif (m.Duration or 0)&lt;C.MinRewardSeconds then reason="SHORT_MATCH"
    elseif manual&lt;2 then reason="TOO_FEW_MOVES"
    elseif not pairOK then reason="PAIR_LIMIT"
    elseif not hourlyOK then reason="HOURLY_LIMIT" end
    local beforeRating=d.Rating
    local actualRated=m.Rated==true and pairOK
    if m.Mode=="PVP" and pairKey then d.Pairs[pairKey]=(d.Pairs[pairKey] or 0)+1 end
    if actualRated then
        d.Rating=L.elo(m.Ratings[symbol],m.Ratings[L.other(symbol)],win and 1 or (draw and .5 or 0),C.KFactor)
        d.RankedGames=d.RankedGames+1
    end
    d.Games=d.Games+1
    -- 3.6.0: разбивка статистики по вариантам правил.
    if type(d.VariantStats)~="table" then d.VariantStats={} end
    local vkey=V.valid(m.Variant) and m.Variant or "Classic"
    local vstat=d.VariantStats[vkey]
    if type(vstat)~="table" then vstat={Games=0,Wins=0,Draws=0};d.VariantStats[vkey]=vstat end
    vstat.Games=(vstat.Games or 0)+1
    if win then vstat.Wins=(vstat.Wins or 0)+1 elseif draw then vstat.Draws=(vstat.Draws or 0)+1 end
    if win then d.Wins=d.Wins+1;d.Streak=d.Streak+1
    elseif draw then d.Draws=d.Draws+1
    else d.Losses=d.Losses+1;d.Streak=0 end
    d.BestStreak=math.max(d.BestStreak,d.Streak)
    d.Coins=d.Coins+awarded
    local earnedXP=0
    if awarded&gt;0 then
        earnedXP=reward.XP+(win and 20 or 0)
        d.RewardCount=d.RewardCount+1;d.XP=d.XP+earnedXP
        -- Server supplied the UTC day; callbacks can safely re-run without a time read.
        L.daily(d,m.RewardDay)
        d.QuestProgress.Games=d.QuestProgress.Games+1
        d.QuestProgress.Moves=d.QuestProgress.Moves+manual
        if win then d.QuestProgress.Wins=d.QuestProgress.Wins+1 end
    end
    -- Momentum: бонус за каждую N-ю победу подряд, только если матч вообще дал награду.
    local streak=0
    if win and awarded&gt;0 and C.StreakBonus and d.Streak&gt;0 and d.Streak%C.StreakBonus.Every==0 then
        streak=d.Streak
        awarded=awarded+C.StreakBonus.Coins
        earnedXP=earnedXP+C.StreakBonus.XP
        d.Coins=d.Coins+C.StreakBonus.Coins;d.XP=d.XP+C.StreakBonus.XP
    end
    local passXP,firstMatch=0,false
    if awarded&gt;0 then passXP,firstMatch=G.match(d,m.RewardDay,win,manual) end
    local medals=Med.check(d)
    local receipt={Medals=(#medals&gt;0) and medals or nil,Featured=featured or nil,PassXP=passXP,FirstMatch=firstMatch,Id=m.Id,Coins=awarded,XP=earnedXP,RatingDelta=d.Rating-beforeRating,Rated=actualRated,Reason=reason,Streak=streak&gt;0 and streak or nil}
    d.MatchGrants[m.Id]=L.copy(receipt);d.MatchOrder[#d.MatchOrder+1]=m.Id
    while #d.MatchOrder&gt;100 do d.MatchGrants[table.remove(d.MatchOrder,1)]=nil end
    return receipt,"GRANTED"
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX95002">
        <Properties>
          <string name="Name">Milestones35</string>
          <ProtectedString name="Source">-- Skyline 3.5 · Медали: одноразовые достижения.
-- Чистый модуль: мутирует только переданную копию профиля внутри транзакции Profiles.change.
-- Никаких yield-ов, событий и обращений к сервисам — безопасно перезапускать при повторе UpdateAsync.
local shared=game:GetService("ReplicatedStorage"):WaitForChild("SkylineShared")
local C=require(shared.Config)
local M={}

local function count(map)
	local n=0
	if type(map)=="table" then for _ in pairs(map) do n=n+1 end end
	return n
end

local function value(d,field)
	if field=="Explorer" then return count(d.Explorer) end
	local v=d[field]
	return type(v)=="number" and v or 0
end
M.value=value

function M.ensure(d)
	if type(d.Medals)~="table" then d.Medals={} end
	return d.Medals
end

-- Дешёвая проверка без записи: вызывается перед транзакцией, чтобы не трогать DataStore зря.
function M.pending(d)
	if type(d)~="table" then return false end
	local owned=type(d.Medals)=="table" and d.Medals or nil
	for _,key in ipairs(C.MedalOrder) do
		local medal=C.Medals[key]
		if medal and not (owned and owned[key]==true) and value(d,medal.Field)&gt;=medal.Goal then return true end
	end
	return false
end

function M.check(d)
	local owned=M.ensure(d)
	local earned={}
	for _,key in ipairs(C.MedalOrder) do
		local medal=C.Medals[key]
		if medal and owned[key]~=true and value(d,medal.Field)&gt;=medal.Goal then
			owned[key]=true
			d.Coins=math.max(0,math.floor((d.Coins or 0)+medal.Coins))
			d.XP=math.max(0,math.floor((d.XP or 0)+medal.XP))
			earned[#earned+1]={Key=key,RU=medal.RU,EN=medal.EN,Coins=medal.Coins,XP=medal.XP}
		end
	end
	return earned
end

-- Снимок для клиента: порядок фиксирован конфигом, прогресс обрезан по цели.
function M.snapshot(d)
	local owned=type(d.Medals)=="table" and d.Medals or {}
	local out,done={},0
	for _,key in ipairs(C.MedalOrder) do
		local medal=C.Medals[key]
		if medal then
			local have=owned[key]==true
			if have then done=done+1 end
			out[#out+1]={Key=key,Done=have,Value=math.min(math.floor(value(d,medal.Field)),medal.Goal),Goal=medal.Goal}
		end
	end
	return out,done
end

return M
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="RBX1697">
      <Properties>
        <string name="Name">READ_ME_FIRST</string>
        <ProtectedString name="Source">--[[
SKYLINE NEXUS 5.0 / COURTYARD

Откройте Skyline_Nexus_v5_Courtyard.rbxlx целиком через File &gt; Open from File.
Исходная карта 4.3 сохранена отдельно и не перезаписывается сборкой.
HUD появляется в Play: его создают клиентские скрипты.

Изменения:
* Удалены зал статистики, его генераторы, вход, вывески и надписи в мире.
  Остекление фасада и ограждение на месте прежнего входа восстановлены.
  Рейтинг и достижения остаются в экранном меню.
* Новый двор 280 x 110 studs продолжает сад: каменное мощение, деревья,
  перголы, посадочные места, тёплый свет и стеклянные ограждения, без неона.
* Забег: 20 последовательных персональных монет за 80 секунд.
  Старт — латунная площадка за садом; взаимодействие показано на экране.
  Сервер проверяет порядок, расстояние, границы и время; при смене
  персонажа забег отменяется. Очередь/матч и забег несовместимы.
  Награда раз в сутки; повторные круги тренировочные. Размер награды прежний.
* Новый HUD, боковая навигация большого экрана, компактная навигация,
  общая спокойная палитра, закрываемые уведомления с очередью и таймером.
* Взаимодействия перенесены в экранные карточки; скрытые подсказки
  отключаются в меню, фоторежиме и во время забега.

Управление: M — меню, R — награды, Q — поле матча,
P — скрыть/вернуть HUD, H — лобби (вне меню и матча).
На сенсорном устройстве используйте экранные кнопки.

Сохранение и экономика:
Имена DataStore, модуль Profiles, баланс наград и ID товаров сохранены.
StudioPersistence=false: тест в Studio не записывает постоянный прогресс.
Нулевые ID покупок не заменены выдуманными значениями.

Проверка:
py tools/validate_redesign.py — структура XML, ссылки, синтаксис Luau,
отсутствие мировых надписей/неона, связи исходников и геометрия маршрута.
Это НЕ исполнение Roblox Engine. Актуальные результаты: build/validation.json.
Перед публикацией нужны Play Solo, локальный сервер с двумя игроками,
Device Emulator, проверка сохранений в отдельном тестовом experience.
Чек-лист находится рядом с картой в README_COURTYARD.md.
]]
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_TIDE28_00645">
      <Properties>
        <string name="Name">AtelierEnvironment28</string>
        <ProtectedString name="Source">-- Atelier Tide 2.8. Native Terrain water. Safe to run again, never clears Terrain.
-- In Studio EDIT mode: require(game.ServerScriptService.AtelierEnvironment28).Build()
local M={}
local building=false
function M.Build()
    if building then return end
    building=true
    local ok,err=pcall(function()
        local terrain=workspace.Terrain
        terrain.WaterColor=Color3.fromRGB(34,108,120)
        terrain.WaterReflectance=.42
        terrain.WaterTransparency=.32
        terrain.WaterWaveSize=.16
        terrain.WaterWaveSpeed=9
        if terrain:GetAttribute("AtelierOceanVersion")~=28 then
            -- 4-stud aligned volume, water surface Y=-8. No camera-dependent recolouring.
            for x=-1024,768,256 do
                for z=-1024,768,256 do
                    terrain:FillBlock(CFrame.new(x+128,-20,z+128),Vector3.new(256,24,256),Enum.Material.Water)
                end
            end
            terrain:SetAttribute("AtelierOceanVersion",28)
        end
        local world=workspace:FindFirstChild("SkylineNexus")
        local city=world and world:FindFirstChild("City")
        local preview=city and city:FindFirstChild("OceanPreview28")
        if preview then preview.Transparency=1;preview.CanCollide=false;preview.CanQuery=false end
        local fountain=world and world:FindFirstChild("GrandFountain28")
        if not fountain then return end
        -- 3.2.2: центр эффектов берём из геометрии фонтана, а не из жёстких координат.
        local core=fountain:FindFirstChild("UpperColumn") or fountain:FindFirstChild("CrownNozzle") or fountain.PrimaryPart
        local centre=core and Vector3.new(core.Position.X,0,core.Position.Z) or Vector3.new(0,0,-48)
        local builtFx=fountain:FindFirstChild("WaterEffects28")
        if builtFx then
            local builtAnchor=builtFx:FindFirstChild("FountainEffectsAnchor")
            if builtAnchor then builtAnchor.CFrame=CFrame.new(centre) end
            return
        end
        local fx=Instance.new("Folder");fx.Name="WaterEffects28"
        local anchor=Instance.new("Part")
        anchor.Name="FountainEffectsAnchor";anchor.Size=Vector3.new(.2,.2,.2)
        anchor.Anchored=true;anchor.Transparency=1;anchor.CanCollide=false;anchor.CanTouch=false;anchor.CanQuery=false
        anchor.CFrame=CFrame.new(centre);anchor.Parent=fx
        local function attachment(name,position,tangent)
            local a=Instance.new("Attachment");a.Name=name
            local right=tangent.Unit
            local seed=math.abs(right.Y)&gt;.98 and Vector3.new(1,0,0) or Vector3.new(0,1,0)
            local back=right:Cross(seed).Unit
            local up=back:Cross(right).Unit
            a.CFrame=CFrame.fromMatrix(position,right,up,back);a.Parent=anchor
            return a
        end
        for i=1,12 do
            local angle=2*math.pi*i/12
            local r=Vector3.new(math.cos(angle),0,math.sin(angle))
            local p0=r*3.4+Vector3.new(0,15.2,0)
            local p1=r*5.3+Vector3.new(0,23,0)
            local p2=r*11.5+Vector3.new(0,17,0)
            local p3=r*13.7+Vector3.new(0,5.05,0)
            local a=attachment("JetStart"..i,p0,p1-p0)
            local b=attachment("JetEnd"..i,p3,p3-p2)
            local beam=Instance.new("Beam");beam.Name="FountainJet28"
            beam.Attachment0=a;beam.Attachment1=b
            beam.CurveSize0=(p1-p0).Magnitude;beam.CurveSize1=(p3-p2).Magnitude
            beam.Width0=.16;beam.Width1=.25;beam.Segments=20;beam.FaceCamera=true
            beam.Color=ColorSequence.new(Color3.fromRGB(169,226,231),Color3.fromRGB(225,248,242))
            beam.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.18),NumberSequenceKeypoint.new(.8,.26),NumberSequenceKeypoint.new(1,.55)})
            beam.LightEmission=.18;beam.LightInfluence=.65;beam.Parent=anchor
            local emitter=Instance.new("ParticleEmitter");emitter.Name="FountainMist28"
            emitter.Texture="rbxasset://textures/particles/smoke_main.dds"
            emitter.Color=ColorSequence.new(Color3.fromRGB(202,235,231))
            emitter.Rate=4;emitter.Lifetime=NumberRange.new(.55,1.1)
            emitter.Speed=NumberRange.new(1,3.2);emitter.SpreadAngle=Vector2.new(28,28)
            emitter.Acceleration=Vector3.new(0,-3,0)
            emitter.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.18),NumberSequenceKeypoint.new(.5,.55),NumberSequenceKeypoint.new(1,.9)})
            emitter.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.2,.72),NumberSequenceKeypoint.new(1,1)})
            emitter.LightInfluence=.7;emitter.LightEmission=.05;emitter.Parent=b
        end
        -- Vertical centre plume, inexpensive soft droplets using a bundled Roblox texture.
        local crown=Instance.new("Attachment");crown.Name="CrownSource";crown.Position=Vector3.new(0,17.2,0);crown.Parent=anchor
        local spray=Instance.new("ParticleEmitter");spray.Name="FountainMist28"
        spray.Texture="rbxasset://textures/particles/smoke_main.dds";spray.Rate=18
        spray.Color=ColorSequence.new(Color3.fromRGB(204,239,237))
        spray.Lifetime=NumberRange.new(.6,.95);spray.Speed=NumberRange.new(15,20)
        spray.Acceleration=Vector3.new(0,-32,0);spray.SpreadAngle=Vector2.new(8,8)
        spray.Size=NumberSequence.new(.22)
        spray.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.3),NumberSequenceKeypoint.new(.7,.45),NumberSequenceKeypoint.new(1,1)})
        spray.LightInfluence=.65;spray.Parent=crown
        fx.Parent=fountain
    end)
    building=false
    if not ok then error(err) end
end
return M
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX_TIDE28_00646">
      <Properties>
        <string name="Name">AtelierEnvironmentBoot28</string>
        <bool name="Disabled">false</bool>
