    local indicator=U.new("Frame",{Name="ActiveIndicator",BackgroundColor3=navAccent[key],BackgroundTransparency=.05,AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,1,-5),Size=UDim2.fromOffset(42,4),Visible=false,ZIndex=b.ZIndex+2},b);U.round(indicator,3)
    local iconTile=U.new("Frame",{Name="IconTile",AnchorPoint=Vector2.new(.5,0),Position=UDim2.new(.5,0,0,6),Size=UDim2.fromOffset(32,32),BackgroundColor3=navAccent[key],BackgroundTransparency=.9,ZIndex=b.ZIndex+1},b);U.round(iconTile,10)
    local icon=U.icon(b,key,K.Muted);icon.AnchorPoint=Vector2.new(.5,0);icon.Position=UDim2.new(.5,0,0,9);icon.ZIndex=b.ZIndex+1;icon.Position=UDim2.new(.5,0,0,9)
    local label=T(b,"",10,K.Muted,F.Strong,2,39,-4,18);label.TextXAlignment=Enum.TextXAlignment.Center;label.ZIndex=b.ZIndex+1
    local badge=U.text(b,"",8,K.Ink,F.Strong);badge.Name="ReadyCount";badge.BackgroundTransparency=0;badge.BackgroundColor3=navAccent[key];badge.AnchorPoint=Vector2.new(1,0);badge.Position=UDim2.new(1,-4,0,5);badge.Size=UDim2.fromOffset(18,18);badge.TextXAlignment=Enum.TextXAlignment.Center;badge.Visible=false;badge.ZIndex=b.ZIndex+3;U.round(badge,9)
    b.MouseEnter:Connect(function() Tween:Create(scale,TweenInfo.new(.14,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Scale=1.055}):Play();Tween:Create(iconTile,TweenInfo.new(.14),{BackgroundTransparency=.72}):Play();Tween:Create(b,TweenInfo.new(.14),{BackgroundTransparency=b:GetAttribute("Active") and .04 or .18}):Play() end)
    b.MouseLeave:Connect(function() Tween:Create(scale,TweenInfo.new(.16,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Scale=1}):Play();Tween:Create(iconTile,TweenInfo.new(.16),{BackgroundTransparency=b:GetAttribute("Active") and .78 or .92}):Play();Tween:Create(b,TweenInfo.new(.16),{BackgroundTransparency=b:GetAttribute("Active") and .08 or .58}):Play() end)
    nav[key]={Button=b,Icon=icon,IconTile=iconTile,Label=label,Badge=badge,Indicator=indicator,Accent=navAccent[key]}
end
local function layoutNavDock()
    local width=dock.Size.X.Offset;local pad=7;local gap=5;local tabWidth=(width-pad*2-gap*5)/6
    dockBackdrop.Size=UDim2.fromOffset(width,dock.Size.Y.Offset)
    for i,key in ipairs(pages) do
        local v=nav[key];local x=pad+(i-1)*(tabWidth+gap)
        v.Button.Position=UDim2.fromOffset(math.floor(x),5);v.Button.Size=UDim2.fromOffset(math.floor(tabWidth),dock.Size.Y.Offset-10)
        v.Label.Position=UDim2.fromOffset(2,39);v.Label.Size=UDim2.new(1,-4,0,18)
    end
end
local function updateNav()
    local names={Play=match and tr("Поле","Board") or tr("Играть","Play"),Shop=(dock.AbsoluteSize.X&lt;500 and tr("Стиль","Style") or tr("Коллекция","Collection")),Pass=tr("Пасс","Pass"),Quests=tr("Награды","Rewards"),Club=tr("Клуб","Club"),Profile=tr("Профиль","Profile")}
    local rewards,passReady=HUDState.ready(profile,workspace:GetServerTimeNow())
    for key,v in pairs(nav) do
        local active=(menuOpen and (page==key or (page=="Tutorial" and key=="Play"))) or (key=="Play" and match and boardOpen and not menuOpen)
        local count=key=="Quests" and rewards or (key=="Pass" and passReady or 0)
        v.Button:SetAttribute("Active",active);v.Badge.Visible=count&gt;0;v.Badge.Text=count&gt;9 and "9+" or tostring(count)
        v.Button.BackgroundColor3=active and K.Raised or K.Ink;v.Button.BackgroundTransparency=active and .08 or .58
        v.Indicator.Visible=active;v.Indicator.BackgroundColor3=v.Accent;v.IconTile.BackgroundTransparency=active and .78 or .92
        v.Label.Text=names[key];v.Label.TextColor3=active and K.Text or K.Muted;U.tintIcon(v.Icon,active and v.Accent or K.Muted);v.Badge.BackgroundColor3=v.Accent
    end
end
local scrim=U.new("TextButton",{Text="",BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=.45,Size=UDim2.fromScale(1,1),ZIndex=40,Visible=false,AutoButtonColor=false,Selectable=false},gui)
scrim.Activated:Connect(function() closeMenu() end)
local window=U.frame(gui,K.Ink,12);window.ZIndex=50;window.Active=true;window.Visible=false;window.AnchorPoint=Vector2.new(.5,.5);window.Position=UDim2.new(.5,0,.5,-3);window.Size=UDim2.fromOffset(856,584);window.ClipsDescendants=true;U.stroke(window,K.Border,.48)
local windowScale=U.new("UIScale",{Scale=1},window)
local pageAccent=U.new("Frame",{Name="PageAccent",Position=UDim2.fromOffset(22,102),Size=UDim2.new(1,-44,0,2),BackgroundColor3=K.Gold,ZIndex=window.ZIndex+2},window);U.round(pageAccent,2)
local eyebrow=T(window,"",10,K.Gold,F.Strong,24,15,-88,15)
local heading=T(window,"",30,K.Text,F.Display,22,35,-87,38)
local subheading=T(window,"",13,K.Muted,F.Body,24,76,-48,33)
heading.TextWrapped=false;heading.TextTruncate=Enum.TextTruncate.AtEnd
local close=U.button(window,"","secondary",function() closeMenu() end);close.AnchorPoint=Vector2.new(1,0);close.Position=UDim2.new(1,-18,0,18);close.Size=UDim2.fromOffset(42,42)
local closeIcon=U.icon(close,"Close",K.Muted);closeIcon.Position=UDim2.fromOffset(9,9)
local scroll=U.new("ScrollingFrame",{BackgroundTransparency=1,Position=UDim2.fromOffset(22,112),Size=UDim2.new(1,-44,1,-130),CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y,ScrollBarThickness=3,ScrollBarImageColor3=K.Gold,BorderSizePixel=0},window)
local contentList=U.new("UIListLayout",{Padding=UDim.new(0,16),SortOrder=Enum.SortOrder.LayoutOrder},scroll)
U.new("UIPadding",{PaddingRight=UDim.new(0,6),PaddingBottom=UDim.new(0,8)},scroll)
local order=0
local function section(height,color,plain)
    order=order+1
    local f=U.frame(scroll,color or K.Surface,12);f.Size=UDim2.new(1,0,0,height);f.LayoutOrder=order
    if plain then f.BackgroundTransparency=1 end
    return f
end
local function note(value,height,color)
    local f=section(height or 54,K.Surface,true)
    T(f,value,13,color or K.Muted,F.Body,2,3,-8,(height or 54)-6)
    return f
end
local function buttonAt(parent,label,style,fn,x,y,w,h)
    local b=U.button(parent,label,style,fn);b.Position=UDim2.fromOffset(x,y);b.Size=UDim2.new(1,w,0,h or 44);return b
end
local function visibleWidth() return math.max(180,scroll.AbsoluteSize.X-6) end
local priceCache={}
local purchaseBusy=false
local function price(id,kind,callback)
    local key=kind..":"..id
    if priceCache[key] then callback(priceCache[key]);return end
    task.spawn(function()
        local ok,v=pcall(function() return Market:GetProductInfoAsync(id,kind=="PASS" and Enum.InfoType.GamePass or Enum.InfoType.Product) end)
        if ok and v and v.IsForSale and type(v.PriceInRobux)=="number" then priceCache[key]=v;callback(v) else callback(nil) end
    end)
end
local function purchase(id,kind)
    if purchaseBusy then return end
    if id&lt;=0 or not profile or not profile.Persistent then notify(tr("Покупки пока недоступны.","Purchases are not available yet."));return end
    purchaseBusy=true
    task.spawn(function()
        local ok=pcall(function()
            local v=Market:GetProductInfoAsync(id,kind=="PASS" and Enum.InfoType.GamePass or Enum.InfoType.Product)
            assert(v.IsForSale,"Not for sale")
            if kind=="PASS" then Market:PromptGamePassPurchase(player,id) else Market:PromptProductPurchase(player,id) end
        end)
        if not ok then notify(tr("Не удалось открыть покупку. Попробуй позже.","Could not open the purchase. Try again later.")) end
        task.delay(2,function() purchaseBusy=false end)
    end)
end
local function priceButton(b,id,kind,prefix)
    local idGeneration=generation
    price(id,kind,function(v)
        if not b.Parent or generation~=idGeneration then return end
        b.Text=v and ((prefix or "")..number(v.PriceInRobux).." R$") or tr("Недоступно","Unavailable")
        U.disabled(b,not v or not profile or not profile.Persistent)
    end)
end
local function join(mode,level,rules)
    send("Queue",{Mode=mode,Difficulty=level,Variant=rules});closeMenu()
end
local function signed(n)
    n=math.floor(tonumber(n) or 0)
    return n&gt;=0 and ("+"..n) or tostring(n)
end
local function resultName(m)
    return m.Result=="DRAW" and tr("Ничья","Draw") or (m.Result==m.Symbol and tr("Победа","Victory") or tr("Поражение","Defeat"))
end
local function receiptSummary(receipt)
    if not receipt then return tr("Подводим итоги…","Wrapping up…") end
    if receipt.Unknown then return tr("Матч учтён ранее","Previously recorded") end
    local value="+"..number(receipt.Coins)..tr(" мон."," coins").."  ·  +"..number(receipt.XP or 0).." XP"
    if receipt.Rated then value=value.."  ·  "..signed(receipt.RatingDelta)..tr(" рейт."," rating") end
    if receipt.Streak then value=value.."  ·  "..tr("серия x","streak x")..number(receipt.Streak) end
    return value
end
local function receiptReason(receipt)
    if not receipt then return tr("Ожидаем подтверждение сервера","Waiting for server confirmation") end
    local labels={
        SHORT_MATCH=tr("Без монет: матч короче 14 секунд","No coins: match shorter than 14 seconds"),
        TOO_FEW_MOVES=tr("Без монет: меньше двух твоих ходов","No coins: fewer than two of your moves"),
        PAIR_LIMIT=tr("Достигнут часовой лимит этой пары","Hourly limit for this opponent reached"),
        HOURLY_LIMIT=tr("Часовой лимит наград достигнут","Hourly reward limit reached"),
        CANCELLED=tr("Матч отменён","Match cancelled"),
        LEGACY=tr("Старый результат, без детализации","Older result, no detailed receipt"),
    }
    return labels[receipt.Reason] or (receipt.Persisted and tr("Прогресс сохранён","Progress saved") or tr("Тестовый профиль, без сохранения","Test profile, not saved"))
end
local function rememberMatch(data)
    for _,m in ipairs(recentMatches) do if m.Id==data.Id then return end end
    recentMatches[#recentMatches+1]={Id=data.Id,Opponent=data.Opponent,Result=data.Result,Symbol=data.Symbol,Mode=data.Mode,Receipt=receiptCache[data.Id]}
    while #recentMatches&gt;5 do table.remove(recentMatches,1) end
end
local function refreshCourts()
    if not playHubText or not playHubText.Parent then return end
    local free=0
    for _,court in ipairs(hub.Courts) do
        if not court.Busy then free=free+1 end
        local v=courtIndicators[court.Id]
        if v and v.Label.Parent then
            v.Label.Text=court.Busy and tr("Матч","Busy") or tr("Готова","Open")
            v.Label.TextColor3=court.Busy and K.Muted or K.Sage
            v.Box.BackgroundColor3=court.Busy and K.Raised or K.Surface
        end
    end
    playHubText.Text=#hub.Courts&gt;0 and (tr("Арены: ","Courts: ")..free.." / "..C.ArenaCount..tr("  ·  Очередь PvP: ","  ·  PvP queue: ")..hub.Queue) or tr("Подключаем статус арен…","Loading court status…")
end
local function historyRows()
    if #recentMatches==0 then return end
    note(tr("ПОСЛЕДНИЕ ДУЭЛИ · ЭТА СЕССИЯ","RECENT DUELS · THIS SESSION"),32,K.Gold)
    for j=#recentMatches,1,-1 do
        local m=recentMatches[j];local row=section(110)
        local title=T(row,resultName(m).."  ·  "..m.Opponent,15,m.Result==m.Symbol and K.Sage or K.Text,F.Strong,16,10,-32,26)
        title.TextWrapped=false;title.TextTruncate=Enum.TextTruncate.AtEnd
        T(row,m.Failed and tr("Сохранение не подтверждено","Save not confirmed") or receiptSummary(m.Receipt),12,K.Text,F.Body,16,40,-32,31)
        T(row,m.Failed and tr("Не показано как полученная награда","Not shown as a received reward") or receiptReason(m.Receipt),12,m.Failed and K.Red or K.Muted,F.Body,16,75,-32,29)
    end
end
local function buildTutorial()
    eyebrow.Text="PLAY   /   FIRST MOVES"
    heading.Text=tr("Три хода","Three moves")
    subheading.Text=tr("Учебное поле, без монет и рейтинга.","A learning board. No coins or rating.")
    local wide=visibleWidth()&gt;=540
    local bs=wide and math.clamp(scroll.AbsoluteSize.Y-32,156,210) or math.clamp(scroll.AbsoluteSize.Y-160,150,220)
    local h=wide and 258 or bs+195
    local lesson=section(h)
    local descriptions={
        tr("Начни с центра. Нажми выделенную клетку.","Start at the center. Tap the highlighted tile."),
        tr("Теперь левый верхний угол: готовим диагональ.","Now the top left: set up a diagonal."),
        tr("Нижний правый угол завершит ряд из трёх X.","The bottom right completes three X marks."),
    }
    local info=tutorialState.Done and tr("Три X по диагонали. Вот и победная линия!","Three X marks on a diagonal. That's a winning line!") or descriptions[tutorialState.Step]
    if tutorialState.Mistake then info=tr("Попробуй выделенную клетку. В обучении ошибок не боимся.","Try the highlighted tile. Mistakes are welcome here.") end
    local left=wide and bs+38 or 16
    local caption=T(lesson,tutorialState.Done and tr("ГОТОВО","COMPLETE") or (tr("ШАГ ","STEP ")..tutorialState.Step.." / 3"),11,K.Gold,F.Strong,left,14,-left-16,20)
    local hint=T(lesson,info,14,K.Text,F.Body,left,42,-left-16,wide and 80 or 55)
    local grid,buttons,marks=U.board(lesson,function(index)
        if tutorialState.Done then return end
        local status
        tutorialState,status=Tutor.move(tutorialState,index)
        if status=="COMPLETE" then send("Setting",{Key="TutorialSeen",Value=true});tutorialDismissed=true end
        if status=="NEXT" or status=="COMPLETE" then ping(1.08) end
        rebuild()
    end)
    tutorialBoard=buttons
    fit(grid,wide and 16 or (visibleWidth()-bs)/2,wide and 20 or 105,bs,bs)
    paintPreview(marks,tutorialState.Board,colors("Classic"),profile and profile.Shape)
    for i,b in ipairs(buttons) do
        if i==Tutor.Targets[tutorialState.Step] or (tutorialState.Done and table.find(tutorialState.Line,i)) then
            b.BackgroundColor3=K.GoldSoft
            local outline=U.new("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,-4,1,-4),Position=UDim2.fromOffset(2,2),Active=false},b)
            U.round(outline,7);U.stroke(outline,K.Gold,.05,2)
        end
        if tutorialState.Done or tutorialState.Board[i]~="" then b:SetAttribute("Disabled",true);b.Selectable=false end
    end
    local actionY=wide and 166 or bs+120
